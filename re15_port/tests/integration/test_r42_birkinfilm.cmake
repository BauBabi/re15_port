# =============================================================================
# Runde 42 Strang "birkinfilm" (Stufe 2) - DURCHLAUF je Figur in der echten exe durch die Szene mit dem RE2-Film "Birkins Mutation"
# (MOVIE/R409BIRK.STR). Konstanten/Belege include/re15_birkinfilm_r42.h, Code engine/src/birkinfilm_r42.c, engine/src/zws_r41.c,
# platform/pc/src/zws_r41_pc.c. PORT-STORY (ORCHESTRATOR-ENTSCHEID 18.11.).
#
#   leon  ROOM6000 (Bahnsteig, Annette): RE15_DEBUG_JUMP=6000 mit (3,100)=0 (Szene noch nicht gesehen; sub00 @0x00F40).
#         Erwartet: Umleitung sub06 -> Programm, Zeilen 0, 1, 2, 40, 48, 41, 49, 42, 50, 3 in dieser Folge (Strang namen: je
#         Satz eine Nachricht wie RE2 ROOM4090, jede mit "Annette:"), RE2-Stimmen nur 40/41/42
#         (R409_XA09/11/14.XAS), Abblende (RE2 ROOM4090 @0x027F4) nach der Warte-Zeile 43, Film zwischen 41 und 42, Einblende
#         (@0x0281C), Szene laeuft danach weiter (msg 3).
#   elza  ROOM5011 (Monitorraum, John und Sherry): Ankunft wie nach ROOM5021 sub02 - (4,237)=1 (@0x01356) und (3,58)=1 (@0x0135A);
#         RE15_DEBUG_JUMP=5011 (Elza ueber RE15_PSELECT_AUTO_SWITCH). Erwartet: Umleitung sub02 -> Programm, Zeilen 0..16 wie im
#         Original (keine neue Zeile, 46/47 ohne Text), Elzas Aufnahme zu msg 3 laeuft aus, dann Warte-Zeile 46, Abblende, Film
#         zwischen msg 3 und msg 4, Einblende, msg 4 "She's been infected ...", Szene laeuft bis msg 16 weiter.
# Beide mit Ton-Treiber dummy (SDL_AUDIODRIVER=dummy): der Film laeuft im Takt seines Tons bzw. 30 Bilder/s (2:11), die
# Stimmen ueber den Sprachkanal. Vorgesetzt ist nur der Ort (Debug-Sprung) und fuer Elza der Story-Stand vor der Szene.
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DWORKDIR=<dir> -DTEIL=<leon|elza> -P test_r42_birkinfilm.cmake
# =============================================================================
cmake_minimum_required(VERSION 3.21)
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "r42_birkinfilm: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "r42_birkinfilm: WORKDIR fehlt")
endif()
if(NOT TEIL)
    set(TEIL elza)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(WORKDIR "${WORKDIR}/lauf_${_lauf_id}_${TEIL}")
file(MAKE_DIRECTORY "${WORKDIR}")
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_name "${RE15_PC_EXE}" NAME)
if(_exe_name MATCHES "\\.exe$")
    set(_exe_kopie "${_exe_dir}/re15_pc_r42bf_${_lauf_id}.exe")
else()
    set(_exe_kopie "${_exe_dir}/re15_pc_r42bf_${_lauf_id}")
endif()
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")

set(_fehler "")
set(_n_fehler 0)   # eigener Zaehler: Texte mit "[" machen list(LENGTH) falsch (CMake-Listen mit ungeraden Klammern)
macro(fail _t)
    list(APPEND _fehler "${_t}")
    math(EXPR _n_fehler "${_n_fehler} + 1")
    message(STATUS "FAIL r42_birkinfilm[${TEIL}]: ${_t}")
endmacro()
macro(ok _t)
    message(STATUS "ok   r42_birkinfilm[${TEIL}]: ${_t}")
endmacro()
macro(pruefe _text _muster)
    string(FIND "${_dbg}" "${_muster}" _p)
    if(_p LESS 0)
        fail("${_text} (fehlt: '${_muster}')")
    else()
        ok("${_text}")
    endif()
endmacro()
macro(pruefe_nicht _text _muster)
    string(FIND "${_dbg}" "${_muster}" _p)
    if(_p LESS 0)
        ok("${_text}")
    else()
        fail("${_text} (gefunden: '${_muster}')")
    endif()
endmacro()
# Achtung: Makro-Argumente werden zweimal ausgewertet - eckige Klammer im Muster als [[] schreiben, nicht als Escape.
macro(pruefe_re _text _regex)
    if(_dbg MATCHES "${_regex}")
        ok("${_text}")
    else()
        fail("${_text} (fehlt: /${_regex}/)")
    endif()
endmacro()
function(_fertig)
    file(REMOVE "${_exe_kopie}")
    set(_nf ${_n_fehler})
    if(_nf GREATER 0)
        message(FATAL_ERROR "r42_birkinfilm[${TEIL}]: ${_nf} Fehler (${WORKDIR})")
    endif()
    message(STATUS "r42_birkinfilm[${TEIL}]: alle Pruefungen ok (${WORKDIR})")
endfunction()

set(_basis RE15_NO_INTRO=1 RE15_WINDOW_SCALE=1 RE15_MSG_LOG=1 RE15_TITLE_CONFIRM_MS=1500 RE15_PSELECT_AUTO=1 SDL_AUDIODRIVER=dummy
           RE15_STIMME_LOG=1 RE15_STATE_LOG=state.log)

# Gemeinsame Pruefungen am Film (Kennung birk6000 / birk5011)
macro(pruefe_film _k)
    pruefe("Abblende wie RE2 ROOM4090 @0x027F4" "[${_k}] Abblende wie RE2 ROOM4090 @0x027F4 (Wert, Pegel) (512, 0)")
    pruefe("Film nach 64 Abblendbildern angefordert" "[${_k}] Film angefordert (nach der Abblende, Takte) (3927, 64)")
    pruefe("Film geladen: 3927 Bilder 320x160" "Film MOVIE/R409BIRK.STR: 3927 Bilder 320x160")
    pruefe_re("Film gespielt" "[[]${_k}] Film zu Ende: [1-9][0-9]* von 3927 Bildern gezeigt")
    pruefe("Einblende wie RE2 ROOM4090 @0x0281C" "[${_k}] Film zu Ende: Einblende wie RE2 ROOM4090 @0x0281C (Kanal, Pegel) (2, 32767)")
    string(REGEX MATCH "\\[${_k}\\] Film zu Ende: ([0-9]+) von 3927 Bildern gezeigt[^(]*\\(F[0-9]+, ([0-9]+) ms\\)" _fm "${_dbg}")
    message(STATUS "     r42_birkinfilm[${TEIL}]: Film ${CMAKE_MATCH_1} von 3927 Bildern in ${CMAKE_MATCH_2} ms")
    string(REGEX MATCHALL "\\[${_k}\\] Film angefordert" _fa "${_dbg}")
    list(LENGTH _fa _nfa)
    if(_nfa EQUAL 1)
        ok("Film genau einmal angefordert")
    else()
        fail("Film ${_nfa} mal angefordert (Soll 1)")
    endif()
endmacro()

if(TEIL STREQUAL "leon")
    re15_start_spiel(_rv 1500 ${_basis} RE15_DEBUG_JUMP=6000@250 "RE15_EXIT_AT=1900#6000" "${_exe_kopie}")
    if(NOT EXISTS "${WORKDIR}/debug.log")
        fail("kein debug.log (exit=${_rv})")
        _fertig()
    endif()
    file(READ "${WORKDIR}/debug.log" _dbg)
    pruefe("Sprung nach 6000" "[debug-menu] AUTO-JUMP -> ROOM6000")
    pruefe("Umleitung sub06 -> Programm" "[birkinfilm] F250 ROOM6000 Evt_exec sub06 -> Programm (444 B)")
    pruefe_re("Zeilen 0, 1, 2, 40, 48, 41, 49, 42, 50, 3 in dieser Folge"
        "msgtext\\] room=6000 id=0 .*msgtext\\] room=6000 id=1 .*msgtext\\] room=6000 id=2 .*msgtext\\] room=6000 id=40 .*msgtext\\] room=6000 id=48 .*msgtext\\] room=6000 id=41 .*msgtext\\] room=6000 id=49 .*msgtext\\] room=6000 id=42 .*msgtext\\] room=6000 id=50 .*msgtext\\] room=6000 id=3 ")
    # Strang namen: jeder Satz mit "Annette:" (Wortlaut im Protokoll RE15_MSG_LOG), Satz 2 ohne eigene Stimme
    pruefe("msg 40 mit Namen" "[msgtext] room=6000 id=40 \"Annette: Annette Birkin.\"")
    pruefe("msg 48 mit Namen" "[msgtext] room=6000 id=48 \"Annette: My husband is the man")
    pruefe("msg 41 mit Namen" "[msgtext] room=6000 id=41 \"Annette: And it's all Umbrella's fault.\"")
    pruefe("msg 49 mit Namen" "[msgtext] room=6000 id=49 \"Annette: None of this would have")
    pruefe("msg 42 mit Namen" "[msgtext] room=6000 id=42 \"Annette: As a result of his")
    pruefe("msg 50 mit Namen" "[msgtext] room=6000 id=50 \"Annette: William should have lost")
    foreach(_m 48 49 50)
        pruefe("Satz 2 msg ${_m} am Riegel vorbei" "ROOM6000 msg ${_m}: Satz 2 unter der laufenden RE2-Stimme")
        pruefe_nicht("Satz 2 msg ${_m} ohne eigene Stimme" "[voice] ROOM6000 msg ${_m} <-")
    endforeach()
    pruefe_nicht("keine Zeile 43/44 mit Text" "room=6000 id=43 \"")
    pruefe_nicht("keine Zeile 44 mit Text" "room=6000 id=44 \"")
    foreach(_m 40 41 42)
        pruefe("RE2-Stimme msg ${_m}" "[voice] ROOM6000 msg ${_m} <- RE2 R409_XA")
    endforeach()
    pruefe_re("Folge: Stimme 41, Warte-Zeile 43, Abblende, Film, Einblende, Stimme 42, msg 3"
        "msg 41 <- RE2 R409_XA11.*Warte-Zeile 43: .*[[]birk6000] Abblende.*[[]birk6000] Film angefordert.*[[]birk6000] Film zu Ende: Einblende.*msg 42 <- RE2 R409_XA14.*msgtext\\] room=6000 id=3 ")
    pruefe_film(birk6000)
    pruefe("Szene bis zum Ende" "EXIT_AT: Bild 1900 in Raum 6000")
    _fertig()
elseif(TEIL STREQUAL "elza")
    re15_start_spiel(_rv 1800 ${_basis} RE15_PSELECT_AUTO_SWITCH=1 RE15_DEBUG_JUMP=5011@250 "RE15_SET_FLAG=4:237,3:58"
        "RE15_EXIT_AT=3000#5011" "${_exe_kopie}")
    if(NOT EXISTS "${WORKDIR}/debug.log")
        fail("kein debug.log (exit=${_rv})")
        _fertig()
    endif()
    file(READ "${WORKDIR}/debug.log" _dbg)
    pruefe("Sprung nach 5011" "[debug-menu] AUTO-JUMP -> ROOM5011")
    pruefe("Umleitung sub02 -> Programm" "ROOM5011 Evt_exec sub02 -> Programm (1024 B): Film R409BIRK zwischen msg 3 und msg 4 (Elza)")
    set(_folge "")
    foreach(_m RANGE 0 16)
        string(APPEND _folge "msgtext\\] room=5011 id=${_m} .*")
    endforeach()
    pruefe_re("Zeilen 0..16 wie im Original in dieser Folge" "${_folge}")
    pruefe("msg 3 Wortlaut" "[msgtext] room=5011 id=3 \"Elza: John. I read some files in this")
    pruefe("msg 4 Wortlaut" "[msgtext] room=5011 id=4 \"Elza: She's been infected by what")
    pruefe_nicht("keine Zeile 46 mit Text" "room=5011 id=46 \"")
    pruefe_nicht("keine Zeile 47 mit Text" "room=5011 id=47 \"")
    pruefe_nicht("keine RE2-Stimme in 5011" "[voice] ROOM5011 msg")
    pruefe_re("Folge: msg 3, Warte-Zeile 46, Abblende, Film, Einblende, msg 4"
        "msgtext\\] room=5011 id=3 .*ROOM5011 Warte-Zeile 46: .*[[]birk5011] Abblende.*[[]birk5011] Film angefordert.*[[]birk5011] Film zu Ende: Einblende.*msgtext\\] room=5011 id=4 ")
    pruefe_film(birk5011)
    pruefe("Szene bis zum Ende" "EXIT_AT: Bild 3000 in Raum 5011")
    # Stimmen-Riegel: msg 3 hat eine Aufnahme (synchro/STAGE5/room5011/main03.wav); die Warte-Zeile 46 wartet sie ab
    if(EXISTS "${WORKDIR}/stimme.log")
        file(READ "${WORKDIR}/stimme.log" _st)
        if(_st MATCHES "raum=5011 nachricht=46 ")
            ok("Stimmen-Riegel vor der Warte-Zeile 46 durchlaufen (stimme.log)")
        else()
            fail("stimme.log ohne Eintrag fuer nachricht=46")
        endif()
    else()
        fail("kein stimme.log")
    endif()
    _fertig()
else()
    fail("unbekannter TEIL ${TEIL}")
    _fertig()
endif()
