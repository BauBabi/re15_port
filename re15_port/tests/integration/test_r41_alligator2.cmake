# =============================================================================
# Runde 41 Spur P "alligator2" - die echte exe (Dossier analysis/befunde_runde41/P_alligator2.md).
#
# TEIL=kamera|kamera_elza  Nachtrag 31 Punkt 2 ("Aendern: nicht vor der Kamera"): Leiterweg 2080 -> 2090, Szene, Kampfbeginn; die Spielfigur
#     steht. Bilder RE15_FRAMEDUMP (RE15_WINDOW_SCALE=1); Auswerter `test_r41_alligator2 bildanteil` = Mass der Abnahme F 5 (Vordergrund =
#     max-Kanal-Differenz > 10 gegen den Median-Hintergrund von Cut 0): in den ersten 150 Bildern nach dem Kampfbeginn Spitze der rechten
#     Bildhaelfte im Median <= 35 %, kein Bild > 50 % (vorher Median ~46 %, 23 Bilder > 50 %); dazu cam=0 in allen Bildern und die Gator-Wurzel in
#     jedem Bild mindestens 3800 von der Kamera (state.log; vorher 1755).
# TEIL=uebergabe|uebergabe_elza  Uebergabe Ankunftsszene 2090 -> Knall + 8 Zombies in 2080 ueber den ECHTEN Weg, ohne RE15_SET_FLAG=9:110:
#     Aktionstaste an der Leiter in 2080 (Slot 1 @0x00BC2), Szene bis Folge C (Programm 3 setzt Bit 110), die Spielfigur dreht sich zur
#     Leiter, Aktionstaste an der Leiter in 2090 (Tuer Slot 0 @0x0996, DOOR16), im ersten Bild von 2080/2081 der Knall (Nachtrag 17), dann
#     die 8 Zombies oben (Nachtrag 20, Sce_em_set Typ 0x16 Etage 8 y -14400).
#
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DRE15_TOOL=<test_r41_alligator2> -DWORKDIR=<dir> -DTEIL=<teil> -P test_r41_alligator2.cmake
# =============================================================================
cmake_minimum_required(VERSION 3.21)
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "r41_alligator2: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "r41_alligator2: WORKDIR fehlt")
endif()
if(NOT TEIL)
    set(TEIL kamera)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_dir "${WORKDIR}/lauf_${_lauf_id}")
file(MAKE_DIRECTORY "${_dir}")
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
set(_exe_kopie "${_exe_dir}/re15_pc_r41p_${_lauf_id}.exe")
if(NOT WIN32)
    set(_exe_kopie "${_exe_dir}/re15_pc_r41p_${_lauf_id}")
endif()
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")
set(WORKDIR "${_dir}")

function(r41p_fehler _text)
    file(REMOVE "${_exe_kopie}")
    message(FATAL_ERROR "r41_alligator2: Lauf ${TEIL} - ${_text} (${_dir})")
endfunction()

foreach(_v RE15_GB_TEST RE15_GATOR_KANISTER RE15_KEIN_GATOR RE15_K2080_WURF_GIER RE15_K2080_GATOR_HP RE15_SET_FLAG RE15_FIRE_AOT)
    unset(ENV{${_v}})
endforeach()

if(TEIL MATCHES "elza$")
    set(_r2080 2081)
    set(_r2090 2091)
    set(_wahl RE15_TITLE_CONFIRM_MS=1500 RE15_PSELECT_AUTO=1 RE15_PSELECT_AUTO_SWITCH=1)
    set(_fam PL04)
else()
    set(_r2080 2080)
    set(_r2090 2090)
    set(_wahl RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2)
    set(_fam PL00)
endif()

# Bild der (letzten) Folge C = Kampfbeginn
function(r41p_folge_c out)
    file(STRINGS "${_dir}/debug.log" _fc REGEX "\\[gatorszene\\] Folge C ROOM${_r2090} F[0-9]+ ")
    if(NOT _fc)
        r41p_fehler("keine Folge-Zeile C (Kampfbeginn) in debug.log")
    endif()
    list(GET _fc -1 _l)
    string(REGEX MATCH "Folge C ROOM[0-9A-F]+ F([0-9]+) " _m "${_l}")
    set(${out} ${CMAKE_MATCH_1} PARENT_SCOPE)
endfunction()

if(TEIL MATCHES "^kamera")
    if(NOT RE15_TOOL OR NOT EXISTS "${RE15_TOOL}")
        r41p_fehler("RE15_TOOL (test_r41_alligator2) fehlt: '${RE15_TOOL}'")
    endif()
    re15_start_spiel(_rv 300
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1 SDL_ASSERT=always_ignore ${_wahl}
        RE15_SET_FLAG=3:245 RE15_STATE_LOG=state.log RE15_DEBUG_JUMP=${_r2080}@250 "RE15_FIRE_AOT=1@40#${_r2080}"
        "RE15_EXIT_AT=650#${_r2090}" "RE15_FRAMEDUMP=298-650/1:fd_"
        "${_exe_kopie}")
    file(REMOVE "${_exe_kopie}")
    if(NOT _rv EQUAL 0)
        r41p_fehler("exe exit=${_rv} (erwartet 0 bis RE15_EXIT_AT)")
    endif()
    file(STRINGS "${_dir}/debug.log" _famz REGEX "\\[pl\\] Spieler-Familie ${_fam} ")
    if(NOT _famz)
        r41p_fehler("Spielfigur nicht ${_fam}")
    endif()
    r41p_folge_c(_c)
    math(EXPR _f0 "${_c} + 2")     # das Bild der Kamera-Uebergabe zeigt noch den Fress-Cut (Schnittbild, Abnahme F 5)
    math(EXPR _f1 "${_c} + 150")
    # state.log, letzter Raum-Abschnitt: cam=0 und Wurzel-Abstand zur Kamera Cut 0 (RID @0x0060: x 2754, z -26190)
    file(STRINGS "${_dir}/state.log" _alle REGEX "^F[0-9]+ ")
    set(_ab "")
    foreach(_z IN LISTS _alle)
        if(_z MATCHES "^F0 ")
            set(_ab "")
        endif()
        list(APPEND _ab "${_z}")
    endforeach()
    set(_n 0)
    set(_min2 999999999999)
    foreach(_z IN LISTS _ab)
        if(NOT _z MATCHES "^F([0-9]+) ")
            continue()
        endif()
        set(_f "${CMAKE_MATCH_1}")
        if(_f LESS _f0 OR _f GREATER _f1)
            continue()
        endif()
        if(NOT _z MATCHES " cam=0 ")
            r41p_fehler("nicht Cut 0 in F${_f}: ${_z}")
        endif()
        if(NOT _z MATCHES " t=23 [^@]*@\\((-?[0-9]+),(-?[0-9]+),r")
            r41p_fehler("kein Gator in F${_f}: ${_z}")
        endif()
        math(EXPR _d2 "(${CMAKE_MATCH_1} - 2754) * (${CMAKE_MATCH_1} - 2754) + (${CMAKE_MATCH_2} + 26190) * (${CMAKE_MATCH_2} + 26190)")
        if(_d2 LESS _min2)
            set(_min2 ${_d2})
        endif()
        math(EXPR _n "${_n} + 1")
    endforeach()
    if(_n LESS 140)
        r41p_fehler("state.log unvollstaendig (${_n} Bilder)")
    endif()
    if(_min2 LESS 14440000)      # 3800^2
        r41p_fehler("Gator-Wurzel naeher als 3800 an der Kamera Cut 0 (Quadrat ${_min2}; vorher 1755)")
    endif()
    # Median-Hintergrund ab dem Kampfbeginn (Kamera fest), wie Abnahme F 5 (anteil.py <lauf> 298 650 ...)
    math(EXPR _r0 "${_c} + 2")
    execute_process(COMMAND "${RE15_TOOL}" bildanteil "${_dir}" ${_r0} 650 ${_f0} ${_f1}
                    RESULT_VARIABLE _kr OUTPUT_VARIABLE _ko ERROR_VARIABLE _ke)
    string(REGEX MATCH "bildanteil: [^\n]*" _kz "${_ko}")
    file(GLOB _fd "${_dir}/fd_*.ppm")
    if(_fd)
        file(REMOVE ${_fd})
    endif()
    if(NOT _kr EQUAL 0)
        r41p_fehler("${_kz}")
    endif()
    message(STATUS "r41_alligator2: Lauf ${TEIL}: Kampfbeginn F${_c}, ${_n} Bilder cam=0, Wurzel-Abstand^2 zur Kamera min ${_min2}; ${_kz}")
    return()
endif()

if(TEIL MATCHES "^uebergabe")
    # Eingabe je Spielbild (RE15_INPUT_SCRIPT_BASIS=spiel, der Bildzaehler beginnt je Raum neu): F46 Aktionstaste an der Leiter in 2080
    # (LT3 der Abnahme F 5, Vorwaertspunkt im Rechteck @0x0BC2); dritter 2090-Abschnitt: Kampfbeginn ~F299, ab F304 Linksdrehung 21 Bilder
    # (96/Bild: Gier 0 -> Westen zur Leiter, Vorwaertspunkt im Rechteck Slot 0 @0x0996 x -9400..-8400), F331 Aktionstaste.
    re15_start_spiel(_rv 300
        RE15_NO_INTRO=1 RE15_AUDIO_CAP_SYNC=cap.raw RE15_SE_DEBUG=1 RE15_WINDOW_SCALE=1 SDL_ASSERT=always_ignore ${_wahl}
        RE15_SET_FLAG=3:245 RE15_STATE_LOG=state.log RE15_SPAWN_DIAG=1 RE15_DEBUG_JUMP=${_r2080}@250
        "RE15_PLAYER_POS=-9950,-25650,0,8"
        RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=1 "RE15_INPUT_SCRIPT=W1.5,A0.2,W8.4,L0.7,W0.2,A0.4"
        "RE15_EXIT_AT=200#${_r2080}" "${_exe_kopie}")   # nach dem Ende der Szenen-Montage in 2080 (Programm 2 bis F156), vor der Eingabe F304
    file(REMOVE "${_exe_kopie}")
    file(REMOVE "${_dir}/cap.raw")
    if(NOT _rv EQUAL 0)
        r41p_fehler("exe exit=${_rv} (erwartet 0 bis RE15_EXIT_AT)")
    endif()
    file(STRINGS "${_dir}/debug.log" _famz REGEX "\\[pl\\] Spieler-Familie ${_fam} ")
    if(NOT _famz)
        r41p_fehler("Spielfigur nicht ${_fam}")
    endif()
    file(STRINGS "${_dir}/debug.log" _sf REGEX "\\[setflag\\] flag\\(9,110")
    if(_sf)
        r41p_fehler("Bit 110 per RE15_SET_FLAG gesetzt: ${_sf}")
    endif()
    # Reihenfolge im Strom: Szene bis C (Programm 3 setzt Bit 110), Tuerweg zurueck, Knall, 8 Zombies oben
    set(_ausl "\\[k2080\\] F[0-9]+ Knall \\(Knall-Bank Satz 0")
    file(STRINGS "${_dir}/debug.log" _rf
         REGEX "\\[gatorszene\\] Folge (A|C) |\\[tuer\\] Sequenz Archiv [0-9]+ DOOR16 |${_ausl}|\\[k2080\\] F[0-9]+ ROOM${_r2080} nach Bit 110: |\\[spawn-diag\\] Sce_em_set type=0x16 behavior=0x02 ")
    set(_folge "")
    set(_n_em 0)
    set(_n_em_oben 0)
    foreach(_l IN LISTS _rf)
        if(_l MATCHES "Folge A ")
            string(APPEND _folge "A")
        elseif(_l MATCHES "Folge C ")
            string(APPEND _folge "C")
        elseif(_l MATCHES "DOOR16 ")
            string(APPEND _folge "D")
        elseif(_l MATCHES "Knall \\(Knall-Bank")
            string(APPEND _folge "K")
        elseif(_l MATCHES "nach Bit 110: ([0-9]+) lebende Zombies")
            if(NOT CMAKE_MATCH_1 EQUAL 8)
                r41p_fehler("'${_l}' statt 8 lebende Zombies")
            endif()
            string(APPEND _folge "N")
        elseif(_l MATCHES "Sce_em_set type=0x16")
            math(EXPR _n_em "${_n_em} + 1")
            if(_l MATCHES "pos=\\(-?[0-9]+,-14400,-?[0-9]+\\)")
                math(EXPR _n_em_oben "${_n_em_oben} + 1")
            endif()
            if(_n_em EQUAL 1)
                string(APPEND _folge "Z")
            endif()
        endif()
    endforeach()
    message(STATUS "r41_alligator2: Lauf ${TEIL}: Folge ${_folge}, ${_n_em} Spawns, oben ${_n_em_oben}")
    if(NOT _folge MATCHES "A.*C.*D.*K.*Z" OR NOT _folge MATCHES "N")
        r41p_fehler("Folge '${_folge}' (A Ankunft, C Kampfbeginn, D Tuerweg DOOR16, K Knall, N Zeile nach Bit 110, Z Zombies)")
    endif()
    if(NOT _n_em EQUAL 8 OR NOT _n_em_oben EQUAL 8)
        r41p_fehler("${_n_em} Zombie-Spawns, davon ${_n_em_oben} auf Band 8 (y -14400), statt 8")
    endif()
    # Knall gemischt: direkt hinter der Ausloese-Zeile die Stimme des Satzes 0 (audio_pc.c se_play_layers, wie test_r41_kanister2080.cmake)
    set(_ausl "\\[k2080\\] F[0-9]+ Knall: Knall-Bank")
    file(STRINGS "${_dir}/debug.log" _z REGEX "(${_ausl})|(\\[se\\] Stimme: )")
    set(_warte 0)
    set(_ton 0)
    foreach(_l IN LISTS _z)
        if(_warte)
            if(_l MATCHES "\\[se\\] Stimme: se=0 layer=0 vag=0 note=67 fine=0 center=91 vol=127 pitch=0x400 \\(11025 Hz\\)")
                math(EXPR _ton "${_ton} + 1")
            endif()
            set(_warte 0)
        endif()
        if(_l MATCHES "${_ausl}")
            set(_warte 1)
        endif()
    endforeach()
    if(NOT _ton EQUAL 1)
        r41p_fehler("Knall: ${_ton} x Stimme Satz 0 direkt hinter der Ausloese-Zeile statt 1")
    endif()
    message(STATUS "r41_alligator2: Lauf ${TEIL}: Szene -> Kampfbeginn -> Leiter -> Knall -> 8 Zombies oben, ohne RE15_SET_FLAG=9:110 (Folge ${_folge})")
    return()
endif()
r41p_fehler("unbekannter Teil")
