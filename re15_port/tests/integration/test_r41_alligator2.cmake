    set(_f_a -1)
    set(_f_r -1)
    foreach(_l IN LISTS _kl)
        if(_l MATCHES "KANISTER angehaengt .* F([0-9]+)")
            set(_f_a "${CMAKE_MATCH_1}")
        elseif(_l MATCHES "R1 VSync 4 \\(Zeitlupe\\) F([0-9]+)")
            set(_f_r "${CMAKE_MATCH_1}")
        endif()
