    list(GET _k13 0 _k0)
    string(REGEX MATCH "pos=\\((-?[0-9]+),(-?[0-9]+),(-?[0-9]+)\\)" _m "${_k0}")
    if(CMAKE_MATCH_1 LESS -8900 OR CMAKE_MATCH_1 GREATER 7200 OR CMAKE_MATCH_3 LESS -27000 OR CMAKE_MATCH_3 GREATER -5400)
        r41p_fehler("Kanister beim R1 ausserhalb der Aussenwaende: ${_k0}")
    endif()
    message(STATUS "r41_alligator2: Lauf ${TEIL}: Aufnahme F${_f_a}, R1 F${_f_r}, ${_tz}; Kanister beim R1 (${CMAKE_MATCH_1},${CMAKE_MATCH_3}) innerhalb")
    return()
endif()
if(TEIL MATCHES "^schluessel")
    # Nachbesserung 1 (M2, M3; Nachtrag 35 Punkt 1, Pflicht fuer das Release): natuerlicher Kampf bis zum R1-Tod (Rezept integration_r41_kanister2080_kampf), Lauf 1 zeigt Schluessel und Figur; Werkzeug wegplan
    # faehrt im Harness von der Lage der Figur zum Schluessel und schreibt die Tasten; Lauf 2 = dieselbe Eingabe bis dorthin + dieser Weg (auch durch den Westkanal, den der Kadaver sperrte) + Aktionstaste + Abfrage.
    if(NOT RE15_TOOL OR NOT EXISTS "${RE15_TOOL}")
        r41p_fehler("RE15_TOOL (test_r41_alligator2) fehlt: '${RE15_TOOL}'")
    endif()
    set(_block "M0.6,MA0.1,M0.3,MA0.1,W3.0")
    set(_w 6.0)
    set(_schuss "W${_w}")
    foreach(_i RANGE 1 30)
        string(APPEND _schuss ",${_block}")
    endforeach()
    set(_env RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1 SDL_ASSERT=always_ignore ${_wahl}
        RE15_DEBUG_JUMP=${_r2090}@250 "RE15_SET_FLAG=9:110,3:245" "RE15_GIVE=3:60" RE15_EQUIP=3 RE15_R39_MESS_SPIELER_HP=100 RE15_K2080_GATOR_HP=24990
        RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=1 RE15_STATE_LOG=state.log "RE15_PLAYER_POS=-6000,-17500,3072")
    set(WORKDIR "${_dir}/lauf1")
    file(MAKE_DIRECTORY "${WORKDIR}")
    re15_start_spiel(_rv 400 ${_env} "RE15_INPUT_SCRIPT=${_schuss}" "RE15_EXIT_AT=800#${_r2090}" "${_exe_kopie}")
    if(NOT _rv EQUAL 0)
        r41p_fehler("Lauf 1 exe exit=${_rv} (erwartet 0 bis RE15_EXIT_AT)")
    endif()
    file(STRINGS "${_dir}/lauf1/gator_boss.log" _r1 REGEX "RE2 R1 ende \\(Leiche\\)")
    if(NOT _r1)
        r41p_fehler("kein R1-Tod bis F800")
    endif()
    execute_process(COMMAND "${RE15_TOOL}" wegplan "${_dir}/lauf1" ${_r2090} ${_w} 123 "${_block}" "${_dir}/skript.txt"
                    RESULT_VARIABLE _wr OUTPUT_VARIABLE _wo ERROR_VARIABLE _we)
    string(REGEX MATCHALL "wegplan: [^\n]*" _wz "${_wo}")
    if(NOT _wr EQUAL 0)
        r41p_fehler("wegplan: ${_wz}")
    endif()
    file(READ "${_dir}/skript.txt" _skript)
    string(STRIP "${_skript}" _skript)
    set(WORKDIR "${_dir}/lauf2")
    file(MAKE_DIRECTORY "${WORKDIR}")
    re15_start_spiel(_rv 500 ${_env} "RE15_INPUT_SCRIPT=${_skript}" "RE15_EXIT_AT=2200#${_r2090}" RE15_CLIMB_TRACE=climb.log RE15_ITEMBAND_LOG=itemband.log RE15_INV_LOG=1 "${_exe_kopie}")
    file(REMOVE "${_exe_kopie}")
    if(NOT _rv EQUAL 0)
        r41p_fehler("Lauf 2 exe exit=${_rv} (erwartet 0 bis RE15_EXIT_AT)")
    endif()
    file(READ "${_dir}/lauf2/itemband.log" _ib)
    if(NOT _ib MATCHES "ITEM slot 15 floor 0 item 0x34 [^\n]*-> FREI")
        r41p_fehler("Aufnahme-Zone des Water Key nicht frei/nicht erreicht")
    endif()
    file(STRINGS "${_dir}/lauf2/debug.log" _inv REGEX "\\[inv-r39\\].*(0x34|=52\\b)")
    file(STRINGS "${_dir}/lauf2/climb.log" _kl REGEX " room=${_r2090} .* sub=9 ")
    set(_kl_key 0)
    foreach(_l IN LISTS _kl)
        if(_l MATCHES "kind=0x81")
            set(_kl_key 1)
        endif()
    endforeach()
    if(_kl_key)
        r41p_fehler("Kletter-Start auf ein Objekt statt Aufnahme")
    endif()
    if(NOT _inv)
        r41p_fehler("Water Key nicht im Inventar")
    endif()
    message(STATUS "r41_alligator2: Lauf ${TEIL}: ${_wz}; Water Key aufgehoben (${_inv})")
    return()
endif()
if(TEIL MATCHES "^finisher")
    # Nachbesserung 1 (M5, Nachtrag 35 Punkt 4): toedlicher Biss ohne Eingabe; RE15_VIS_TRACE: Spieler sichtbar bis zum Clip-5-Ende, ab "FRESS P3: Spieler-Modell aus" in keinem Bild mehr
    # (RE2 P2-Ende Spieler-Wort |= 0x80000 @0x80101190-ac). Vorher: Beine bis zum Game Over im Bild (Abnahme 0 zoom_fin F1012-F1080).
    re15_start_spiel(_rv 400
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1 SDL_ASSERT=always_ignore ${_wahl}
        RE15_DEBUG_JUMP=${_r2090}@250 "RE15_SET_FLAG=9:110,3:245" RE15_GB_TEST=1 RE15_R39_MESS_SPIELER_HP=20 RE15_VIS_TRACE=1
        "RE15_EXIT_AT=900#${_r2090}" RE15_STATE_LOG=state.log "${_exe_kopie}")
    file(REMOVE "${_exe_kopie}")
    file(STRINGS "${_dir}/gator_boss.log" _p3 REGEX "FRESS P3: Spieler-Modell aus F[0-9]+")
    if(NOT _p3)
        r41p_fehler("kein Finisher bis RE15_EXIT_AT (keine Zeile FRESS P3)")
    endif()
    list(GET _p3 0 _p30)
    string(REGEX MATCH "F([0-9]+)$" _m "${_p30}")
    set(_f3 ${CMAKE_MATCH_1})
    file(STRINGS "${_dir}/debug.log" _vis REGEX "^\\[vis\\] F[0-9]+ room=${_r2090}")
    set(_vor 0)
    set(_nach 0)
    set(_nach_sicht 0)
    foreach(_l IN LISTS _vis)
        if(_l MATCHES "^\\[vis\\] F([0-9]+) .* vis=([01]) ")
            set(_f ${CMAKE_MATCH_1})
            set(_v ${CMAKE_MATCH_2})
            if(_f LESS _f3)
                if(_v EQUAL 1)
                    math(EXPR _vor "${_vor} + 1")
                endif()
            elseif(_f GREATER _f3)
                math(EXPR _nach "${_nach} + 1")
                if(_v EQUAL 1)
                    math(EXPR _nach_sicht "${_nach_sicht} + 1")
                endif()
            endif()
        endif()
    endforeach()
    if(_vor LESS 100 OR _nach LESS 5 OR NOT _nach_sicht EQUAL 0)
        r41p_fehler("Sichtbarkeit: vor F${_f3} sichtbar ${_vor}, danach ${_nach} Bilder, davon sichtbar ${_nach_sicht}")
    endif()
    message(STATUS "r41_alligator2: Lauf ${TEIL}: Modell aus ab F${_f3}, vorher ${_vor} Bilder sichtbar, danach ${_nach} Bilder ohne Spielerfigur")
    return()
endif()
