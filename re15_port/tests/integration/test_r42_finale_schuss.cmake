# FINALE LEON 5090: ABSCHUSS BIS TITEL. Runde 42 Strang finale, Stufe 1 (include/re15_finale_r42.h).
#
# NUTZERWUNSCH 07.11.2026: "... die Form Birkin G5 aus dem Finale wieder entfernst ... ein finale wie beim Golem am Ende von Resident
# Evil 2 ... mit mehreren Wiederholungen ... wie die Rakete angeflogen kommen und den Gegner zersprengt." NUTZERWUNSCH 17.11.2026:
# Schlusszeile "Game over." (K-11).
#
# Ein Lauf: Debug-Sprung 5090 (wie integration_r41_g5_tod), Pruefhaken RE15_FINALE_WERFER=1 (2 Raketen, ausgeruestet - die Wurfszene
# folgt in Stufe 3), Anlegen + Feuer. Geprueft aus finale.log (Takte T = Spieltakt des Finale-Moduls) gegen die RE2-Zahlen:
#   Ausloeser T, Freigabe U = T + 15 + 33 + 1 (sub15 @0x01A30 Sleep 15, Lesefenster 162 Sektoren = 33 Bilder, Programm ab T+1)
#   echte Rakete weg U+7 (@0x80103750-68), W1 U+37 (Sleep 32 + 5 @0x01A60/64), Rakete U+38, Einfrieren U+52 (t 15 @0x80103848),
#   W2 U+77 (40 Bilder @0x801038a4), Rakete U+78, Einfrieren U+84 (t 7), W3 U+109 (32 @0x801039a8), Ruetteln U+118 (10 @0x80103a80),
#   Einschlag U+119, Wackeln aus U+134 (Bild 16 @0x80103d24), Kill = Einschlag + 83 (Xa 0x03 1026 Sektoren = 6,84 s ECHTZEIT: Bit 0x20
#   @0x80103d64-74, VSync 5 @0x80103b00-08 = 5 Austastungen je Bild, 410,4 Austastungen -> 83. Bild; Pruefbericht s1 r1 R1), Phase 9 +1.
#   Schnitte (U3 Runde 4, include/re15_finale_r42.h): Ausloeser 15, W1 13, W2 14, W3 13. Runde 4 (Pruefbericht s1 r3 R1): der Ausloeser
#   fordert einen Wechsel aus der Lauf-Kamera an (finale.log "Ausloese-Schnitt: vorher 11..14, angefordert 15, Wechsel 1"), und das Bild
#   des Ausloesers - das mit dem Versetzen auf die Fixpunkte - wird gehalten (RE15_KAMERAHALT_LOG: "[kamerahalt] F<Ausloeser> ... ->
#   HALTEN"; RE2 FUN_8002b968 @0x8002ba50/@0x8002bb58 zeichnet das Bild der Schnitt-Anforderung nicht). "Game over" hat eine eigene
#   Lage (PORT-WAHL RE15_FI_GO_*, finale.log "Fixpunkte: Form (9250,-25750)"), W1 setzt die Form auf die W-Lage (22000,-23250). Bildlage (Runde 3, Pruefbericht s1 r2 R1) mit der
#   Kamera des Schnitts: "Game over" Form ausser Bild und Spieler im Bild (RE2 Schnitt 11); W3 Effekt in jedem Bild im Bild und naeher
#   an der Kamera als die Form (RE2 1181 vor 4112); W1/W2 Rakete in mindestens der Haelfte der Flugbilder im Bild. Einschlag: Raumtonbank
#   R702 Satz 0x0F (Se_on 0x020F0001 @0x80103b54-5c) im Einschlagbild, Bank geladen. Zerplatzen (U5): Bild 16 loescht die Brocken und setzt
#   sechs 0x040E2000 (Marken der Tabelle @0x8010476c). VSync 5 gilt genau vom Einschlag bis Phase 9 (84 Bilder im debug.log).
#   Danach: Abspann-Raum 6040 und Titel (zweiter Spiel-Boot, RE15_BOOT_EXIT_AT=2), kein [g5a]/G5-Auftritt im ganzen Lauf.
# STUFE 4 (Plan S9, TEIL=elza): dieselbe Maschine in ROOM5091 (Dossier B 6: Claire-Overlay mit denselben Konstanten). Unterschiede:
#   Zeile "You lose, big guy!" (NUTZERWUNSCH 17.11., K-11 Claire) mit Lesefenster 354 Sektoren = 71 Bilder (Claire-STAGE7.BIN @0x150
#   `06 00 4e 00 18 00`) -> U = T + 15 + 71 + 1; Todesschrei R702_XA03_CLAIRE.XAS mit Lesefenster 1234 Sektoren (@0x156 `05 00 00 00 4f 00`)
#   = 493,6 Austastungen -> bei VSync 5 das 99. Bild nach dem Einschlag (Kill U+218, Phase 9 U+219, Xa-Fenster 495, Zeitlupe 100 Bilder);
#   Abspann-Raum 6041 (5091 Tuer Slot 5 -> Stage-Byte 05 / Raum 04 + Variante). Beide Teile pruefen zusaetzlich mit Ton-Treiber "dummy"
#   (statt RE15_NOAUDIO): Message_on der Schlusszeile im Bild T+16 mit der Aufnahme synchro/STAGE5/room509x/main02.wav und den Start der
#   RE2-XA mit Datei und Lesefenster im Einschlagbild.
# STUFE 5 (NUTZERWUNSCH 18.11.2026 "das thank you for Playing fliegt vollständig raus, und es kommt ein richtiges Endvideo";
#   include/re15_endvideo_r42.h): nach dem Kill laeuft statt 5090/5091 sub02 das Port-Programm (RE2-Form ROOM4090). Geprueft:
#   keine Meldung 0 "THANK YOU FOR PLAYING !!!" ([msgtext] room=509x id=0), das Port-Programm startet, die Film-Zeile 60 kommt nach dem
#   Kill und vor dem Laden des Abspanns. Ohne FILM fehlt MOVIE/ENDE509x.STR -> "FEHLT", direkt Abspann. Mit -DFILM=1 legt der Lauf eine
#   Platzhalter-Datei an (Kopie von MOVIE/R114GORI.STR, 367 Bilder) unter <WORKDIR>/cd/MOVIE/ENDE509x.STR und setzt RE15_CD_ROOT
#   (asset_root_pc.c: env-Wurzel zuerst, Rest faellt auf shared_assets zurueck) -> der Film laeuft an genau dieser Stelle.
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DWORKDIR=<dir> [-DTEIL=leon|elza] [-DFILM=1] -P test_r42_finale_schuss.cmake
# =============================================================================
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "r42_finale_schuss: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "r42_finale_schuss: WORKDIR fehlt")
endif()

if(NOT TEIL)
    set(TEIL leon)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")
if(TEIL STREQUAL "elza")
    set(_raum 5091)
    set(_figur_env RE15_TITLE_SHOT_CHAR=1)
    set(_soll_ut 87)            # Sleep 15 + Lesefenster 71 + Programmstart T+1
    set(_soll_kill 218)         # Einschlag U+119 + 99 (1234 Sektoren * 60 / 150 = 493,6 Austastungen, VSync 5)
    set(_soll_xavbl 495)
    set(_abspann 6041)
    set(_zeile "Elza: You lose, big guy!")
    set(_xa_datei "R702_XA03_CLAIRE.XAS: 78 Sektoren, Lesefenster 1234")
else()
    set(_raum 5090)
    set(_figur_env "")
    set(_soll_ut 49)
    set(_soll_kill 202)
    set(_soll_xavbl 415)
    set(_abspann 6040)
    set(_zeile "Leon: Game over.")
    set(_xa_datei "R702_XA03_LEON.XAS: 65 Sektoren, Lesefenster 1026")
endif()
math(EXPR _soll_p9 "${_soll_kill} + 1")
math(EXPR _soll_zeitlupe "${_soll_kill} - 119 + 1")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(WORKDIR "${WORKDIR}/lauf_${_lauf_id}")
file(MAKE_DIRECTORY "${WORKDIR}")
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
set(_exe_kopie "${_exe_dir}/re15_pc_r42finale_${TEIL}_${_lauf_id}.exe")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")

# Stufe 5: Platzhalter-Endvideo (nur mit -DFILM=1).
set(_film_env "")
if(FILM)
    set(_film_quelle "${CMAKE_CURRENT_LIST_DIR}/../../shared_assets/PSX/MOVIE/R114GORI.STR")
    if(NOT EXISTS "${_film_quelle}")
        message(FATAL_ERROR "r42_finale_schuss: Platzhalter-Quelle fehlt: ${_film_quelle}")
    endif()
    file(MAKE_DIRECTORY "${WORKDIR}/cd/MOVIE")
    file(COPY_FILE "${_film_quelle}" "${WORKDIR}/cd/MOVIE/ENDE${_raum}.STR")
    set(_film_env "RE15_CD_ROOT=${WORKDIR}/cd")
endif()
re15_start_spiel(_rv 800 ${_film_env}
    RE15_NO_INTRO=1 SDL_AUDIODRIVER=dummy RE15_SOFTWARE_RENDER=1 RE15_WINDOW_SCALE=1
    RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2 ${_figur_env}
    RE15_DEBUG_JUMP=${_raum}@250 "RE15_PLAYER_POS=500,-9175,2048,0"
    RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=100 "RE15_INPUT_SCRIPT=A0.1,W1,U8.5,MA6,W60"
    RE15_FINALE_WERFER=1 RE15_FINALE_LOG=1 RE15_KAMERAHALT_LOG=1 RE15_MSG_LOG=1 RE15_STIMME_LOG=1 RE15_BOOT_EXIT_AT=2 "RE15_EXIT_AT=7000"
    "${_exe_kopie}")
file(REMOVE "${_exe_kopie}")

set(_f "")
if(NOT EXISTS "${WORKDIR}/finale.log")
    message(FATAL_ERROR "r42_finale_schuss: finale.log fehlt (exit=${_rv}) - kein Finale-Modul oder kein Kampfbeginn")
endif()
file(READ "${WORKDIR}/finale.log" _log)
function(takt_von _muster _var)
    if(_log MATCHES "\\[finale\\] T([0-9]+) F[0-9]+ ${_muster}")
        set(${_var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    else()
        set(${_var} "" PARENT_SCOPE)
    endif()
endfunction()
takt_von("Ausloeser" _T)
takt_von("Freigabe" _U)
if(NOT _T OR NOT _U)
    message(FATAL_ERROR "r42_finale_schuss: kein Ausloeser/keine Freigabe im finale.log (exit=${_rv})\n${_log}")
endif()
math(EXPR _d "${_U} - ${_T}")
if(NOT _d EQUAL _soll_ut)
    string(APPEND _f "\n U - T = ${_d} statt ${_soll_ut} (Sleep 15 + Lesefenster + Programmstart T+1)")
endif()
foreach(_paar "echte Rakete geloescht:7" "W1:.*vor der Form:37" "Wiederholung 020d1000 Besitzer 0x80:38" "W1 eingefroren:52"
              "W2:.*vor der Form:77" "Wiederholung 020d1000 Besitzer 0x81:78" "W2 eingefroren:84" "W3:.*vor der Form:109"
              "Ruetteln:118" "Einschlag:119" "Se_on 0x020F0001. Raumbank R702 Satz 0x0F .PC-Haken 1.:119" "Wackeln aus:134" "Bild 16: Brocken weg, 6 x 0x040E2000:134" "Kill:${_soll_kill}" "Phase 9:${_soll_p9}")
    string(REGEX MATCH "^(.*):([0-9]+)$" _x "${_paar}")
    set(_m "${CMAKE_MATCH_1}")
    set(_soll "${CMAKE_MATCH_2}")
    takt_von("${_m}" _t)
    if(NOT _t)
        string(APPEND _f "\n '${_m}' fehlt")
    else()
        math(EXPR _ist "${_t} - ${_U}")
        if(NOT _ist EQUAL _soll)
            string(APPEND _f "\n '${_m}' bei U+${_ist} statt U+${_soll}")
        endif()
    endif()
endforeach()
if(NOT _log MATCHES "echte Rakete geloescht \\([1-9][0-9]* Plaetze\\)")
    string(APPEND _f "\n der echte Schuss im Freigabebild U hat keine Rakete (2,0x0D) erzeugt (RE2: Rakete ab Clip-Bild 1, @0x8004559c)")
endif()
# [^\n] statt .: der CMake-Punkt passt auch auf den Zeilenumbruch (Runde 3: "Ausloeser: .*Schnitt 12" fand "W1 ... Schnitt 12" der Runde 2)
foreach(_paar "Ausloeser: [^\n]*Schnitt 15" "Fixpunkte: Form [(]9250,-25750[)]" "Wiederholung Form [(]22000,-23250[)] Schnitt 13" "W1: Spieler 10000 vor der Form, Schnitt 13" "W2: Spieler 5000 vor der Form, Schnitt 14"
              "W3: Spieler 3000 vor der Form, Schnitt 13" "Kill: [^\n]*Xa-Fenster ${_soll_xavbl} Austastungen")
    if(NOT _log MATCHES "${_paar}")
        string(APPEND _f "\n '${_paar}' fehlt (U3-Schnitte / R1-Echtzeit)")
    endif()
endforeach()
# Bildlage (Runde 3): "Game over" - Form ausser Bild (u ausserhalb 0..319 oder hinter dem Auge), Spieler im Bild.
if(_log MATCHES "Bildlage Game over: Form u (-?[0-9]+) Tiefe (-?[0-9]+)")
    set(_u "${CMAKE_MATCH_1}")
    if(_u GREATER_EQUAL 0 AND _u LESS 320)
        string(APPEND _f "\n Game over: Formmitte im Bild (u ${_u}), RE2 Schnitt 11 hat die Form ausser Bild")
    endif()
else()
    string(APPEND _f "\n Bildlage Game over (Form) fehlt")
endif()
if(_log MATCHES "Bildlage Game over: Spieler u (-?[0-9]+) Tiefe")
    if(CMAKE_MATCH_1 LESS 0 OR CMAKE_MATCH_1 GREATER_EQUAL 320)
        string(APPEND _f "\n Game over: Spieler ausser Bild (u ${CMAKE_MATCH_1})")
    endif()
else()
    string(APPEND _f "\n Bildlage Game over (Spieler) fehlt")
endif()
# W1/W2/W3: je Flugbild "Bildlage Rakete W<n> u <u> Tiefe <t>" und direkt danach "Bildlage Form W<n> u <u> Tiefe <t>".
string(REGEX MATCHALL "Bildlage (Rakete|Form) W[123] u -?[0-9]+ Tiefe -?[0-9]+" _bl "${_log}")
set(_w3 0)
set(_w3_vorn 0)
set(_w12 0)
set(_w12_im 0)
set(_ru "")
foreach(_z IN LISTS _bl)
    string(REGEX MATCH "Bildlage (Rakete|Form) W([123]) u (-?[0-9]+) Tiefe (-?[0-9]+)" _x "${_z}")
    if(CMAKE_MATCH_1 STREQUAL "Rakete")
        set(_ru "${CMAKE_MATCH_3}")
        set(_rt "${CMAKE_MATCH_4}")
        set(_rw "${CMAKE_MATCH_2}")
    elseif(NOT _ru STREQUAL "" AND CMAKE_MATCH_2 STREQUAL _rw)
        set(_ft "${CMAKE_MATCH_4}")
        set(_im 0)
        if(_ru GREATER_EQUAL 0 AND _ru LESS 320 AND _rt GREATER 0)
            set(_im 1)
        endif()
        if(_rw EQUAL 3)
            math(EXPR _w3 "${_w3} + 1")
            if(_im AND _rt LESS _ft)
                math(EXPR _w3_vorn "${_w3_vorn} + 1")
            endif()
        else()
            math(EXPR _w12 "${_w12} + 1")
            if(_im)
                math(EXPR _w12_im "${_w12_im} + 1")
            endif()
        endif()
        set(_ru "")
    endif()
endforeach()
# W3 dauert 10 Bilder (`addiu v1,zero,0xa` @0x80103a80), der Effekt entsteht im Bild t = 1 (`addiu v0,zero,1 / bne` @0x80103a48-4c);
# gemessen wird ab dem Folgebild bis zum Phasenwechsel -> 8 Bilder.
if(_w3 LESS 8 OR NOT _w3_vorn EQUAL _w3)
    string(APPEND _f "\n W3: Effekt ${_w3_vorn} von ${_w3} Bildern im Bild und vor der Form (erwartet alle, mindestens 8)")
endif()
math(EXPR _halb "${_w12} / 2")
if(_w12 LESS 10 OR _w12_im LESS _halb)
    string(APPEND _f "\n W1/W2: Rakete nur ${_w12_im} von ${_w12} Flugbildern im Bild")
endif()
message(STATUS "r42_finale_schuss: Bildlage W3 ${_w3_vorn}/${_w3} vorn, W1/W2 ${_w12_im}/${_w12} im Bild")
file(READ "${WORKDIR}/debug.log" _dbg)
# Runde 4 (R1): Wechsel beim Ausloesen und kein gezeigtes Bild mit dem Versetzen in der alten Kamera.
if(_log MATCHES "\\[finale\\] T[0-9]+ F([0-9]+) Ausloeser: ")
    set(_fa "${CMAKE_MATCH_1}")
    if(_log MATCHES "Ausloese-Schnitt: vorher (-?[0-9]+), angefordert ([0-9]+), Wechsel ([01])")
        set(_vor "${CMAKE_MATCH_1}")
        set(_neu "${CMAKE_MATCH_2}")
        set(_wx "${CMAKE_MATCH_3}")
        if(_vor EQUAL _neu OR NOT _wx EQUAL 1)
            string(APPEND _f "\n Ausloeser ohne Kamerawechsel (vorher ${_vor}, angefordert ${_neu}, Wechsel ${_wx})")
        endif()
        if(_vor LESS 11 OR _vor GREATER 14)
            string(APPEND _f "\n Ausloeser nicht in einer Lauf-Kamera von Wagen C (vorher ${_vor}) - der Lauf prueft die Regel nicht")
        endif()
    else()
        string(APPEND _f "\n Messzeile Ausloese-Schnitt fehlt")
    endif()
    if(NOT _dbg MATCHES "\\[kamerahalt\\] F${_fa} raum=${_raum} [^\n]* -> HALTEN")
        string(APPEND _f "\n Bild F${_fa} (Ausloeser, Versetzen auf die Fixpunkte) wird gezeigt statt gehalten")
    endif()
endif()
if(NOT _dbg MATCHES "\\[finale-se\\] Raumbank R702 \\(RE2 ROOM7020 snd0\\) geladen")
    string(APPEND _f "\n Raumtonbank R702 nicht geladen (Einschlag stumm)")
endif()
if(NOT _dbg MATCHES "\\[finale-se\\] Se_on Raumbank R702 Satz 0x0F")
    string(APPEND _f "\n Einschlag-Ton Raumbank R702 Satz 0x0F nicht gespielt")
endif()
if(_dbg MATCHES "\\[gator-re2\\] VSync 5 [^\n]* ab F([0-9]+)(.*)$")
    set(_v5 "${CMAKE_MATCH_1}")
    set(_nach "${CMAKE_MATCH_2}")
    if(_nach MATCHES "\\[gator-re2\\] VSync 2 [^\n]* ab F([0-9]+)")
        math(EXPR _dv "${CMAKE_MATCH_1} - ${_v5}")
        if(NOT _dv EQUAL _soll_zeitlupe)
            string(APPEND _f "\n Zeitlupe ${_dv} Bilder statt ${_soll_zeitlupe} (bis zum Kill + Phase 9)")
        endif()
    else()
        string(APPEND _f "\n VSync 2 nach der Zeitlupe fehlt")
    endif()
else()
    string(APPEND _f "\n VSync 5 (Einschlag) fehlt im debug.log")
endif()
if(_dbg MATCHES "\\[g5a\\]")
    string(APPEND _f "\n [g5a]-Zeile im Lauf: der G5-Auftritt lief")
endif()
if(NOT _dbg MATCHES "PC loaded room${_abspann}")
    string(APPEND _f "\n Abspann-Raum ${_abspann} nicht geladen")
endif()
# Stufe 4: Schlusszeile als Message_on mit Aufnahme (K-11) im Bild T+16 (sub15 Sleep 15 @0x01A30, Programmstart T+1) und Todesschrei-XA.
string(FIND "${_dbg}" "[msgtext] room=${_raum} id=2 \"${_zeile}\"" _pz)
if(_pz LESS 0)
    string(APPEND _f "\n Schlusszeile '${_zeile}' (ROOM${_raum} Meldung 2) nicht gezeigt")
else()
    string(SUBSTRING "${_dbg}" ${_pz} 400 _nach_zeile)
    if(NOT _nach_zeile MATCHES "\\[voice\\] clip loaded: main02[.]wav")
        string(APPEND _f "\n zur Schlusszeile keine Aufnahme synchro/STAGE5/room${_raum}/main02.wav geladen")
    endif()
endif()
if(EXISTS "${WORKDIR}/stimme.log")
    file(READ "${WORKDIR}/stimme.log" _st)
    math(EXPR _soll_zb "${_T} + 16")
    if(NOT _st MATCHES "raum=${_raum} nachricht=2 [^\n]* bild=${_soll_zb}\n")
        string(APPEND _f "\n Schlusszeile nicht im Bild T+16 = F${_soll_zb} (stimme.log)")
    endif()
else()
    string(APPEND _f "\n stimme.log fehlt (RE15_STIMME_LOG)")
endif()
string(FIND "${_dbg}" "[re2xa] ${_xa_datei} " _px)
if(_px LESS 0)
    string(APPEND _f "\n Todesschrei nicht gestartet ('[re2xa] ${_xa_datei}' fehlt)")
endif()
# Stufe 5: THANK YOU raus, Endvideo-Stelle zwischen Kill und Abspann.
string(FIND "${_dbg}" "[msgtext] room=${_raum} id=0 " _pty)
if(NOT _pty LESS 0)
    string(APPEND _f "\n Meldung 0 'THANK YOU FOR PLAYING !!!' (ROOM${_raum} id 0) gezeigt - NUTZERWUNSCH 18.11.: raus")
endif()
string(FIND "${_dbg}" "[endvideo] ROOM${_raum} sub02 -> Port-Programm ohne THANK YOU" _pev)
string(FIND "${_dbg}" "[ende${_raum}] Film angefordert" _pfa)
string(FIND "${_dbg}" "PC loaded room${_abspann}" _pab)
string(FIND "${_log}" "Kill: " _pki)
if(_pev LESS 0)
    string(APPEND _f "\n Port-Programm statt sub02 nicht gestartet ('[endvideo] ROOM${_raum} sub02 -> Port-Programm' fehlt)")
endif()
if(_pfa LESS 0)
    string(APPEND _f "\n Film-Zeile des Endvideos nicht erreicht ('[ende${_raum}] Film angefordert' fehlt)")
elseif(_pab LESS 0 OR _pfa GREATER _pab OR _pev GREATER _pfa)
    string(APPEND _f "\n Reihenfolge: Port-Programm @${_pev}, Film-Zeile @${_pfa}, Abspann geladen @${_pab} (soll Programm < Film < Abspann)")
endif()
if(_pki LESS 0)
    string(APPEND _f "\n Kill-Zeile fehlt im finale.log")
endif()
if(FILM)
    if(NOT _dbg MATCHES "\\[ende${_raum}\\] F[0-9]+ Film MOVIE/ENDE${_raum}[.]STR: 367 Bilder 320x240")
        string(APPEND _f "\n Platzhalter MOVIE/ENDE${_raum}.STR nicht gestartet")
    endif()
    if(_dbg MATCHES "\\[ende${_raum}\\] Film zu Ende: ([0-9]+) von 367 Bildern")
        if(CMAKE_MATCH_1 LESS 300)
            string(APPEND _f "\n Platzhalter nur ${CMAKE_MATCH_1} von 367 Bildern gezeigt")
        endif()
    else()
        string(APPEND _f "\n Platzhalter: 'Film zu Ende' fehlt")
    endif()
    string(FIND "${_dbg}" "[ende${_raum}] Film zu Ende:" _pfe)
    if(_pfe LESS 0 OR _pab LESS 0 OR _pfe GREATER _pab)
        string(APPEND _f "\n Platzhalter-Film endet nicht vor dem Laden des Abspanns (@${_pfe} / @${_pab})")
    endif()
else()
    if(NOT _dbg MATCHES "\\[ende${_raum}\\] Film MOVIE/ENDE${_raum}[.]STR FEHLT")
        string(APPEND _f "\n ohne Endvideo-Datei keine Meldung 'Film MOVIE/ENDE${_raum}.STR FEHLT' (Datei im Baum? Stelle nicht erreicht?)")
    endif()
endif()
if(NOT _dbg MATCHES "Set\\(0,1,0\\): INGAME aus -> Titel")
    string(APPEND _f "\n Diashow-Ende Set(0,1,0) nicht gesehen")
endif()
# S8 (Plan): die Diashow ROOM6040 dauert die Summe ihrer Sleeps, 3952 Bilder (@0x00534-0x00586, Dossier C 1.2); der Bildzaehler
# beginnt mit dem Raum neu, Set(0,1,0) @0x00590 faellt deshalb im Bild 3952 + Vorlauf des Raumstarts (gemessen 5: F3957).
if(_dbg MATCHES "\\[finale\\] F([0-9]+) ROOM${_abspann} Set\\(0,1,0\\)")
    math(EXPR _dia "${CMAKE_MATCH_1} - 3952")
    if(_dia LESS 0 OR _dia GREATER 8)
        string(APPEND _f "\n Diashow-Ende im Bild ${CMAKE_MATCH_1}, erwartet 3952 + 0..8 (Summe der Sleeps @0x00534-0x00586)")
    endif()
else()   # Runde 3 (Pruefbericht s1 r2, gelb): ohne die Zeile ist die Dauer nicht geprueft -> rot
