# Runde 38 Spur Q "kleinkram" — die drei Nutzer-Punkte an der ECHTEN exe.
# Dossier analysis/befunde_runde38/Q_kleinkram.md, Belege include/re15_kleinkram_r38.h. Registrierung:
# tests/unit/probes/r38_kleinkram.cmake.
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DRE15_KARTE_TOOL=<probe_r36_elza_karte> -DWORKDIR=<dir>
#         -DTEIL=<inventar|irons|flammenwerfer> -P test_r38_kleinkram.cmake
#   inventar       Leon ROOM1000 (Debug-Sprung), START in Bild 400 und 500 gegen einen Lauf ohne START, Mitschnitt
#                  RE15_AUDIO_CAP_SYNC: genau zwei hoerbare Abschnitte im Abstand von 100 Bildern; debug.log
#                  "[r38q] F400 Inventar-Ton Satz 6 (Oeffnen)" / "F500 ... Satz 5 (Abbruch)" (RE2 @0x8002652c / @0x8006a968)
#   irons          Elza-Spielstand ROOM1151 an der Gespraechslage (sub03 @0x00ECE/@0x00ED6) + CONTINUE, Viereck in Bild 60:
#                  kein Text bis zum Hinbeugen, Text 20 ab Bild 140..145 (60 + 80 Sleeps), Elza dabei motion 11, msg 2 nie,
#                  Irons in jedem Bild tot; zweites Anklicken (Bild 450) -> nur Text 20
#   flammenwerfer  Leon-Spielstand ROOM30E0 vor dem Panel + CONTINUE, Panel -> Cursor Zelle 4 -> Zelle 5 -> Viereck:
#                  Lauf "ja" Aufnahme-Modal 0x0E x100, genommen (2 Zellen), msg 15 nie; Lauf "nein" RECHTS + Viereck ->
#                  nicht genommen, Set(3,0x9C) entfaellt, erneutes Viereck am Panel startet sub09 (Cut 2) wieder
# Ein Lauf ohne Ergebnis (exit 1/-1 = von aussen beendet) wird EINMAL wiederholt.
cmake_minimum_required(VERSION 3.16)
set(_tag "r38_kleinkram_${TEIL}")
foreach(_v RE15_PC_EXE RE15_KARTE_TOOL WORKDIR TEIL)
    if(NOT ${_v})
        message(FATAL_ERROR "${_tag}: ${_v} fehlt")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")
string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_dir "${WORKDIR}/lauf_${TEIL}_${_lauf_id}")
file(MAKE_DIRECTORY "${_dir}")
set(WORKDIR "${_dir}")
# Messkopie unter eigenem Namen neben der exe (Asset-Wurzel = exe-Verzeichnis; Muster test_r34n_b_cursor.cmake).
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
file(GLOB _alte "${_exe_dir}/re15_pc_r38q_haken_*.exe")
foreach(_k IN LISTS _alte)
    file(REMOVE "${_k}")
endforeach()
set(_exe "${_exe_dir}/re15_pc_r38q_haken_${_lauf_id}.exe")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

macro(fail)
    file(REMOVE "${_exe}")
    message(FATAL_ERROR "${_tag}: ${ARGN} (${WORKDIR})")
endmacro()

macro(lauf _name _timeout)
    set(_sub "${WORKDIR}/${_name}")
    file(MAKE_DIRECTORY "${_sub}")
    set(_keep_wd "${WORKDIR}")
    set(WORKDIR "${_sub}")
    re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    if("${_rv}" STREQUAL "1" OR "${_rv}" STREQUAL "-1" OR NOT EXISTS "${_sub}/debug.log")
        message(STATUS "${_tag}[${_name}]: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(REMOVE "${_sub}/debug.log" "${_sub}/state.log" "${_sub}/cap.raw")
        re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    endif()
    set(WORKDIR "${_keep_wd}")
    if(NOT EXISTS "${_sub}/debug.log")
        fail("[${_name}] kein debug.log (exit=${_rv})")
    endif()
    file(STRINGS "${_sub}/debug.log" _ex REGEX "\\[flow\\] EXIT_AT: ")
    if(NOT _ex)
        fail("[${_name}] RE15_EXIT_AT nicht erreicht (exit=${_rv}) — Haenger?")
    endif()
endmacro()

macro(karte _name _raum _x _z _gier)
    file(MAKE_DIRECTORY "${WORKDIR}/${_name}")
    execute_process(COMMAND "${RE15_KARTE_TOOL}" "re15_card.mcr" ${_raum} ${_x} ${_z} ${_gier} ${ARGN}
                    WORKING_DIRECTORY "${WORKDIR}/${_name}" TIMEOUT 60 RESULT_VARIABLE _rvk OUTPUT_VARIABLE _outk)
    if(NOT _rvk EQUAL 0)
        fail("Kartenwerkzeug exit=${_rvk}: ${_outk}")
    endif()
endmacro()

set(_continue RE15_NO_INTRO=1 RE15_WINDOW_SCALE=1 RE15_CONTINUE_TEST=1 RE15_CARD_AUTO=1 RE15_CARD_SLOT=0)

if(TEIL STREQUAL "inventar")
    set(_env RE15_NO_INTRO=1 RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2 RE15_AUDIO_CAP_SYNC=cap.raw RE15_WINDOW_SCALE=1
             RE15_DEBUG_JUMP=1000@250 "RE15_PLAYER_POS=21850,-13400,2048" RE15_SE_DEBUG=1 RE15_STATE_LOG=state.log
             "RE15_EXIT_AT=600#1000")
    lauf(mit 240 ${_env} "RE15_PRESS=start@400,start@500")
    lauf(ohne 240 ${_env})
    file(STRINGS "${WORKDIR}/mit/debug.log" _auf REGEX "\\[r38q\\] F400 Inventar-Ton Satz 6 \\(Oeffnen\\)")
    file(STRINGS "${WORKDIR}/mit/debug.log" _zu  REGEX "\\[r38q\\] F500 Inventar-Ton Satz 5 \\(Abbruch\\)")
    file(STRINGS "${WORKDIR}/mit/debug.log" _alle REGEX "\\[r38q\\] F[0-9]+ Inventar-Ton")
    file(STRINGS "${WORKDIR}/ohne/debug.log" _ohne REGEX "\\[r38q\\] F[0-9]+ Inventar-Ton")
    list(LENGTH _alle _nalle)
    if(NOT _auf OR NOT _zu OR NOT _nalle EQUAL 2 OR _ohne)
        fail("debug.log: Oeffnen F400 Satz 6 '${_auf}', Schliessen F500 Satz 5 '${_zu}', ${_nalle} Inventar-Toene (soll 2), ohne-Lauf '${_ohne}'")
    endif()
    file(STRINGS "${WORKDIR}/mit/debug.log" _se6 REGEX "\\[se\\] Stimme: se=6 ")
    file(STRINGS "${WORKDIR}/mit/debug.log" _se5 REGEX "\\[se\\] Stimme: se=5 ")
    if(NOT _se6 OR NOT _se5)
        fail("Mischer hat CORE Satz 6/5 nicht gestartet (kein '[se] Stimme: se=6/5')")
    endif()
    # Mitschnitt: je Spielbild 1470 Stereo-Abtastungen s16 = 5880 Byte (audio_pc.c RE15_AUDIO_CAP_SYNC)
    set(_fb 5880)
    file(SIZE "${WORKDIR}/mit/cap.raw" _sm)
    file(SIZE "${WORKDIR}/ohne/cap.raw" _so)
    if(NOT _sm EQUAL _so)
        fail("Mitschnitte verschieden lang (${_sm} / ${_so})")
    endif()
    math(EXPR _nf "${_sm} / ${_fb}")
    if(_nf LESS 700)
        fail("Mitschnitt zu kurz (${_nf} Bilder)")
    endif()
    set(_abschnitte "")
    set(_vorher_gleich 1)
    set(_nabw 0)
    math(EXPR _letzt "${_nf} - 1")
    foreach(_f RANGE 0 ${_letzt})
        math(EXPR _ofs "${_f} * ${_fb}")
        file(READ "${WORKDIR}/mit/cap.raw"  _a OFFSET ${_ofs} LIMIT ${_fb} HEX)
        file(READ "${WORKDIR}/ohne/cap.raw" _b OFFSET ${_ofs} LIMIT ${_fb} HEX)
        if(NOT _a STREQUAL _b)
            math(EXPR _nabw "${_nabw} + 1")
            if(_vorher_gleich)
                list(APPEND _abschnitte ${_f})
            endif()
            set(_vorher_gleich 0)
        else()
            set(_vorher_gleich 1)
        endif()
    endforeach()
    list(LENGTH _abschnitte _nabs)
    if(NOT _nabs EQUAL 2)
        fail("Mitschnitt: ${_nabs} hoerbare Abschnitte (${_abschnitte}), soll 2 (Oeffnen + Schliessen)")
    endif()
    list(GET _abschnitte 0 _a1)
    list(GET _abschnitte 1 _a2)
    math(EXPR _abstand "${_a2} - ${_a1}")
    if(NOT _abstand EQUAL 100)
        fail("Mitschnitt: Abschnitte bei ${_a1} und ${_a2}, Abstand ${_abstand} (soll 100 = Bild 500 - Bild 400)")
    endif()
    message(STATUS "${_tag}: OK — Satz 6 in F400 (Mitschnitt-Bild ${_a1}), Satz 5 in F500 (Bild ${_a2}), ${_nabw} abweichende Bilder; ohne START bytegleich")

elseif(TEIL STREQUAL "irons")
    karte(irons 1151 -20538 -25147 1500)
    lauf(irons 300 ${_continue} RE15_NOAUDIO=1 RE15_STATE_LOG=state.log
         "RE15_PRESS=square@60,square@200,square@450,square@500" "RE15_EXIT_AT=560#1151")
    file(STRINGS "${WORKDIR}/irons/debug.log" _cont REGEX "CONTINUE: resumed in room 1151")
    if(NOT _cont)
        fail("Spielstand ROOM1151 nicht geladen")
    endif()
    file(STRINGS "${WORKDIR}/irons/state.log" _m2 REGEX "msg\\(a=1 fsm=[01] id=2 ")
    if(_m2)
        fail("msg 2 \"I'll be fine...\" erscheint (${_m2})")
    endif()
    file(STRINGS "${WORKDIR}/irons/state.log" _m20 REGEX "^F[0-9]+ .*msg\\(a=1 fsm=1 id=20 ")
    if(NOT _m20)
        fail("Text 20 erscheint nie")
    endif()
    list(GET _m20 0 _erste)
    string(REGEX MATCH "^F([0-9]+) " _m "${_erste}")
    set(_ft ${CMAKE_MATCH_1})
    if(_ft LESS 140 OR _ft GREATER 145)
        fail("Text 20 ab Bild ${_ft} — soll nach dem Hinbeugen kommen: Druck 60 + Stempel/sub01 + Sleeps 10+40+30 = 140..145")
    endif()
    if(NOT _erste MATCHES " mo=11 ")
        fail("beim ersten Text-Bild ist Elza nicht in Plc_motion(1,0x0B) @0x00EEC: ${_erste}")
    endif()
    # zweites Anklicken (Bild 450): nur Text 20
    set(_zweite 0)
    foreach(_l ${_m20})
        string(REGEX MATCH "^F([0-9]+) " _m "${_l}")
        if(CMAKE_MATCH_1 GREATER 449 AND CMAKE_MATCH_1 LESS 460)
            set(_zweite 1)
        endif()
    endforeach()
    if(NOT _zweite)
        fail("zweites Anklicken (Bild 450) zeigt keinen Text 20")
    endif()
    file(STRINGS "${WORKDIR}/irons/debug.log" _tx REGEX "\\[r38q\\] F[0-9]+ ROOM1151 sub03 @0x00EFA Message_on 2 -> Text 20")
    file(STRINGS "${WORKDIR}/irons/debug.log" _ende REGEX "\\[r38q\\] F[0-9]+ ROOM1151 sub03 Ende: Slot 2 -> Text-Platz 20, \\(3,0x9D\\)=1")
    list(LENGTH _tx _ntx)
    if(NOT _ntx EQUAL 1 OR NOT _ende)
        fail("Anker: ${_ntx}x Text (soll 1), Ende '${_ende}'")
    endif()
    file(STRINGS "${WORKDIR}/irons/state.log" _tot REGEX "\\[1 t=45 st=4 ss1=0 ss2=2 ss3=0 g=00 mo=2 af=89 ")
    file(STRINGS "${WORKDIR}/irons/state.log" _alle REGEX "\\[1 t=45 ")
    list(LENGTH _tot _ntot)
    list(LENGTH _alle _nalle)
    if(_nalle LESS 500 OR NOT _ntot EQUAL _nalle)
        fail("Irons: ${_ntot} von ${_nalle} Bildern in der Totenpose")
    endif()
    message(STATUS "${_tag}: OK — Text 20 ab F${_ft} mit Elza gebeugt (mo=11), msg 2 nie, Irons ${_ntot}/${_nalle} tot, zweites Anklicken nur Text")

elseif(TEIL STREQUAL "flammenwerfer")
    # Eingabe ab Spielbild 60: Viereck am Panel (sub09, Cut 2), LINKS 24 Bilder (sub08 x-200 -> Zelle 4), Viereck (sub10,
    # Cut 3), RECHTS 4 Bilder (sub07 -> Zelle 5), Viereck (sub04) — gemessen im Dossier Abschnitt 1.
    set(_weg "A0.1,W0.5,L0.8,W0.5,A0.1,W1,R0.13,W0.5,A0.1")
    karte(ja 30E0 -25000 -26400 2048)
    lauf(ja 300 ${_continue} RE15_NOAUDIO=1 RE15_STATE_LOG=state.log RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=60
         "RE15_INPUT_SCRIPT=${_weg},W3,A0.1,W3" "RE15_EXIT_AT=460#30E0")
    file(STRINGS "${WORKDIR}/ja/debug.log" _cont REGEX "CONTINUE: resumed in room 30e0")
    file(STRINGS "${WORKDIR}/ja/debug.log" _mod REGEX "\\[r38q\\] F[0-9]+ ROOM30E0 sub04 @0x00FEE Message_on 15 -> Aufnahme-Modal Item 0x0E x100")
    file(STRINGS "${WORKDIR}/ja/debug.log" _gen REGEX "\\[r38q\\] F[0-9]+ ROOM30E0 Flammenwerfer genommen: Zellen 0 -> 2")
    file(STRINGS "${WORKDIR}/ja/state.log" _m15 REGEX "msg\\(a=1 fsm=[01] id=15 ")
    if(NOT _cont OR NOT _mod OR NOT _gen OR _m15)
        fail("ja: CONTINUE '${_cont}', Modal '${_mod}', genommen '${_gen}', msg 15 '${_m15}'")
    endif()
    karte(nein 30E0 -25000 -26400 2048)
    lauf(nein 300 ${_continue} RE15_NOAUDIO=1 RE15_STATE_LOG=state.log RE15_SCD_TRACE=1 RE15_INPUT_SCRIPT_BASIS=spiel
         RE15_INPUT_SCRIPT_START=60 "RE15_INPUT_SCRIPT=${_weg},W4,R0.1,W0.3,A0.1,W3,A0.1,W2" "RE15_EXIT_AT=520#30E0")
    file(READ "${WORKDIR}/nein/debug.log" _dbg)
    string(FIND "${_dbg}" "Flammenwerfer NICHT genommen (No/voll): Panel Slot 3 wieder scharf" _p1)
    string(FIND "${_dbg}" "sub04 @0x00FFA Set(3,0x9C) entfaellt" _p2)
    if(_p1 LESS 0 OR _p2 LESS _p1)
        fail("nein: 'NICHT genommen' @${_p1}, 'Set(3,0x9C) entfaellt' @${_p2}")
    endif()
    string(SUBSTRING "${_dbg}" ${_p2} -1 _rest)
    string(FIND "${_rest}" "first_op=0x29" _p3)
    if(_p3 LESS 0)
        fail("nein: nach dem Ablehnen startet das Panel (sub09, Cut_chg 2) nicht mehr")
    endif()
    file(STRINGS "${WORKDIR}/nein/state.log" _m15n REGEX "msg\\(a=1 fsm=[01] id=15 ")
    if(_m15n)
        fail("nein: msg 15 erscheint")
    endif()
    message(STATUS "${_tag}: OK — ja: Modal 0x0E x100, genommen 0 -> 2 Zellen, msg 15 nie; nein: liegt, Bit aus, Panel wieder scharf")
else()
    fail("unbekannter TEIL '${TEIL}'")
endif()
file(REMOVE "${_exe}")
