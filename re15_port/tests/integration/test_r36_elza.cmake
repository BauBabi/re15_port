# Runde 36 Spur L "elza" — INTEGRATION an der ECHTEN exe (Elza-Spiel). Dossier analysis/befunde_runde36/L_elza.md.
# Registrierung: tests/unit/probes/r36_elza.cmake. Aufruf:
#   cmake -DRE15_PC_EXE=<exe> -DRE15_KARTE_TOOL=<probe_r36_elza_karte> -DRE15_AUSWERT_TOOL=<probe_r36_elza_auswertung>
#         -DRE15_SYNCHRO_WAV=<eine versionierte wav> -DWORKDIR=<dir> -DTEIL=<fenster|irons|unlock|schuss|stoehnen> -P ...
# Wege (VERTRAG: Story-/Raum-Punkte ueber den echten Weg):
#   fenster  Leon ROOM1120 und Elza ROOM1121 ueber den Tuer-/Raumwechsel-Weg (RE15_GOTO_ROOM -> re15_room_apply_pending),
#            gleicher Cut 1 + Bild 90: die 309 Schadens-Pixel muessen ELZA = LEON (+) Op sein, vier Kraehen.
#   irons    Elza-Spielstand in ROOM1151 + CONTINUE (Boot-/Lade-Weg, main.c-Haken), Anklicken = AOT-Feuer-Pfad.
#   unlock   Elza-Spielstand in ROOM1211 (Prison key (4,0xEC)) im Auto-Feld der Szene + CONTINUE, Ton im Mitschnitt.
#   schuss   Elza ROOM1021 (Flags (4,0x60),(3,0xC9)), Szene ueber das AOT-Ereignis 2, Schuesse + Roys Ton im Mitschnitt.
#   stoehnen Elza-Spielstand ROOM1021, Tuer 1 -> ROOM1011 Cut 0 (Roy-Szene), main16.5.wav aus WORKDIR/synchro.
cmake_minimum_required(VERSION 3.16)
set(_tag "r36_elza_${TEIL}")
foreach(_v RE15_PC_EXE RE15_KARTE_TOOL RE15_AUSWERT_TOOL WORKDIR TEIL)
    if(NOT ${_v})
        message(FATAL_ERROR "${_tag}: ${_v} fehlt")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")
string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_dir "${WORKDIR}/lauf_${TEIL}_${_lauf_id}")
file(MAKE_DIRECTORY "${_dir}")
set(WORKDIR "${_dir}")
# Messkopie unter eigenem Namen neben der exe (Asset-Wurzel = exe-Verzeichnis; Muster test_r34n_b_cursor.cmake).
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
set(_exe "${_exe_dir}/re15_pc_r36elza_${_lauf_id}.exe")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

macro(lauf_elza _name _timeout)
    set(_sub "${WORKDIR}/${_name}")
    file(MAKE_DIRECTORY "${_sub}")
    set(_keep_wd "${WORKDIR}")
    set(WORKDIR "${_sub}")
    re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    if("${_rv}" STREQUAL "1" OR "${_rv}" STREQUAL "-1" OR NOT EXISTS "${_sub}/debug.log")
        message(STATUS "${_tag}[${_name}]: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(REMOVE "${_sub}/debug.log" "${_sub}/state.log" "${_sub}/elza.log" "${_sub}/cap.raw")
        re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    endif()
    set(WORKDIR "${_keep_wd}")
    if(NOT EXISTS "${_sub}/debug.log")
        file(REMOVE "${_exe}")
        message(FATAL_ERROR "${_tag}[${_name}]: kein debug.log (exit=${_rv}, ${_sub})")
    endif()
endmacro()

macro(karte _name _raum _x _z _gier)
    file(MAKE_DIRECTORY "${WORKDIR}/${_name}")
    execute_process(COMMAND "${RE15_KARTE_TOOL}" "re15_card.mcr" ${_raum} ${_x} ${_z} ${_gier} ${ARGN}
                    WORKING_DIRECTORY "${WORKDIR}/${_name}" TIMEOUT 60 RESULT_VARIABLE _rvk OUTPUT_VARIABLE _outk)
    if(NOT _rvk EQUAL 0)
        file(REMOVE "${_exe}")
        message(FATAL_ERROR "${_tag}: Kartenwerkzeug exit=${_rvk}\n${_outk}")
    endif()
endmacro()

macro(fail)
    file(REMOVE "${_exe}")
    message(FATAL_ERROR "${_tag}: ${ARGN} (${WORKDIR})")
endmacro()

# Raum-Bild der ersten Anker-Aktion `_akt` aus elza.log -> Variable _out (leer = keine)
macro(aktion_bilder _log _akt _out)
    file(STRINGS "${_log}" _al REGEX "Aktion ${_akt} ")
    set(${_out} "")
    foreach(_l ${_al})
        string(REGEX MATCH "^F([0-9]+) " _m "${_l}")
        list(APPEND ${_out} "${CMAKE_MATCH_1}")
    endforeach()
endmacro()

# Fenster des Mitschnitts auswerten: spitze/median je Fenster -> Listen _sp / _md
macro(mitschnitt _cap _exit)
    execute_process(COMMAND "${RE15_AUSWERT_TOOL}" mitschnitt "${_cap}" ${_exit} ${ARGN}
                    RESULT_VARIABLE _rva OUTPUT_VARIABLE _outa)
    if(NOT _rva EQUAL 0)
        fail("Mitschnitt-Auswertung exit=${_rva}: ${_outa}")
    endif()
    message(STATUS "${_tag}: ${_outa}")
    string(REGEX MATCHALL "spitze [0-9]+" _spl "${_outa}")
    string(REGEX MATCH "median [0-9]+" _mdl "${_outa}")
    string(REGEX REPLACE "median " "" _median "${_mdl}")
    set(_sp "")
    foreach(_spx ${_spl})
        string(REGEX REPLACE "spitze " "" _spv "${_spx}")
        list(APPEND _sp "${_spv}")
    endforeach()
endmacro()

set(_basis RE15_NO_INTRO=1 RE15_WINDOW_SCALE=1)
set(_elza_neu RE15_TITLE_CONFIRM_MS=1500 RE15_PSELECT_AUTO=1 RE15_PSELECT_AUTO_SWITCH=1)
set(_continue RE15_CONTINUE_TEST=1 RE15_CARD_AUTO=1 RE15_CARD_SLOT=0)

if(TEIL STREQUAL "fenster")
    lauf_elza(leon 300 ${_basis} RE15_NOAUDIO=1 RE15_TITLE_CONFIRM_MS=1500 RE15_PSELECT_AUTO=1
              RE15_GOTO_ROOM=1120 RE15_FORCE_CUT=1 "RE15_FRAMEDUMP=90:cut1.ppm" "RE15_EXIT_AT=95#1120")
    lauf_elza(elza 300 ${_basis} RE15_NOAUDIO=1 ${_elza_neu} RE15_SPAWN_DIAG=1 RE15_STATE_LOG=state.log
              RE15_GOTO_ROOM=1121 RE15_FORCE_CUT=1 "RE15_FRAMEDUMP=90:cut1.ppm" "RE15_EXIT_AT=95#1121")
    file(STRINGS "${WORKDIR}/elza/debug.log" _pl REGEX "\\[pl\\] Spieler-Familie PL04")
    if(NOT _pl)
        fail("kein Elza-Spiel")
    endif()
    file(STRINGS "${WORKDIR}/elza/debug.log" _kr REGEX "Sce_em_set type=0x21 ")
    file(STRINGS "${WORKDIR}/elza/debug.log" _k4 REGEX "Sce_em_set type=0x21 behavior=0x00 slot=3 pos=\\(5327,0,10217\\) dir=1048")
    list(LENGTH _kr _nkr)
    if(NOT _nkr EQUAL 4 OR NOT _k4)
        fail("ROOM1121: ${_nkr} Kraehen-Spawns (soll 4, davon Slot 3 bei (5327,0,10217) dir 1048)")
    endif()
    execute_process(COMMAND "${RE15_AUSWERT_TOOL}" bild "${WORKDIR}/leon/cut1.ppm" "${WORKDIR}/elza/cut1.ppm"
                    RESULT_VARIABLE _rvb OUTPUT_VARIABLE _outb)
    string(REGEX MATCH "ops ([0-9]+) formel ([0-9]+) verschieden ([0-9]+)" _m "${_outb}")
    if(NOT _rvb EQUAL 0 OR NOT _m)
        fail("Bildvergleich: ${_outb}")
    endif()
    set(_ops ${CMAKE_MATCH_1})
    set(_formel ${CMAKE_MATCH_2})
    set(_versch ${CMAKE_MATCH_3})
    math(EXPR _min_formel "${_ops} * 95 / 100")
    if(_formel LESS _min_formel OR _versch LESS _min_formel)
        fail("Fenster: ${_formel}/${_ops} Pixel = Leon (+) Schaden, ${_versch} verschieden (je >= ${_min_formel})")
    endif()
    message(STATUS "${_tag}: OK — 4 Kraehen (Slot 3 bei (5327,0,10217)), Schaden ${_formel}/${_ops} Pixel nach Formel")

elseif(TEIL STREQUAL "irons")
    karte(irons 1151 -17150 -11960 1600)
    lauf_elza(irons 300 ${_basis} RE15_NOAUDIO=1 ${_continue} RE15_STATE_LOG=state.log RE15_ELZA_LOG=elza.log
              RE15_FORCE_CUT=7 RE15_NECK_TRACE=neck.log "RE15_FIRE_AOT=2@60#1151" "RE15_EXIT_AT=150#1151")
    file(READ "${WORKDIR}/irons/debug.log" _dbg)
    string(FIND "${_dbg}" "CONTINUE: resumed in room 1151" _p)
    if(_p LESS 0)
        fail("Spielstand ROOM1151 nicht geladen")
    endif()
    file(STRINGS "${WORKDIR}/irons/state.log" _tot REGEX "\\[1 t=45 st=4 ss1=0 ss2=2 ss3=0 g=00 mo=2 af=89 ")
    file(STRINGS "${WORKDIR}/irons/state.log" _alle REGEX "\\[1 t=45 ")
    list(LENGTH _tot _ntot)
    list(LENGTH _alle _nalle)
    if(_nalle LESS 100 OR NOT _ntot EQUAL _nalle)
        fail("Irons: ${_ntot} von ${_nalle} Bildern in Clip 2 Bild 89 Phase 2")
    endif()
    file(STRINGS "${WORKDIR}/irons/state.log" _m20 REGEX "msg\\(a=1 fsm=1 id=20 ")
    file(STRINGS "${WORKDIR}/irons/state.log" _m2 REGEX "msg\\(a=1 fsm=[01] id=2 ")
    if(NOT _m20 OR _m2)
        fail("Anklicken: Text 20 nicht offen oder Original msg 2 offen")
    endif()
    # Kopf: die Kopf-FSM (Render-Pfad, skeleton_common.c) taktet je Bild; Flags 0x92 + Schritt 0 -> Akku bleibt (0,0)
    file(STRINGS "${WORKDIR}/irons/neck.log" _nk REGEX " slot=1 ")
    file(STRINGS "${WORKDIR}/irons/neck.log" _nk0 REGEX " slot=1 fl=92 .* acc=\\(0,0\\) .* step=\\(0,0\\)")
    list(LENGTH _nk _nnk)
    list(LENGTH _nk0 _nnk0)
    # (ab Bild 60 friert der Text mit Maske 0xffff die KI ein -> die Kopf-FSM taktet dann nicht: Freeze-Gate
    #  skeleton_common.c, Original @0x8011c5c0; gemessen 60 Takte bis zum Anklicken)
    if(_nnk LESS 50 OR NOT _nnk0 EQUAL _nnk)
        fail("Irons-Kopf: ${_nnk0} von ${_nnk} Kopf-Takten mit Flags 0x92, Akku (0,0), Schritt (0,0)")
    endif()
    message(STATUS "${_tag}: OK — Irons ${_ntot}/${_nalle} Bilder tot (Clip 2 Bild 89), Kopf fest ${_nnk0}/${_nnk}, Anklicken -> Text 20")

elseif(TEIL STREQUAL "unlock")
    karte(unlock 1211 -19500 -19100 2048 4:0xEC)
    lauf_elza(unlock 600 ${_basis} ${_continue} RE15_AUDIO_CAP_SYNC=cap.raw RE15_ELZA_LOG=elza.log
              "RE15_EXIT_AT=1000#1211")
    aktion_bilder("${WORKDIR}/unlock/elza.log" 1 _b)
    list(LENGTH _b _nb)
    if(NOT _nb EQUAL 1)
        fail("Unlock-Aktion ${_nb}x (soll 1)")
    endif()
    list(GET _b 0 _b0)
    mitschnitt("${WORKDIR}/unlock/cap.raw" 1000 ${_b0} 16)
    list(GET _sp 0 _s0)
    math(EXPR _schwelle "${_median} * 3")
    if(_s0 LESS _schwelle)
        fail("Unlock-Ton nicht im Mitschnitt: Spitze ${_s0} < 3 x Median ${_median}")
    endif()
    message(STATUS "${_tag}: OK — Unlock-Aktion Bild ${_b0}, Spitze ${_s0} (Median ${_median})")

elseif(TEIL STREQUAL "schuss")
    lauf_elza(schuss 600 ${_basis} ${_elza_neu} "RE15_SET_FLAG=4:0x60,3:0xC9" RE15_GOTO_ROOM=1021
              "RE15_FORCE_EVENT=2@40" RE15_AUDIO_CAP_SYNC=cap.raw RE15_ELZA_LOG=elza.log "RE15_EXIT_AT=800#1021")
    aktion_bilder("${WORKDIR}/schuss/elza.log" 2 _s)
    aktion_bilder("${WORKDIR}/schuss/elza.log" 3 _r)
    list(LENGTH _s _ns)
    list(LENGTH _r _nr)
    if(NOT _ns EQUAL 2 OR NOT _nr EQUAL 1)
        fail("Aktionen: ${_ns} Schuesse (soll 2), ${_nr} Roy (soll 1)")
    endif()
    list(GET _s 0 _s1)
    list(GET _s 1 _s2)
    list(GET _r 0 _r0)
    math(EXPR _d "${_s2} - ${_s1}")
    if(NOT _d EQUAL 30 OR NOT _r0 EQUAL _s2)
        fail("Abstand Schuss 1->2 = ${_d} (soll 30 = Sleep @0x020D2), Roy ${_r0} (soll = Schuss 2 ${_s2})")
    endif()
    math(EXPR _r5 "${_r0} + 10")
    mitschnitt("${WORKDIR}/schuss/cap.raw" 800 ${_s1} 2 ${_s2} 2 ${_r5} 40)
    list(GET _sp 0 _p1)
    list(GET _sp 1 _p2)
    list(GET _sp 2 _p3)
    math(EXPR _schwelle "${_median} * 4")
    math(EXPR _schwelle_r "${_median} * 2")
    if(_p1 LESS _schwelle OR _p2 LESS _schwelle OR _p3 LESS _schwelle_r)
        fail("Mitschnitt: Schuss ${_p1}/${_p2} (>= ${_schwelle}), Roy ${_p3} (>= ${_schwelle_r}), Median ${_median}")
    endif()
    message(STATUS "${_tag}: OK — Schuesse Bild ${_s1}/${_s2} (Spitzen ${_p1}/${_p2}), Roy ab Bild ${_r0} (Spitze ${_p3}), Median ${_median}")

elseif(TEIL STREQUAL "stoehnen")
    if(NOT RE15_SYNCHRO_WAV OR NOT EXISTS "${RE15_SYNCHRO_WAV}")
        fail("RE15_SYNCHRO_WAV fehlt")
    endif()
    karte(stoehnen 1021 -4000 -18000 2695)
    # Stellvertreter fuer die Nutzer-Aufnahme (unversioniert im Hauptbaum): eine versionierte wav unter dem Namen
    # main16.5.wav im Arbeitsordner (Basis-Wurzel cwd, asset_root_pc.c rr_init) — geprueft wird die ZUORDNUNG.
    file(MAKE_DIRECTORY "${WORKDIR}/stoehnen/synchro/STAGE1/room1011")
    file(COPY_FILE "${RE15_SYNCHRO_WAV}" "${WORKDIR}/stoehnen/synchro/STAGE1/room1011/main16.5.wav")
    lauf_elza(stoehnen 900 ${_basis} ${_continue} RE15_AUDIO_CAP_SYNC=cap.raw RE15_ELZA_LOG=elza.log
              RE15_STATE_LOG=state.log "RE15_FIRE_AOT=1@40#1021" "RE15_EXIT_AT=2000#1011")
    aktion_bilder("${WORKDIR}/stoehnen/elza.log" 4 _a)
    list(LENGTH _a _na)
    file(STRINGS "${WORKDIR}/stoehnen/debug.log" _wl REGEX "\\[voice\\] clip loaded: main16\\.5\\.wav")
    file(STRINGS "${WORKDIR}/stoehnen/state.log" _m24 REGEX "msg\\(a=1 fsm=1 id=24 ")
    if(NOT _na EQUAL 1 OR NOT _wl OR NOT _m24)
        fail("Roy-Stoehnen: Aktion ${_na}x, main16.5.wav geladen='${_wl}', Nachricht 24 offen='${_m24}'")
    endif()
    message(STATUS "${_tag}: OK — Aktion Bild ${_a}, main16.5.wav geladen, Nachricht 24 offen")
else()
    fail("unbekannter TEIL '${TEIL}'")
endif()
file(REMOVE "${_exe}")
