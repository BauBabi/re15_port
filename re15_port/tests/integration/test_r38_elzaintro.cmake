# Runde 38 Spur E "elzaintro" — INTEGRATION an der ECHTEN exe. Dossier analysis/befunde_runde38/E_elzaintro.md.
# Registrierung: tests/unit/probes/r38_elzaintro.cmake. Aufruf:
#   cmake -DRE15_PC_EXE=<exe> -DRE15_AUSWERT_TOOL=<probe_r38_elzaintro_auswertung> -DWORKDIR=<dir>
#         -DTEIL=<stimme|schwarz> -P test_r38_elzaintro.cmake
# Weg (VERTRAG: der echte Weg, Elza mit RE15_PSELECT_AUTO_SWITCH): Titel -> NEW GAME -> Charakterwahl -> Montage
# (Leon ROOM1240, Elza ROOM1241) -> Tuer -> Erzaehler (Leon ROOM1170 Cut 7, Elza ROOM1031 Cut 13). Je TEIL ein Leon-
# und ein Elza-Lauf; Leon ist die Referenz ("Es ist das gleiche wie bei Leon").
#   stimme   Elza laedt msg 0..5 aus synchro/STAGE1/room1240 (Haken audio_pc.c), Mitschnitt RE15_AUDIO_CAP_SYNC: RMS je
#            Zeilenfenster Elza = Leon +-10 % (vorher 0,25 im ersten Fenster: 949 gegen 3763), msg 5 parkt gleich lang
#   schwarz  Erzaehlerbilder F60/F230/F400: Elza = Leon PIXELGLEICH, Feld des Lageplans x 91..98 / y 107..112 dunkel,
#            obwohl der Lageplan in ROOM1031 angelegt ist ([kartenitems]-Zeile)
cmake_minimum_required(VERSION 3.16)
set(_tag "r38_elzaintro_${TEIL}")
foreach(_v RE15_PC_EXE RE15_AUSWERT_TOOL WORKDIR TEIL)
    if(NOT ${_v})
        message(FATAL_ERROR "${_tag}: ${_v} fehlt")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")
string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_dir "${WORKDIR}/lauf_${TEIL}_${_lauf_id}")
file(MAKE_DIRECTORY "${_dir}")
set(WORKDIR "${_dir}")
# Messkopie unter eigenem Namen neben der exe (Asset-Wurzel = exe-Verzeichnis; Muster test_r34n_b_cursor.cmake).
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
set(_exe "${_exe_dir}/re15_pc_r38e_${_lauf_id}.exe")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

macro(fail)
    file(REMOVE "${_exe}")
    message(FATAL_ERROR "${_tag}: ${ARGN} (${WORKDIR})")
endmacro()

macro(lauf _name _timeout)
    set(_sub "${WORKDIR}/${_name}")
    file(MAKE_DIRECTORY "${_sub}")
    set(_keep_wd "${WORKDIR}")
    set(WORKDIR "${_sub}")
    re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    if("${_rv}" STREQUAL "1" OR "${_rv}" STREQUAL "-1" OR NOT EXISTS "${_sub}/debug.log")
        message(STATUS "${_tag}[${_name}]: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(GLOB _alt "${_sub}/*")
        if(_alt)
            file(REMOVE ${_alt})
        endif()
        re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    endif()
    set(WORKDIR "${_keep_wd}")
    if(NOT EXISTS "${_sub}/debug.log")
        fail("[${_name}] kein debug.log (exit=${_rv})")
    endif()
endmacro()

# Grep-Zaehler: Zeilen in _datei, die _regex treffen -> Variable _out. FUNCTION, nicht macro: ein macro setzt den
# Regex TEXTUELL ein, CMake wertet "\[" dabei ein zweites Mal aus und macht "[" daraus (gemessen: 0 Treffer auf
# "[pl] Spieler-Familie PL04", obwohl die Zeile im Log steht).
function(zeilen _datei _regex _out)
    file(STRINGS "${_datei}" _zz REGEX "${_regex}")
    list(LENGTH _zz _n)
    set(${_out} ${_n} PARENT_SCOPE)
endfunction()

set(_neu RE15_NO_INTRO=1 RE15_WINDOW_SCALE=1 RE15_TITLE_CONFIRM_MS=1500 RE15_PSELECT_AUTO=1 RE15_MSG_LOG=1
         RE15_EVT_TRACE=1)

if(TEIL STREQUAL "stimme")
    lauf(leon 900 ${_neu} RE15_AUDIO_CAP_SYNC=cap.raw "RE15_EXIT_AT=1300#1240")
    lauf(elza 900 ${_neu} RE15_PSELECT_AUTO_SWITCH=1 RE15_AUDIO_CAP_SYNC=cap.raw "RE15_EXIT_AT=1300#1241")
    zeilen("${WORKDIR}/elza/debug.log" "\\[pl\\] Spieler-Familie PL04" _pl)
    if(_pl LESS 1)
        fail("kein Elza-Spiel (PL04-Zeilen: ${_pl})")
    endif()
    # 1) Zuordnung: jede der sechs Zeilen kommt aus room1240 (Haken audio_pc.c re15_voice_load_clip)
    foreach(_i 0 1 2 3 4 5)
        zeilen("${WORKDIR}/elza/debug.log"
               "\\[voice\\] ROOM1241 msg ${_i} <- synchro/STAGE1/room1240/main0${_i}\\.wav \\(Runde 38 Spur E\\)" _v)
        zeilen("${WORKDIR}/leon/debug.log" "\\[voice\\] clip loaded: main0${_i}\\.wav" _vl)
        if(NOT _v EQUAL 1 OR NOT _vl EQUAL 1)
            fail("msg ${_i}: Elza-Ersatz ${_v}x (soll 1), Leon-Clip ${_vl}x (soll 1)")
        endif()
    endforeach()
    zeilen("${WORKDIR}/leon/debug.log" "Runde 38 Spur E" _leon_e)
    if(NOT _leon_e EQUAL 0)
        fail("Leon nimmt den Elza-Ersatz (${_leon_e} Zeilen)")
    endif()
    # 2) Ablauf: msg 5 parkt, solange main04 laeuft (op_message_on-Riegel) - bei Elza jetzt genauso lange wie bei Leon
    zeilen("${WORKDIR}/elza/debug.log" "\\[msg\\] room=1241 id=5 " _p5e)
    zeilen("${WORKDIR}/leon/debug.log" "\\[msg\\] room=1240 id=5 " _p5l)
    if(_p5e LESS 2 OR NOT _p5e EQUAL _p5l)
        fail("msg 5 Aufrufe Elza ${_p5e} / Leon ${_p5l} (soll gleich, >= 2 = geparkt)")
    endif()
    # 3) Mitschnitt: RMS je Zeilenfenster (Message_on-Bilder F181/F383/F563/F765/F967 + msg 5 nach dem Parken)
    set(_fenster 60 90 181 150 383 150 563 150 765 150 967 150 1180 110)
    foreach(_wer leon elza)
        execute_process(COMMAND "${RE15_AUSWERT_TOOL}" rms "${WORKDIR}/${_wer}/cap.raw" 1300 0 ${_fenster}
                        RESULT_VARIABLE _rva OUTPUT_VARIABLE _out_${_wer})
        if(NOT _rva EQUAL 0)
            fail("Auswertung ${_wer}: ${_out_${_wer}}")
        endif()
        message(STATUS "${_tag} ${_wer}: ${_out_${_wer}}")
        string(REGEX MATCHALL "rms [0-9]+" _r "${_out_${_wer}}")
        set(_rms_${_wer} "")
        foreach(_x ${_r})
            string(REPLACE "rms " "" _x "${_x}")
            list(APPEND _rms_${_wer} ${_x})
        endforeach()
    endforeach()
    list(LENGTH _rms_elza _n)
    if(NOT _n EQUAL 7)
        fail("Mitschnitt: ${_n} Fenster (soll 7)")
    endif()
    math(EXPR _letzt "${_n} - 1")
    foreach(_k RANGE 0 ${_letzt})
        list(GET _rms_elza ${_k} _e)
        list(GET _rms_leon ${_k} _l)
        math(EXPR _lo "${_l} * 90 / 100")
        math(EXPR _hi "${_l} * 110 / 100")
        if(_e LESS _lo OR _e GREATER _hi)
            fail("Fenster ${_k}: RMS Elza ${_e} gegen Leon ${_l} (soll +-10 %)")
        endif()
    endforeach()
    message(STATUS "${_tag}: OK — msg 0..5 aus room1240, msg 5 ${_p5e}x wie Leon, RMS Elza ${_rms_elza} / Leon ${_rms_leon}")

elseif(TEIL STREQUAL "schwarz")
    set(_bilder 60 230 400)
    lauf(leon 900 ${_neu} RE15_NOAUDIO=1 "RE15_FRAMEDUMP=60-400/170:f_" "RE15_EXIT_AT=420#1170")
    lauf(elza 900 ${_neu} RE15_NOAUDIO=1 RE15_PSELECT_AUTO_SWITCH=1 "RE15_FRAMEDUMP=60-400/170:f_"
         "RE15_EXIT_AT=420#1031")
    zeilen("${WORKDIR}/elza/debug.log" "\\[pl\\] Spieler-Familie PL04" _pl)
    zeilen("${WORKDIR}/elza/debug.log" "\\[evt\\] F[0-9]+ room=1031 Evt_exec sub=15 " _e15)
    zeilen("${WORKDIR}/elza/debug.log" "Cut_chg\\(13\\)" _c13)
    zeilen("${WORKDIR}/elza/debug.log" "\\[kartenitems\\] ROOM1031: Karte Blatt 2" _karte)
    zeilen("${WORKDIR}/leon/debug.log" "\\[evt\\] F[0-9]+ room=1170 Evt_exec sub=11 " _e11)
    if(_pl LESS 1 OR NOT _e15 EQUAL 1 OR NOT _c13 EQUAL 1 OR NOT _karte EQUAL 1 OR NOT _e11 EQUAL 1)
        fail("Ablauf: PL04 ${_pl}, Elza sub15 ${_e15} / Cut_chg(13) ${_c13}, Lageplan in ROOM1031 ${_karte}, Leon sub11 ${_e11} (je soll 1)")
    endif()
    foreach(_f ${_bilder})
        string(LENGTH "${_f}" _len)
        math(EXPR _pad "6 - ${_len}")
        string(REPEAT "0" ${_pad} _nullen)
        set(_nr "${_nullen}${_f}")
        # Montage und Erzaehler schreiben dieselbe Bildnummer; der Erzaehler kommt zuletzt (2 Schreibvorgaenge)
        foreach(_wer leon elza)
            zeilen("${WORKDIR}/${_wer}/debug.log" "-> f_${_nr}\\.ppm" _w)
            if(NOT _w EQUAL 2)
                fail("${_wer} f_${_nr}.ppm ${_w}x geschrieben (soll 2: Montage, dann Erzaehler)")
            endif()
        endforeach()
        execute_process(COMMAND "${RE15_AUSWERT_TOOL}" bild "${WORKDIR}/leon/f_${_nr}.ppm" "${WORKDIR}/elza/f_${_nr}.ppm"
                                91 107 98 112
                        RESULT_VARIABLE _rvb OUTPUT_VARIABLE _outb)
        string(REGEX MATCH "verschieden ([0-9]+) hell_a ([0-9]+) hell_b ([0-9]+) feld_a ([0-9]+) feld_b ([0-9]+)" _m "${_outb}")
        if(NOT _rvb EQUAL 0 OR NOT _m)
            fail("Bildvergleich F${_f}: ${_outb}")
        endif()
        if(NOT CMAKE_MATCH_1 EQUAL 0 OR NOT CMAKE_MATCH_5 EQUAL 0 OR CMAKE_MATCH_3 LESS 100)
            fail("Erzaehler F${_f}: ${CMAKE_MATCH_1} Pixel Elza != Leon, Lageplan-Feld ${CMAKE_MATCH_5} hell (soll 0/0), Text ${CMAKE_MATCH_3} Pixel")
        endif()
        message(STATUS "${_tag}: F${_f} Elza = Leon (0 Pixel verschieden, Text ${CMAKE_MATCH_3} Pixel, Feld 0)")
    endforeach()
    message(STATUS "${_tag}: OK — Erzaehler-Schwarz ROOM1031 Cut 13 = ROOM1170 Cut 7, Lageplan angelegt und verdeckt")
else()
    fail("unbekannter TEIL '${TEIL}'")
endif()
file(REMOVE "${_exe}")
