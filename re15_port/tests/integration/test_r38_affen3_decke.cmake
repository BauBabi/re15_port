# =============================================================================
# Runde 38 Spur S "affen3" — der ANGESCHOSSENE kleine Affe (Typ 0x29) greift von der Decke an, gemessen an der ECHTEN exe.
#
# Nutzer (AUFTRAG.md Runde 38): "In Stage 3 die kleinen Affen koennen einen nicht treffen, es passiert nichts".
# Im Original verlaesst ein angeschossener Affe seine Nische ueber die Decke (HURT-Ausgang +0x1e3 -> Sub 9 @0x80114a1c-2c,
# Sprung an die Decke B[9] 0x80112d48, Kriechen/Jagd B[12]/B[13] mit Kasten r 800 @0x8011ec20), greift Leon von hinten
# (A[13] @0x80113a1c-a94 -> B[15] 0x801142c4 + Spieler-Haken cmd 5 0x80115d70, OHNE HP-Abzug) und beisst danach vom
# Boden (-5 @0x80111f60). Original gemessen: GDB-Spur o8 (Dossier analysis/befunde_runde38/S_affen3.md).
# Vorher (master cb782bda / Stand ohne Subs 7..15): der Affe spielte nach dem Treffer Clip 0xc am Platz und blieb in
# seiner Nische (Messung s2_schuss im Dossier).
#
# Aufbau: ROOM3040 per Debug-Sprung, Leon im Nordgang der Plattform (-8800,-2400, Band 1, Blick nach Sueden), Browning
# ausgeruestet (RE15_EQUIP=3); nach 5 s zielen + EIN Schuss, dann 2,2 s nach links drehen (Ruecken zum Affen), stehen.
# Zwei Laeufe: std (Standard-KI = RE2-Flavor) und re15 (RE15_AI_FLAVOR=re15). Geprueft im state.log nach dem Sprung:
#   - Affe Platz 1 (t=29) wird getroffen (HP < 87) und geht danach in Sub 9, 12, 13 (Decke) und 15 (Griff)
#   - im Griff spielt Leon die Opfer-Clips 1/2/3 (Opfer-Bank des Affen) und danach seine eigenen 16 (0x10) / 11 (0xb)
#   - vom Griff bis zum Sub 2 des Affen KEIN HP-Abzug (Original o8)
#   - danach mindestens 3 Bisse, jeder genau -5, im Treffer-Bild Sub 5 / Clip 0x12 / Bild 12..15
#
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DWORKDIR=<dir> -P test_r38_affen3_decke.cmake
# =============================================================================
set(_tag "r38_affen3_decke")
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "${_tag}: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "${_tag}: WORKDIR fehlt")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_wurzel "${WORKDIR}/lauf_${_lauf_id}")
file(MAKE_DIRECTORY "${_wurzel}")

get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" LAST_EXT)
file(GLOB _alte_kopien "${_exe_dir}/re15_pc_r38s_decke_*")
foreach(_k IN LISTS _alte_kopien)
    file(REMOVE "${_k}")
endforeach()
set(_exe_kopie "${_exe_dir}/re15_pc_r38s_decke_${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")
set(RE15_PC_EXE "${_exe_kopie}")

function(r38s_decke _lauf _flavor)
    set(_dir "${_wurzel}/${_lauf}")
    file(MAKE_DIRECTORY "${_dir}")
    set(WORKDIR "${_dir}")
    set(_st RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2)
    if(NOT _flavor STREQUAL "std")
        list(APPEND _st "RE15_AI_FLAVOR=${_flavor}")
    else()
        unset(ENV{RE15_AI_FLAVOR})
    endif()
    set(_env RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_SOFTWARE_RENDER=1 RE15_WINDOW_SCALE=1 ${_st}
             RE15_EQUIP=3 RE15_DEBUG_JUMP=3040@250 "RE15_PLAYER_POS=-8800,-2400,1024,1"
             RE15_INPUT_SCRIPT_START=250 "RE15_INPUT_SCRIPT=W5,M1,MA0.3,M1,L2.2,W40"
             RE15_STATE_LOG=state.log "RE15_EXIT_AT=1100#3040")
    re15_start_spiel(_rv 400 ${_env} "${RE15_PC_EXE}")
    if(NOT _rv EQUAL 0)
        message(STATUS "${_tag} [${_lauf}]: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(REMOVE "${_dir}/debug.log" "${_dir}/state.log")
        re15_start_spiel(_rv 400 ${_env} "${RE15_PC_EXE}")
    endif()
    if(NOT _rv EQUAL 0)
        message(FATAL_ERROR "${_tag} [${_lauf}]: re15_pc exit=${_rv} (erwartet 0 bis RE15_EXIT_AT), ${_dir}")
    endif()
    if(NOT EXISTS "${_dir}/state.log")
        message(FATAL_ERROR "${_tag} [${_lauf}]: kein state.log in ${_dir}")
    endif()

    file(STRINGS "${_dir}/state.log" _zl)
    set(_vorher -1)
    set(_nach 0)
    set(_getroffen 0)
    set(_subs "")
    set(_s1_alt "")
    set(_griff_f -1)
    set(_sub2_f -1)
    set(_opfer_clips "")
    set(_hp_alt "")
    set(_hp_im_griff 0)
    set(_bisse 0)
    set(_fehler "")
    foreach(_l IN LISTS _zl)
        if(NOT _l MATCHES "^F([0-9]+) .*PL\\((-?[0-9]+),(-?[0-9]+),rot=(-?[0-9]+),hp=(-?[0-9]+)\\) pst=[0-9]+ ps1=[0-9]+ ps2=[0-9]+ mo=([0-9]+) ")
            continue()
        endif()
        set(_f "${CMAKE_MATCH_1}")
        set(_hp "${CMAKE_MATCH_5}")
        set(_pmo "${CMAKE_MATCH_6}")
        if(NOT _nach AND _vorher GREATER _f)
            set(_nach 1)
            set(_hp_alt "")
        endif()
        set(_vorher ${_f})
        if(NOT _nach)
            continue()
        endif()
        if(NOT _l MATCHES "\\[1 t=29 st=([0-9]+) ss1=([0-9]+) ss2=[0-9]+ ss3=[0-9]+ g=[0-9a-f]+ mo=([0-9]+) af=([0-9]+) [^@]*@\\([^)]*\\)\\] hp=(-?[0-9]+)")
            continue()
        endif()
        set(_ast "${CMAKE_MATCH_1}")
        set(_as1 "${CMAKE_MATCH_2}")
        set(_amo "${CMAKE_MATCH_3}")
        set(_aaf "${CMAKE_MATCH_4}")
        set(_ahp "${CMAKE_MATCH_5}")
        if(_ahp LESS 87 AND _ahp GREATER 0)
            set(_getroffen 1)
        endif()
        if(_ast EQUAL 1 AND NOT _as1 STREQUAL _s1_alt)
            list(APPEND _subs "${_as1}")
            set(_s1_alt "${_as1}")
        endif()
        if(_griff_f LESS 0 AND _ast EQUAL 1 AND _as1 EQUAL 15)
            set(_griff_f ${_f})
        endif()
        if(_griff_f GREATER -1 AND _sub2_f LESS 0)
            list(FIND _opfer_clips "${_pmo}" _gef)
            if(_gef LESS 0)
                list(APPEND _opfer_clips "${_pmo}")
            endif()
            if(_ast EQUAL 1 AND _as1 EQUAL 2)
                set(_sub2_f ${_f})
            endif()
        endif()
        if(NOT _hp_alt STREQUAL "" AND _hp LESS _hp_alt)
            math(EXPR _d "${_hp_alt} - ${_hp}")
            if(_griff_f GREATER -1 AND _sub2_f LESS 0)
                math(EXPR _hp_im_griff "${_hp_im_griff} + 1")
            elseif(_sub2_f GREATER -1)
                if(NOT _d EQUAL 5 OR NOT _as1 EQUAL 5 OR NOT _amo EQUAL 18 OR _aaf LESS 12 OR _aaf GREATER 15)
                    string(APPEND _fehler " F${_f}:dHP=${_d},ss1=${_as1},mo=${_amo},af=${_aaf}")
                else()
                    math(EXPR _bisse "${_bisse} + 1")
                endif()
            endif()
        endif()
        set(_hp_alt ${_hp})
    endforeach()
    message(STATUS "${_tag} [${_lauf}]: getroffen=${_getroffen}, Subs ${_subs}; Griff F${_griff_f}, Sub 2 F${_sub2_f}; "
                   "Leon-Clips im Griff ${_opfer_clips}; HP-Abzuege im Griff ${_hp_im_griff}; Bisse danach ${_bisse}")
    if(NOT _getroffen)
        message(FATAL_ERROR "${_tag} [${_lauf}]: der Schuss hat Affe 1 nicht getroffen")
    endif()
    foreach(_s 9 12 13 15)
        list(FIND _subs "${_s}" _gef)
        if(_gef LESS 0)
            message(FATAL_ERROR "${_tag} [${_lauf}]: Sub ${_s} nie erreicht (Folge ${_subs})")
        endif()
    endforeach()
    foreach(_c 1 2 3 16 11)
        list(FIND _opfer_clips "${_c}" _gef)
        if(_gef LESS 0)
            message(FATAL_ERROR "${_tag} [${_lauf}]: Leon-Clip ${_c} fehlt im Griff (gesehen ${_opfer_clips})")
        endif()
    endforeach()
    if(NOT _hp_im_griff EQUAL 0)
        message(FATAL_ERROR "${_tag} [${_lauf}]: ${_hp_im_griff} HP-Abzuege im Griff (Original o8: keiner)")
    endif()
    if(_bisse LESS 3)
        message(FATAL_ERROR "${_tag} [${_lauf}]: nur ${_bisse} Bisse nach dem Griff (Soll >= 3, je -5)")
    endif()
    if(NOT _fehler STREQUAL "")
        message(FATAL_ERROR "${_tag} [${_lauf}]: Abweichungen:${_fehler}")
    endif()
endfunction()

r38s_decke(std std)
r38s_decke(re15 re15)
file(REMOVE "${_exe_kopie}")
message(STATUS "${_tag}: OK (Standard-KI und RE1.5-KI: Decke -> Griff ohne HP -> Bisse -5)")
