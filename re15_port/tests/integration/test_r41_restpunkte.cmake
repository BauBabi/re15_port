# =============================================================================
# Runde 41 Spur Q "restpunkte" - die echte exe (Dossier analysis/befunde_runde41/Q_restpunkte.md).
#
# TEIL=gator|gator_elza  Punkt 4 (Abnahme P H3, Form RE2 ROOM40A0 @0x0054 `21 04 33 00` vor Sce_em_set @0x00A0, sub02 @0x00AE; Zeitpunkt = RE2-Tot-Bit (5,0x1E)
#     @0x80102660, im Port (9,111)):
#     Lauf 1: natuerlicher Kampf bis zum R1-Tod (Rezept integration_r41_alligator2_schluessel), Tuer Slot 0 (RE15_FIRE_AOT, Bild 500 = nach der Schluessel-Einstellung),
#             in 2080 Spielstand (RE15_SAVE_TEST_AGAIN=640, liegt hinter dem Ende der Szene dort), Aktionstaste an der Leiter zurueck nach 2090: 510 Bilder ohne Alligator,
#             Schluessel weiter da, keine Kampfmusik.
#     Lauf 2: Titel -> LOAD GAME in 2080, Leiter: kein Alligator, Schluessel auf der Ersatzlage (Todeslage lebt nur im RAM).
#     Lauf 3: dasselbe, zu Fuss zum Schluessel (Werkzeug test_r41_alligator2 wegplan), Aktionstaste: Water Key im Inventar.
#     Lauf 4: Schluessel genommen (Bits 110/111/112): kein Alligator, keine Aufnahme-Zone.
#     Die Eingabe laeuft je Raum neu (RE15_INPUT_SCRIPT_BASIS=spiel): deshalb stehen Schuesse und Leiter-Eingabe in einem Skript, EXIT_AT 510 liegt vor der Leiter-Eingabe
#     der 2090-Abschnitte und hinter dem Abschnitt mit dem Tod (Tuer F500).
# TEIL=original|original_elza  Punkt 5: RE15_GATOR_ORIGINAL zeigt den ausgelieferten Raum: beide Spinnen (ROOM2090 @0x00AB0/@0x00AC4), kein "verworfen", der RE1.5-Alligator
#     (CDEMD0.EMS Block 25: 15 Meshes, 15 Bones, 43 Clips), keine Zeile der Szene.
#
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DRE15_WEG_TOOL=<test_r41_alligator2> -DWORKDIR=<dir> -DTEIL=<teil> -P test_r41_restpunkte.cmake
# =============================================================================
cmake_minimum_required(VERSION 3.21)
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "r41_restpunkte: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "r41_restpunkte: WORKDIR fehlt")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_dir "${WORKDIR}/lauf_${_lauf_id}")
file(MAKE_DIRECTORY "${_dir}")
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
set(_exe_kopie "${_exe_dir}/re15_pc_r41q_${_lauf_id}.exe")
if(NOT WIN32)
    set(_exe_kopie "${_exe_dir}/re15_pc_r41q_${_lauf_id}")
endif()
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")

function(r41q_fehler _text)
    file(REMOVE "${_exe_kopie}")
    message(FATAL_ERROR "r41_restpunkte: Lauf ${TEIL} - ${_text} (${_dir})")
endfunction()

foreach(_v RE15_GB_TEST RE15_GATOR_KANISTER RE15_KEIN_GATOR RE15_K2080_WURF_GIER RE15_K2080_GATOR_HP RE15_SET_FLAG RE15_FIRE_AOT RE15_GATOR_ORIGINAL)
    unset(ENV{${_v}})
endforeach()

if(TEIL MATCHES "elza$")
    set(_r2080 2081)
    set(_r2090 2091)
    set(_wahl RE15_TITLE_CONFIRM_MS=1500 RE15_PSELECT_AUTO=1 RE15_PSELECT_AUTO_SWITCH=1)
    set(_fam PL04)
else()
    set(_r2080 2080)
    set(_r2090 2090)
    set(_wahl RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2)
    set(_fam PL00)
endif()

# state.log in Raum-Abschnitte teilen (der Bildzaehler beginnt je Raum neu): _abschnitte = Zahl, ${_ab_<i>_bilder}, ${_ab_<i>_t23}
function(r41q_abschnitte _log)
    file(STRINGS "${_log}" _alle REGEX "^F[0-9]+ ")
    set(_i 0)
    set(_vor -1)
    set(_b 0)
    set(_t 0)
    foreach(_z IN LISTS _alle)
        string(REGEX MATCH "^F([0-9]+) " _m "${_z}")
        set(_f "${CMAKE_MATCH_1}")
        if(_f LESS _vor)
            set(_ab_${_i}_bilder ${_b} PARENT_SCOPE)
            set(_ab_${_i}_t23 ${_t} PARENT_SCOPE)
            math(EXPR _i "${_i} + 1")
            set(_b 0)
            set(_t 0)
        endif()
        set(_vor ${_f})
        math(EXPR _b "${_b} + 1")
        if(_z MATCHES " t=23 ")
            math(EXPR _t "${_t} + 1")
        endif()
    endforeach()
    set(_ab_${_i}_bilder ${_b} PARENT_SCOPE)
    set(_ab_${_i}_t23 ${_t} PARENT_SCOPE)
    set(_abschnitt_letzter ${_i} PARENT_SCOPE)
endfunction()

if(TEIL MATCHES "^gator")
    if(NOT RE15_WEG_TOOL OR NOT EXISTS "${RE15_WEG_TOOL}")
        r41q_fehler("RE15_WEG_TOOL (test_r41_alligator2) fehlt: '${RE15_WEG_TOOL}'")
    endif()
    set(_b "M0.6,MA0.1,M0.3,MA0.1,W3.0")
    set(_skript "W6.0,${_b},${_b},${_b},W4,R0.7,W0.3,A0.4,W1,A0.4,W1,A0.4,W20")
    set(WORKDIR "${_dir}/lauf1")
    file(MAKE_DIRECTORY "${WORKDIR}")
    re15_start_spiel(_rv 400
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1 SDL_ASSERT=always_ignore ${_wahl}
        RE15_DEBUG_JUMP=${_r2090}@250 "RE15_SET_FLAG=9:110,3:245" "RE15_GIVE=3:60" RE15_EQUIP=3 RE15_R39_MESS_SPIELER_HP=100 RE15_K2080_GATOR_HP=24990
        RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=1 RE15_STATE_LOG=state.log "RE15_PLAYER_POS=-6000,-17500,3072" "RE15_INPUT_SCRIPT=${_skript}"
        "RE15_FIRE_AOT=0@500#${_r2090}" RE15_CARD_AUTO=1 RE15_CARD_SLOT=0 RE15_SAVE_TEST_AGAIN=640 "RE15_EXIT_AT=510#${_r2090}" "${_exe_kopie}")
    if(NOT _rv EQUAL 0)
        r41q_fehler("Lauf 1 exe exit=${_rv} (erwartet 0 bis RE15_EXIT_AT)")
    endif()
    file(STRINGS "${WORKDIR}/debug.log" _famz REGEX "\\[pl\\] Spieler-Familie ${_fam} ")
    if(NOT _famz)
        r41q_fehler("Spielfigur nicht ${_fam}")
    endif()
    file(STRINGS "${WORKDIR}/gator_boss.log" _r1 REGEX "RE2 R1 ende \\(Leiche\\)")
    if(NOT _r1)
        r41q_fehler("kein R1-Tod")
    endif()
    file(READ "${WORKDIR}/debug.log" _log)
    string(REGEX MATCHALL "Alligator \\(0x23\\) in Wasserzone gesetzt" _sp "${_log}")
    list(LENGTH _sp _n_sp)
    if(NOT _n_sp EQUAL 1)
        r41q_fehler("Alligator ${_n_sp} x gesetzt statt 1")
    endif()
    string(FIND "${_log}" "[fire-aot] slot=0" _p_tuer)
    string(FIND "${_log}" "[save] saved (room ${_r2080})" _p_save)
    string(FIND "${_log}" "loaded room${_r2090}.rdt" _p_letzt REVERSE)
    string(FIND "${_log}" "bei der Leiche (" _p_key)
    if(_p_tuer LESS 0 OR _p_save LESS 0 OR _p_key LESS 0 OR NOT _p_key LESS _p_tuer OR NOT _p_tuer LESS _p_save OR NOT _p_save LESS _p_letzt)
        r41q_fehler("Folge Schluessel ${_p_key} -> Tuer ${_p_tuer} -> Spielstand ${_p_save} -> 2090 ${_p_letzt} stimmt nicht")
    endif()
    string(SUBSTRING "${_log}" ${_p_letzt} -1 _rest)
    if(NOT _rest MATCHES "Water Key \\(Item 0x34")
        r41q_fehler("nach der Rueckkehr liegt der Schluessel nicht")
    endif()
    if(_rest MATCHES "Folge B ROOM[0-9A-F]+ F[0-9]+ wert=1")
        r41q_fehler("Kampfmusik nach der Rueckkehr")
    endif()
    if(NOT _rest MATCHES "EXIT_AT: Bild 510 in Raum")
        r41q_fehler("Lauf endete nicht in 2090")
    endif()
    r41q_abschnitte("${WORKDIR}/state.log")
    math(EXPR _tod "${_abschnitt_letzter} - 2")
    if(_abschnitt_letzter LESS 5 OR NOT _ab_${_tod}_t23 GREATER 400)
        r41q_fehler("Abschnitt mit dem Tod: ${_ab_${_tod}_t23} Bilder mit Alligator (letzter Abschnitt ${_abschnitt_letzter})")
    endif()
    if(NOT _ab_${_abschnitt_letzter}_bilder GREATER 500 OR NOT _ab_${_abschnitt_letzter}_t23 EQUAL 0)
        r41q_fehler("nach dem Tod ${_ab_${_abschnitt_letzter}_t23} Bilder mit Alligator in ${_ab_${_abschnitt_letzter}_bilder}")
    endif()
    message(STATUS "r41_restpunkte: Lauf ${TEIL} 1: R1-Tod, Tuer, Spielstand, Leiter: ${_ab_${_abschnitt_letzter}_bilder} Bilder ohne Alligator, Schluessel da")

    # Lauf 2: Spielstand laden, Leiter
    set(_karte "${WORKDIR}/re15_card.mcr")
    if(NOT EXISTS "${_karte}")
        r41q_fehler("keine Karte aus Lauf 1")
    endif()
    set(WORKDIR "${_dir}/lauf2")
    file(MAKE_DIRECTORY "${WORKDIR}")
    file(COPY_FILE "${_karte}" "${WORKDIR}/re15_card.mcr")
    re15_start_spiel(_rv 200
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1 SDL_ASSERT=always_ignore
        RE15_CONTINUE_TEST=1 RE15_CARD_AUTO=1 RE15_CARD_SLOT=0 RE15_STATE_LOG=state.log
        "RE15_FIRE_AOT=1@40#${_r2080}" "RE15_EXIT_AT=200#${_r2090}" "${_exe_kopie}")
    if(NOT _rv EQUAL 0)
        r41q_fehler("Lauf 2 exe exit=${_rv}")
    endif()
    file(READ "${WORKDIR}/debug.log" _log)
    if(NOT _log MATCHES "CONTINUE: resumed in room ${_r2080}")
        r41q_fehler("Lauf 2 nicht in ${_r2080} geladen")
    endif()
    if(_log MATCHES "Alligator \\(0x23\\) in Wasserzone gesetzt")
        r41q_fehler("Lauf 2: Alligator nach dem Laden wieder da")
    endif()
    string(REGEX MATCH "Water Key \\(Item 0x34[^\n]* bei der Leiche \\((-?[0-9]+),(-?[0-9]+),(-?[0-9]+)\\)" _m "${_log}")
    if(NOT _m)
        r41q_fehler("Lauf 2: kein Schluessel nach dem Laden")
    endif()
    set(_kx ${CMAKE_MATCH_1})
    set(_ky ${CMAKE_MATCH_2})
    set(_kz ${CMAKE_MATCH_3})
    r41q_abschnitte("${WORKDIR}/state.log")
    if(NOT _ab_${_abschnitt_letzter}_bilder GREATER 190 OR NOT _ab_${_abschnitt_letzter}_t23 EQUAL 0)
        r41q_fehler("Lauf 2: ${_ab_${_abschnitt_letzter}_t23} Bilder mit Alligator in ${_ab_${_abschnitt_letzter}_bilder}")
    endif()
    file(STRINGS "${WORKDIR}/state.log" _lz REGEX "^F[0-9]+ ")
    list(GET _lz -1 _l)
    string(REGEX MATCH "PL\\((-?[0-9]+),(-?[0-9]+),rot=(-?[0-9]+)" _m "${_l}")
    set(_px ${CMAKE_MATCH_1})
    set(_pz ${CMAKE_MATCH_2})
    set(_prot ${CMAKE_MATCH_3})
    message(STATUS "r41_restpunkte: Lauf ${TEIL} 2: CONTINUE, Leiter, kein Alligator; Schluessel (${_kx},${_kz}), Figur (${_px},${_pz})")

    # Lauf 3: zu Fuss zum Schluessel. wegplan liest debug.log + state.log eines Laufs (Folge O = Ende der Einstellung): hier fertig geschrieben, der Weg beginnt an der Lage aus Lauf 2.
    set(_plan "${_dir}/plan")
    file(MAKE_DIRECTORY "${_plan}")
    file(WRITE "${_plan}/debug.log" "[gatorszene] ROOM${_r2090}: Water Key (Item 0x34) bei der Leiche (${_kx},${_ky},${_kz})\n[gatorszene] Folge O ROOM${_r2090} F0 wert=0/0 zustand=0\n")
    file(WRITE "${_plan}/state.log" "F61 pad=0000 PL(${_px},${_pz},rot=${_prot},hp=100)\n")
    execute_process(COMMAND "${RE15_WEG_TOOL}" wegplan "${_plan}" ${_r2090} 2.0 123 W0 "${_dir}/skript.txt"
                    WORKING_DIRECTORY "${_plan}" RESULT_VARIABLE _wr OUTPUT_VARIABLE _wo ERROR_VARIABLE _we)
    string(REGEX MATCHALL "wegplan: [^\n]*" _wz "${_wo}")
    if(NOT _wr EQUAL 0)
        r41q_fehler("wegplan: ${_wz}")
    endif()
    file(READ "${_dir}/skript.txt" _skript)
    string(STRIP "${_skript}" _skript)
    file(READ "${_dir}/skript.txt.ende" _ende)
    string(STRIP "${_ende}" _ende)
    set(WORKDIR "${_dir}/lauf3")
    file(MAKE_DIRECTORY "${WORKDIR}")
    file(COPY_FILE "${_karte}" "${WORKDIR}/re15_card.mcr")
    re15_start_spiel(_rv 300
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1 SDL_ASSERT=always_ignore
        RE15_CONTINUE_TEST=1 RE15_CARD_AUTO=1 RE15_CARD_SLOT=0 RE15_STATE_LOG=state.log
        RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=1 "RE15_INPUT_SCRIPT=${_skript}" RE15_INV_LOG=1
        "RE15_FIRE_AOT=1@40#${_r2080}" "RE15_EXIT_AT=${_ende}#${_r2090}" "${_exe_kopie}")
    if(NOT _rv EQUAL 0)
        r41q_fehler("Lauf 3 exe exit=${_rv}")
    endif()
    file(STRINGS "${WORKDIR}/debug.log" _inv REGEX "inv-r39. F[0-9]+ R${_r2090} .*inv=[^ ]*34:1")
    if(NOT _inv)
        r41q_fehler("Lauf 3: Water Key nicht im Inventar (${_wz})")
    endif()
    list(GET _inv 0 _inv0)
    message(STATUS "r41_restpunkte: Lauf ${TEIL} 3: Water Key aufgehoben: ${_inv0}")

    # Lauf 4: Schluessel genommen
    set(WORKDIR "${_dir}/lauf4")
    file(MAKE_DIRECTORY "${WORKDIR}")
    re15_start_spiel(_rv 200
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1 SDL_ASSERT=always_ignore ${_wahl}
        RE15_DEBUG_JUMP=${_r2090}@250 "RE15_SET_FLAG=9:110,9:111,9:112,3:245" RE15_STATE_LOG=state.log "RE15_EXIT_AT=200#${_r2090}" "${_exe_kopie}")
    file(REMOVE "${_exe_kopie}")
    if(NOT _rv EQUAL 0)
        r41q_fehler("Lauf 4 exe exit=${_rv}")
    endif()
    file(READ "${WORKDIR}/debug.log" _log)
    if(_log MATCHES "Alligator \\(0x23\\) in Wasserzone gesetzt" OR _log MATCHES "Water Key \\(Item 0x34")
        r41q_fehler("Lauf 4: Alligator oder Schluessel da, obwohl genommen")
    endif()
    message(STATUS "r41_restpunkte: Lauf ${TEIL}: toter Alligator bleibt tot (Raum verlassen, Spielstand, Aufheben), Water Key erreichbar")
    return()
endif()

if(TEIL MATCHES "^original")
    set(WORKDIR "${_dir}")
    re15_start_spiel(_rv 200
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1 SDL_ASSERT=always_ignore ${_wahl}
        RE15_GATOR_ORIGINAL=1 RE15_SPAWN_DIAG=1 RE15_R39_MESS_SPIELER_HP=100 RE15_DEBUG_JUMP=${_r2090}@250 "RE15_SET_FLAG=3:245" RE15_STATE_LOG=state.log
        "RE15_PLAYER_POS=-8200,-25550,0" "RE15_EXIT_AT=300#${_r2090}" "${_exe_kopie}")
    file(REMOVE "${_exe_kopie}")
    if(NOT _rv EQUAL 0)
        r41q_fehler("exe exit=${_rv}")
    endif()
    file(READ "${_dir}/debug.log" _log)
    if(NOT _log MATCHES "\\[pl\\] Spieler-Familie ${_fam} ")
        r41q_fehler("Spielfigur nicht ${_fam}")
    endif()
    if(_log MATCHES "verworfen")
        r41q_fehler("Spinnen-Filter laeuft unter dem Schalter")
    endif()
    if(_log MATCHES "\\[gatorszene\\]")
        r41q_fehler("Zeile der Szene unter dem Schalter")
    endif()
    foreach(_s "pos=\\(-100,0,-8296\\)" "pos=\\(-2300,0,-23896\\)")
        if(NOT _log MATCHES "Sce_em_set type=0x25 [^\n]*${_s}")
            r41q_fehler("kein Spawn ${_s}")
        endif()
    endforeach()
    if(NOT _log MATCHES "EM23 loaded: 15 meshes, 15 bones, 43 clips")
        r41q_fehler("nicht der RE1.5-Alligator (CDEMD0.EMS Block 25)")
    endif()
    file(STRINGS "${_dir}/state.log" _lz REGEX "^F[0-9]+ ")
    list(GET _lz -1 _l)
    string(REGEX MATCHALL " t=25 " _s25 "${_l}")
    string(REGEX MATCHALL " t=23 " _s23 "${_l}")
    list(LENGTH _s25 _n25)
    list(LENGTH _s23 _n23)
    if(NOT _n25 EQUAL 2 OR NOT _n23 EQUAL 1)
        r41q_fehler("letztes Bild: ${_n25} Spinnen, ${_n23} Alligator statt 2 und 1: ${_l}")
    endif()
    message(STATUS "r41_restpunkte: Lauf ${TEIL}: RE15_GATOR_ORIGINAL: 2 Spinnen, RE1.5-Alligator, keine Szene")
    return()
endif()

file(REMOVE "${_exe_kopie}")
message(FATAL_ERROR "r41_restpunkte: unbekannter TEIL '${TEIL}'")
