# test_r41_stage3szenen_a.cmake — Runde 41 Spur J "stage3szenen_a": die zwei Nutzer-Punkte an der ECHTEN exe.
# Dossier analysis/befunde_runde41/J_stage3szenen_a.md, Belege include/re15_wclip_r41.h, re15_fussanker_r41.h,
# re15_superobj_r41.h. Aufruf:
#   cmake -DRE15_PC_EXE=<exe> -DRE15_KARTE_ELZA=<probe_r36_elza_karte> -DWORKDIR=<dir> -DTEIL=<3060|3061>
#         -P test_r41_stage3szenen_a.cmake
#
#   3060  Punkt 1 "Animation von Marvin ... am Ende seiner Abschnitte ... ROOM 3060": Leon -> ROOM3020, Szene sub02
#         (RE15_FORCE_EVENT 2 = Aot slot 3 @0x00BE2 -> Evt_exec sub 2) macht ihn zu Marvin (Save 0x10 = 0x0D @0x00D7A),
#         Tuer -> ROOM30C0; Sprung ROOM3040, dort die TUER Slot 0 (@0x0127E, 4:196 gesetzt) -> ROOM3060 = der Weg des
#         Spiels. Erwartet: Marvin-Modell PL0D, Tuer-Ankunft (2063,-17192), sub03 Plc_motion(2,6) @0x010BE spielt
#         W-Bank-Clip 6 (PL00W01, 10 Bilder) und haelt Bild 9 (@0x80050fec) — nie PL00-Clip 6 (50 Bilder = Knien).
#   3061  Punkt 2 (Elza): Spielstand ROOM3061 (Elza (-3500,-25500) Blick 1024 = nach -z, Bits 4:244 + 3:160) + CONTINUE;
#         nach Sherrys/Johns Einlauf (sub09/sub10) geht Elza nach -z bis an die Wand ins Ausloese-Rechteck von Slot 1
#         (main00 @0x00E96 (-4500,-27300) 2600x1300) und drueckt QUADRAT (Vorwaerts-620-Punkt im Rechteck, Flags 0x31) ->
#         sub00 @0x00F3A Aot_reset sce 3 -> sub02; Quadrat im 1,5-s-Takt schaltet die Nachrichten weiter.
#         Erwartet: Gitter an Sherrys Teil 14 (Super_set @0x0127E),
#         Loslass-Lage (Super_reset @0x0129E) ~ Original (-18756,-266,-26788); Anker-Takte 22/22/11 (Clip 1) und 2 x 26/24
#         (Clip 2) = Plc_flg-Folge von sub04; Sherry-Lagen gegen die Original-Reihe (o3061_s2/s3); Sherry am Ende im
#         Schacht; Elza Plc_motion(2,6) @0x011DE = W-Bank-Clip 6 (10 Bilder) gehalten; Wechsel nach ROOM30C1 als PL0F.
#
# Parallel-/Linux-fest: exe-Kopie mit eigenem Praefix je TEIL, eigener Laufordner je Lauf, Umgebung nur ueber
# re15_start_spiel (spiel_lauf.cmake), keine .exe-/Backslash-Pfade.
cmake_minimum_required(VERSION 3.16)
foreach(_v RE15_PC_EXE WORKDIR TEIL)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "r41_stage3szenen_a: ${_v} fehlt")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

set(_tag "r41_stage3szenen_a[${TEIL}]")
string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_basisdir "${WORKDIR}_${TEIL}_${_lauf_id}")
file(MAKE_DIRECTORY "${_basisdir}")
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" EXT)
set(_exe "${_exe_dir}/re15_pc_r41j_${TEIL}_${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

set(_fehler "")
macro(fail _text)
    list(APPEND _fehler "${_text}")
    message(STATUS "FAIL ${_tag}: ${_text}")
endmacro()
macro(ok _text)
    message(STATUS "ok   ${_tag}: ${_text}")
endmacro()
# Abbruch nach dem Kopieren der exe: Kopie zuerst entfernen (kein 7-MB-Rest im Bau-Baum).
function(abbruch _text)
    file(REMOVE "${_exe}")
    message(FATAL_ERROR "${_text}")
endfunction()

# Quadrat alle 1,5 s (Nachrichten weiterschalten; in 3061 zugleich die Aktionstaste am AOT).
set(_druck "")
foreach(_i RANGE 1 70)
    string(APPEND _druck "A0.1,W1.4,")
endforeach()

# Spieler-Zeilen des LETZTEN Raumblocks im RE15_ANIM_TRACE (Bildnummer faellt beim Raumwechsel auf 0):
# "<bild> <aktor> <typ> <motion> <clip> <fc> <cur> <slot> ..." -> Liste "motion:clip:fc:slot".
function(letzter_block _datei _aus)
    file(STRINGS "${_datei}" _zeilen)
    set(_block "")
    set(_prev -1)
    foreach(_z IN LISTS _zeilen)
        if(_z MATCHES "^([0-9]+) 0 [0-9]+ ([0-9]+) ([0-9]+) ([0-9]+) [0-9]+ ([0-9]+) ")
            if(CMAKE_MATCH_1 LESS _prev)
                set(_block "")
            endif()
            set(_prev "${CMAKE_MATCH_1}")
            list(APPEND _block "${CMAKE_MATCH_2}:${CMAKE_MATCH_3}:${CMAKE_MATCH_4}:${CMAKE_MATCH_5}")
        endif()
    endforeach()
    set(${_aus} "${_block}" PARENT_SCOPE)
endfunction()

# W-Clip-6-Pruefung auf einem Block: alle Zeilen mit motion 6 muessen Clip 6 / 10 Bilder sein, Bild 9 >= _min mal.
function(pruef_wclip6 _block _min _ergebnis _text)
    set(_n6 0)
    set(_n9 0)
    set(_nfalsch 0)
    set(_bsp "")
    foreach(_e IN LISTS _block)
        string(REPLACE ":" ";" _f "${_e}")
        list(GET _f 0 _mo)
        list(GET _f 1 _cl)
        list(GET _f 2 _fc)
        list(GET _f 3 _sl)
        if(_mo EQUAL 6)
            math(EXPR _n6 "${_n6} + 1")
            if(NOT _cl EQUAL 6 OR NOT _fc EQUAL 10)
                math(EXPR _nfalsch "${_nfalsch} + 1")
                if(_bsp STREQUAL "")
                    set(_bsp "${_e}")
                endif()
            elseif(_sl EQUAL 9)
                math(EXPR _n9 "${_n9} + 1")
            endif()
        endif()
    endforeach()
    if(_n6 GREATER 0 AND _nfalsch EQUAL 0 AND _n9 GREATER_EQUAL ${_min})
        set(${_ergebnis} 1 PARENT_SCOPE)
    else()
        set(${_ergebnis} 0 PARENT_SCOPE)
    endif()
    set(${_text} "${_n6} Bilder Motion 6, davon ${_nfalsch} nicht Clip 6/10 Bilder (z.B. '${_bsp}'), ${_n9} x Bild 9 gehalten (Soll >= ${_min})" PARENT_SCOPE)
endfunction()

if(TEIL STREQUAL "3060")
    set(WORKDIR "${_basisdir}/lauf")
    file(MAKE_DIRECTORY "${WORKDIR}")
    re15_start_spiel(_rv 900
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1
        "RE15_SET_FLAG=4:199,4:196" RE15_GOTO_ROOM=3020 "RE15_FORCE_EVENT=2@150"
        RE15_DEBUG_JUMP=3040@1150 "RE15_FIRE_AOT=0@1200#3040"
        "RE15_INPUT_SCRIPT=${_druck}" "RE15_ANIM_TRACE=anim.txt" "RE15_EXIT_AT=104#3060"
        "${_exe}")
    if(NOT EXISTS "${WORKDIR}/debug.log")
        abbruch("${_tag}: kein debug.log (exit=${_rv}, ${WORKDIR})")
    endif()
    file(READ "${WORKDIR}/debug.log" _d)
    string(FIND "${_d}" "PC loaded room3060.rdt" _p60)
    string(FIND "${_d}" "Spielermodell -> PLD/PL0D.PLD" _pmarvin)
    if(_p60 LESS 0)
        fail("ROOM3060 nicht erreicht (exit=${_rv})")
    else()
        if(_pmarvin GREATER_EQUAL 0 AND _pmarvin LESS _p60)
            ok("Marvin-Modell PL0D vor ROOM3060 (Szene ROOM3020 sub02, Save 0x10 = 0x0D @0x00D7A)")
        else()
            fail("kein Wechsel auf PL0D vor ROOM3060")
        endif()
        if(_d MATCHES "DOOR FIRE slot=0 [^\n]*spawn=\\(2063,0,-17192\\)")
            ok("Tuer ROOM3040 Slot 0 -> ROOM3060 Ankunft (2063,0,-17192)")
        else()
            fail("keine Tuer ROOM3040 Slot 0 mit Ankunft (2063,0,-17192)")
        endif()
        string(SUBSTRING "${_d}" ${_p60} -1 _d60)
        if(_d60 MATCHES "\\[wclip41\\] ROOM3060 F[0-9]+ Spieler Plc_motion\\(2,6\\) -> W-Bank-Clip 6 [^\n]*Waffe 1, 10 Bilder")
            ok("ROOM3060 Plc_motion(2,6) -> W-Bank-Clip 6 (Waffe 1, 10 Bilder)")
        else()
            fail("keine [wclip41]-Zeile ROOM3060 W-Bank-Clip 6 / 10 Bilder")
        endif()
        letzter_block("${WORKDIR}/anim.txt" _blk)
        pruef_wclip6("${_blk}" 25 _okw _txt)
        if(_okw)
            ok("RE15_ANIM_TRACE ROOM3060 Marvin: ${_txt}")
        else()
            fail("RE15_ANIM_TRACE ROOM3060 Marvin: ${_txt}")
        endif()
    endif()
elseif(TEIL STREQUAL "3061")
    if(NOT DEFINED RE15_KARTE_ELZA OR NOT EXISTS "${RE15_KARTE_ELZA}")
        abbruch("${_tag}: RE15_KARTE_ELZA fehlt")
    endif()
    set(WORKDIR "${_basisdir}/lauf")
    file(MAKE_DIRECTORY "${WORKDIR}")
    execute_process(COMMAND "${RE15_KARTE_ELZA}" "re15_card.mcr" 3061 -3500 -25500 1024 4:244 3:160
                    WORKING_DIRECTORY "${WORKDIR}" TIMEOUT 60 RESULT_VARIABLE _rvk OUTPUT_VARIABLE _outk)
    if(NOT _rvk EQUAL 0 OR NOT EXISTS "${WORKDIR}/re15_card.mcr")
        abbruch("${_tag}: Kartenwerkzeug exit=${_rvk}\n${_outk}")
    endif()
    # ab Spielbild 420 (Einlauf vorbei): 0,5 s vor (nach -z an die Wand), dann Quadrat alle 1,5 s
    re15_start_spiel(_rv 900
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1
        RE15_CONTINUE_TEST=1 RE15_CARD_AUTO=1 RE15_CARD_SLOT=0
        RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=420 "RE15_INPUT_SCRIPT=U0.5,W0.5,${_druck}"
        RE15_FUSSANKER_LOG=1 "RE15_STATE_LOG=state.txt" "RE15_ANIM_TRACE=anim.txt" "RE15_EXIT_AT=1#30C1"
        "${_exe}")
    if(NOT EXISTS "${WORKDIR}/debug.log")
        abbruch("${_tag}: kein debug.log (exit=${_rv}, ${WORKDIR})")
    endif()
    file(READ "${WORKDIR}/debug.log" _d)
    if(_d MATCHES "CONTINUE: resumed in room 3061")
        ok("Spielstand ROOM3061 geladen (CONTINUE)")
    else()
        fail("CONTINUE nicht in ROOM3061 (exit=${_rv})")
    endif()
    if(_d MATCHES "\\[scd F[0-9]+\\] Cut_chg\\(6\\)")
        ok("Quadrat am Ausloese-AOT: sub02 laeuft (Cut_chg 6 @0x01062)")
    else()
        fail("sub02 nicht gestartet (kein Cut_chg(6)) — Quadrat am AOT Slot 1 ohne Wirkung")
    endif()
    # Gitter (Super_set / Super_reset)
    if(_d MATCHES "\\[superobj41\\] F[0-9]+ Super_set Objekt 0 Art 0x80 Teil-Byte 0x8E lokal \\(252,192,-153\\) Rot \\(0,1024,3072\\) -> angehaengt")
        ok("Super_set @0x0127E: Gitter an Sherrys Teil 14 (lokal (252,192,-153), Rot (0,1024,3072))")
    else()
        fail("keine Super_set-Zeile 'angehaengt' fuer Objekt 0 / Teil 0x8E")
    endif()
    if(_d MATCHES "\\[superobj41\\] F[0-9]+ Super_reset Objekt 0 Welt-Lage uebernommen -> lokal \\((-?[0-9]+),(-?[0-9]+),(-?[0-9]+)\\) Rot \\(72,3072,0\\)")
        set(_gx "${CMAKE_MATCH_1}")
        set(_gy "${CMAKE_MATCH_2}")
        set(_gz "${CMAKE_MATCH_3}")
        math(EXPR _ddx "${_gx} + 18756")
        math(EXPR _ddy "${_gy} + 266")
        math(EXPR _ddz "${_gz} + 26788")
        if(_ddx GREATER_EQUAL -30 AND _ddx LESS_EQUAL 30 AND _ddy GREATER_EQUAL -8 AND _ddy LESS_EQUAL 8
           AND _ddz GREATER_EQUAL -30 AND _ddz LESS_EQUAL 30)
            ok("Super_reset @0x0129E: Loslass-Lage (${_gx},${_gy},${_gz}) ~ Original (-18756,-266,-26788) (${_ddx},${_ddy},${_ddz})")
        else()
            fail("Super_reset: Loslass-Lage (${_gx},${_gy},${_gz}) weicht vom Original (-18756,-266,-26788) ab (${_ddx},${_ddy},${_ddz})")
        endif()
    else()
        fail("keine Super_reset-Zeile 'Welt-Lage uebernommen' mit Rot (72,3072,0)")
    endif()
    # Anker-Takte: Lauflaengen (Kette, Clip) der [fussanker41]-Zeilen
    file(STRINGS "${WORKDIR}/debug.log" _fz REGEX "^\\[fussanker41\\] ")
    set(_folge "")
    set(_akt "")
    set(_n 0)
    set(_l47 "")
    set(_l30 "")
    set(_l22 "")
    set(_n22 0)
    set(_n30 0)
    foreach(_z IN LISTS _fz)
        if(_z MATCHES "Kette ([01]) Clip ([0-9]+) Bild ([0-9]+) .* -> \\((-?[0-9]+),(-?[0-9]+)\\)$")
            set(_k "${CMAKE_MATCH_1}/${CMAKE_MATCH_2}")
            set(_bild "${CMAKE_MATCH_3}")
            set(_pos "${CMAKE_MATCH_4},${CMAKE_MATCH_5}")
            if(_k STREQUAL _akt)
                math(EXPR _n "${_n} + 1")
            else()
                if(NOT _akt STREQUAL "")
                    list(APPEND _folge "${_akt}x${_n}")
                endif()
                set(_akt "${_k}")
                set(_n 1)
            endif()
            if(CMAKE_MATCH_2 EQUAL 1 AND _bild EQUAL 46)
                set(_l47 "${_pos}")
            endif()
            if(CMAKE_MATCH_2 EQUAL 2 AND _bild EQUAL 29)
                math(EXPR _n30 "${_n30} + 1")
                if(_n30 EQUAL 1)
                    set(_l30 "${_pos}")
                endif()
            endif()
            if(CMAKE_MATCH_2 EQUAL 2 AND _bild EQUAL 21)
                math(EXPR _n22 "${_n22} + 1")
                if(_n22 EQUAL 2)
                    set(_l22 "${_pos}")
                endif()
            endif()
        endif()
    endforeach()
    if(NOT _akt STREQUAL "")
        list(APPEND _folge "${_akt}x${_n}")
    endif()
    string(REPLACE ";" " " _folge_t "${_folge}")
    if(_folge_t STREQUAL "0/1x22 1/1x22 0/1x11 1/2x26 0/2x24 1/2x26 0/2x24")
        ok("Anker-Takte (Kette/Clip x Bilder) = sub04 Plc_flg-Folge: ${_folge_t}")
    else()
        fail("Anker-Takte '${_folge_t}' (Soll 0/1x22 1/1x22 0/1x11 1/2x26 0/2x24 1/2x26 0/2x24)")
    endif()
    # Sherry-Lagen gegen die Original-Reihe o3061_s2 (gezeichnetes Bild = +0x95 - 1, FUN_8001f3bc @0x8001f618):
    # t11 +0x95 47 = Clip 1 Bild 46, t12 +0x95 30 = Clip 2 Bild 29 (Runde 1), t13 +0x95 22 = Bild 21 (Runde 2).
    # Gemessen: konstanter Rest (3,10) = Sherrys Lage VOR dem Kriechen (Port (-18857,-26256) / Original (-18860,-26266),
    # aus dem Plc_dest-Gang davor), das Kriechen selbst ist bytegleich (unit_r41_stage3szenen_a_anker).
    foreach(_paar "l47|-19054,-27044|Clip 1 Bild 46" "l30|-18792,-28234|Clip 2 Bild 29 Runde 1" "l22|-18799,-29042|Clip 2 Bild 21 Runde 2")
        string(REPLACE "|" ";" _pp "${_paar}")
        list(GET _pp 0 _var)
        list(GET _pp 1 _soll)
        list(GET _pp 2 _wo)
        set(_ist "${_${_var}}")
        if(_ist STREQUAL "")
            fail("Sherry ${_wo}: keine Anker-Zeile")
        else()
            string(REPLACE "," ";" _i "${_ist}")
            string(REPLACE "," ";" _s "${_soll}")
            list(GET _i 0 _ix)
            list(GET _i 1 _iz)
            list(GET _s 0 _sx)
            list(GET _s 1 _sz)
            math(EXPR _dx "${_ix} - (${_sx})")
            math(EXPR _dz "${_iz} - (${_sz})")
            if(_dx GREATER_EQUAL -25 AND _dx LESS_EQUAL 25 AND _dz GREATER_EQUAL -25 AND _dz LESS_EQUAL 25)
                ok("Sherry ${_wo}: Port (${_ist}) / Original (${_soll}), Abweichung (${_dx},${_dz})")
            else()
                fail("Sherry ${_wo}: Port (${_ist}) / Original (${_soll}), Abweichung (${_dx},${_dz}) > 25")
            endif()
        endif()
    endforeach()
    # Sherry im Schacht (STATE_LOG): tiefste Lage aller Zeilen mit Aktor 1 Typ 0x4b (das Gitter sitzt bei z -27045)
    file(STRINGS "${WORKDIR}/state.txt" _sz REGEX "\\[1 t=4b ")
    set(_minz 0)
    set(_minx 0)
    foreach(_zl IN LISTS _sz)
        if(_zl MATCHES "\\[1 t=4b [^@]*@\\((-?[0-9]+),(-?[0-9]+),r")
            if(CMAKE_MATCH_2 LESS _minz)
                set(_minz "${CMAKE_MATCH_2}")
                set(_minx "${CMAKE_MATCH_1}")
            endif()
        endif()
    endforeach()
    if(_minz LESS -29500)
        ok("Sherry erreicht (${_minx},${_minz}) — im Schacht hinter dem Gitter (z -27045)")
    else()
        fail("Sherry tiefste Lage (${_minx},${_minz}) — nicht im Schacht (Soll z < -29500)")
    endif()
    # Elza zieht (Plc_motion(2,6) @0x011DE)
    if(_d MATCHES "\\[wclip41\\] ROOM3061 F[0-9]+ Spieler Plc_motion\\(2,6\\) -> W-Bank-Clip 6 [^\n]*10 Bilder")
        ok("ROOM3061 Elza Plc_motion(2,6) -> W-Bank-Clip 6 (10 Bilder)")
    else()
        fail("keine [wclip41]-Zeile ROOM3061 W-Bank-Clip 6 / 10 Bilder")
    endif()
    # Der letzte Block des ANIM_TRACE ist ROOM30C1 (EXIT_AT Bild 1) -> den ROOM3061-Block davor nehmen.
    file(STRINGS "${WORKDIR}/anim.txt" _zeilen)
    set(_bloecke "")
    set(_block "")
    set(_prev -1)
    foreach(_z IN LISTS _zeilen)
        if(_z MATCHES "^([0-9]+) 0 [0-9]+ ([0-9]+) ([0-9]+) ([0-9]+) [0-9]+ ([0-9]+) ")
            if(CMAKE_MATCH_1 LESS _prev)
                set(_vorher "${_block}")
                set(_block "")
            endif()
            set(_prev "${CMAKE_MATCH_1}")
            list(APPEND _block "${CMAKE_MATCH_2}:${CMAKE_MATCH_3}:${CMAKE_MATCH_4}:${CMAKE_MATCH_5}")
        endif()
    endforeach()
    pruef_wclip6("${_vorher}" 40 _okw _txt)
    if(_okw)
        ok("RE15_ANIM_TRACE ROOM3061 Elza: ${_txt}")
    else()
        fail("RE15_ANIM_TRACE ROOM3061 Elza: ${_txt}")
    endif()
    if(_d MATCHES "PC loaded room30c1.rdt" AND _d MATCHES "Spielermodell -> PLD/PL0F.PLD")
        ok("Wechsel nach ROOM30C1 als PL0F (Save 0x10 = 0x0F @0x011F6, Aot_on 3)")
    else()
        fail("kein Wechsel nach ROOM30C1 / PL0F")
    endif()
else()
    abbruch("${_tag}: TEIL unbekannt")
endif()

file(REMOVE "${_exe}")
list(LENGTH _fehler _nf)
if(_nf GREATER 0)
    message(FATAL_ERROR "${_tag}: ${_nf} Fehler (Laufordner ${_basisdir})")
endif()
message(STATUS "${_tag}: alles ok (${_basisdir})")
