# =============================================================================
# Runde 38 Spur S "affen3" — Ereignis-Affen (Typ 0x29) in Stage 4/5: warten gesperrt und fallen nach der Freigabe von der
# Decke wie im Original (Nachbesserung 1; Abnahme 0 Mangel 1: vorher biss der freigegebene Affe aus y = -10000).
#
# Wurzel 0x80110b00 (STAGE3.BIN, wortgleich STAGE4 0x8010c1a0): Tor +0x9 & 0x20 `lbu v0,9(v1)` / `andi v0,v0,0x20` /
# `bne v0,zero,0x80110bd0` @0x80110b34-40. Sce_em_set ruft die Wurzel beim Spawn EINMAL mit geloeschtem Sperrbit
# (`andi v0,v1,0xdf` @0x8004256c, `jalr` @0x8004259c, Bit zurueck @0x80042604-08): der INIT sieht 0x61 & 0xdf = 0x41 und
# schreibt das Zustandswort 0x104 (@0x80110ea4-eb8) -> gesperrt in Zustand 4 / Unterzustand 1.
# ROOM4040 sub04 (Ausloeser Aot_set Platz 5 sce 3 @0x00E9C, Rechteck x -27899..-22159, z 2608..5608): Work_set(2,0),
# Pos_set (-25090,-10000,9230) @0x011CE, Member_set(12, 0x41) @0x011D6 -> Zustand 4/1 0x801158e8 (EIN Bild: +0x93 |= 3,
# +0x1e0 = 1, Luftkasten, +0x9 &= 0xbf, ACTIVE Sub 10 Phase 2, Clip 0xd Bild 0x14) -> Fall c1a4(0,0,-70) bis +0x1ba = 0.
#
# Original o11 (DuckStation-GDB, ROOM4040, RAM 0x8010c1a0.. == STAGE4.BIN; Dossier analysis/befunde_runde38/S_affen3.md):
#   F18..F56 gesperrt 4.1.0.0 g61 an der Parkstelle (-14040,0,19130); F58 (= erstes Bild nach der Freigabe) 1.10.2.0 g01
#   Clip 13 Bild 20 @(-25090,-10000,9230); y je Bild F58..F76: -10000 -10000 -9930 -9790 -9580 -9300 -8950 -8530 -8040
#   -7480 -6850 -6150 -5380 -4540 -3630 -2650 -1600 -480 0 (F76 Phase 3 = gelandet); F77 Phase 4 Bild 25; F92 Sub 4;
#   erster Treffer (-10, schwer) F128 vom Boden.
#
# Zwei Laeufe je KI (std = RE2-Flavor, re15), ROOM4040 per Debug-Sprung:
#   ruhe  Leon am Sprung-Spawn (-26400,17150): >= 300 Bilder gesperrt (g=61) in Zustand 4/1 an der Parkstelle
#   frei  Leon im Ausloeser (-25000,4000), Gier 0 wie o11: Freigabe -> Fallbahn Bild fuer Bild = o11, Landung R+18, Phase 4
#         R+19 (Bild 25), Sub 4 R+34; jeder HP-Abzug erst nach der Landung, Affe dabei auf y = 0
#
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DWORKDIR=<dir> -P test_r38_affen3_tor.cmake
# =============================================================================
set(_tag "r38_affen3_tor")
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "${_tag}: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "${_tag}: WORKDIR fehlt")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_wurzel "${WORKDIR}/lauf_${_lauf_id}")
file(MAKE_DIRECTORY "${_wurzel}")

get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" LAST_EXT)
file(GLOB _alte_kopien "${_exe_dir}/re15_pc_r38s_tor_*")
foreach(_k IN LISTS _alte_kopien)
    file(REMOVE "${_k}")
endforeach()
set(_exe_kopie "${_exe_dir}/re15_pc_r38s_tor_${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")
set(RE15_PC_EXE "${_exe_kopie}")

# Original o11 F58..F76: y des Affen je Bild ab dem ersten Bild nach der Freigabe
set(_o11_y -10000 -10000 -9930 -9790 -9580 -9300 -8950 -8530 -8040 -7480 -6850 -6150 -5380 -4540 -3630 -2650 -1600 -480 0)

function(r38s_tor _lauf _flavor _pos)
    set(_dir "${_wurzel}/${_lauf}")
    file(MAKE_DIRECTORY "${_dir}")
    set(WORKDIR "${_dir}")
    set(_st RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2)
    if(NOT _flavor STREQUAL "std")
        list(APPEND _st "RE15_AI_FLAVOR=${_flavor}")
    else()
        unset(ENV{RE15_AI_FLAVOR})
    endif()
    if(NOT _pos STREQUAL "")
        list(APPEND _st "RE15_PLAYER_POS=${_pos}")
    endif()
    set(_env RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_SOFTWARE_RENDER=1 RE15_WINDOW_SCALE=1 ${_st}
             RE15_DEBUG_JUMP=4040@250 RE15_STATE_LOG=state.log RE15_GEGNER_Y_LOG=gy.log "RE15_EXIT_AT=400#4040")
    re15_start_spiel(_rv 400 ${_env} "${RE15_PC_EXE}")
    if(NOT _rv EQUAL 0)
        message(STATUS "${_tag} [${_lauf}]: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(REMOVE "${_dir}/debug.log" "${_dir}/state.log" "${_dir}/gy.log")
        re15_start_spiel(_rv 400 ${_env} "${RE15_PC_EXE}")
    endif()
    if(NOT _rv EQUAL 0)
        message(FATAL_ERROR "${_tag} [${_lauf}]: re15_pc exit=${_rv} (erwartet 0 bis RE15_EXIT_AT), ${_dir}")
    endif()
    foreach(_d state.log gy.log)
        if(NOT EXISTS "${_dir}/${_d}")
            message(FATAL_ERROR "${_tag} [${_lauf}]: kein ${_d} in ${_dir}")
        endif()
    endforeach()

    # --- gy.log (RE15_GEGNER_Y_LOG): Affe je Bild in ROOM4040 ---
    file(STRINGS "${_dir}/gy.log" _gl)
    set(_bilder "")
    set(_n_gesperrt 0)
    set(_gesperrt_falsch 0)
    set(_R -1)
    foreach(_l IN LISTS _gl)
        if(NOT _l MATCHES "^F([0-9]+) R4040 ")
            continue()
        endif()
        set(_f "${CMAKE_MATCH_1}")
        # CMake setzt nur CMAKE_MATCH_0..9 (gemessen, cmake 4.3.2: 10 Gruppen -> CMAKE_MATCH_10 leer) -> hoechstens 9 Gruppen;
        # +0x7 (4. Zustandsbyte) wird deshalb nicht eingefangen.
        if(NOT _l MATCHES "t=29 st=([0-9]+)/([0-9]+)/([0-9]+)/[0-9]+ g=([0-9a-f]+) mo=([0-9]+) af=([0-9]+) @\\((-?[0-9]+),(-?[0-9]+),(-?[0-9]+)\\)")
            continue()
        endif()
        # Liste: 0 st, 1 Sub, 2 Phase, 3 g, 4 Clip, 5 Bild, 6 x, 7 y, 8 z
        set(_A_${_f} "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4};${CMAKE_MATCH_5};${CMAKE_MATCH_6};${CMAKE_MATCH_7};${CMAKE_MATCH_8};${CMAKE_MATCH_9}")
        list(APPEND _bilder ${_f})
        if(CMAKE_MATCH_4 STREQUAL "61")
            if(_R GREATER -1)
                continue()
            endif()
            math(EXPR _n_gesperrt "${_n_gesperrt} + 1")
            if(NOT CMAKE_MATCH_1 EQUAL 4 OR NOT CMAKE_MATCH_2 EQUAL 1 OR NOT CMAKE_MATCH_7 EQUAL -14040 OR NOT CMAKE_MATCH_9 EQUAL 19130)
                math(EXPR _gesperrt_falsch "${_gesperrt_falsch} + 1")
            endif()
        elseif(_R LESS 0)
            set(_R ${_f})
        endif()
    endforeach()
    message(STATUS "${_tag} [${_lauf}]: gesperrt (g=61) ${_n_gesperrt} Bilder, davon nicht 4/1 an (-14040,19130): ${_gesperrt_falsch}; Freigabe F${_R}")
    if(_gesperrt_falsch GREATER 0)
        message(FATAL_ERROR "${_tag} [${_lauf}]: gesperrter Affe nicht in Zustand 4/1 an der Parkstelle (${_gesperrt_falsch} Bilder) — Spawn-INIT @0x8004259c/@0x80110eb8 fehlt")
    endif()

    if(_pos STREQUAL "")
        if(_n_gesperrt LESS 300)
            message(FATAL_ERROR "${_tag} [${_lauf}]: nur ${_n_gesperrt} gesperrte Bilder (Soll >= 300 ohne Ausloeser)")
        endif()
        if(_R GREATER -1)
            message(FATAL_ERROR "${_tag} [${_lauf}]: Freigabe ohne Ausloeser in F${_R}")
        endif()
        return()
    endif()

    if(_R LESS 0 OR _n_gesperrt LESS 1)
        message(FATAL_ERROR "${_tag} [${_lauf}]: keine Freigabe im Ausloeser (Member_set(12,0x41) ROOM4040 @0x011D6) oder kein gesperrtes Bild davor")
    endif()
    # Freigabe-Bild = o11 F58
    list(GET _A_${_R} 0 _st0)
    list(GET _A_${_R} 1 _s10)
    list(GET _A_${_R} 2 _s20)
    list(GET _A_${_R} 3 _g0)
    list(GET _A_${_R} 4 _mo0)
    list(GET _A_${_R} 5 _af0)
    list(GET _A_${_R} 6 _x0)
    list(GET _A_${_R} 8 _z0)
    if(NOT _st0 EQUAL 1 OR NOT _s10 EQUAL 10 OR NOT _s20 EQUAL 2 OR NOT _g0 STREQUAL "01" OR NOT _mo0 EQUAL 13 OR NOT _af0 EQUAL 20
       OR NOT _x0 EQUAL -25090 OR NOT _z0 EQUAL 9230)
        message(FATAL_ERROR "${_tag} [${_lauf}]: Freigabe-Bild F${_R} = ${_A_${_R}} statt 1/10/2 g01 Clip 13 Bild 20 @(-25090,9230) (o11 F58, 0x801158e8)")
    endif()
    # Fallbahn R..R+18 = o11 F58..F76
    set(_bahn "")
    set(_t 0)
    foreach(_soll IN LISTS _o11_y)
        math(EXPR _f "${_R} + ${_t}")
        if(NOT DEFINED _A_${_f})
            message(FATAL_ERROR "${_tag} [${_lauf}]: kein Affe in F${_f}")
        endif()
        list(GET _A_${_f} 7 _y)
        list(APPEND _bahn ${_y})
        if(NOT _y EQUAL _soll)
            message(FATAL_ERROR "${_tag} [${_lauf}]: Fallbahn R+${_t}: y = ${_y}, Original o11 ${_soll} (Bahn bisher ${_bahn})")
        endif()
        math(EXPR _t "${_t} + 1")
    endforeach()
    math(EXPR _f18 "${_R} + 18")
    math(EXPR _f19 "${_R} + 19")
    list(GET _A_${_f18} 2 _s2_18)
    list(GET _A_${_f19} 2 _s2_19)
    list(GET _A_${_f19} 5 _af_19)
    if(NOT _s2_18 EQUAL 3 OR NOT _s2_19 EQUAL 4 OR NOT _af_19 EQUAL 25)
        message(FATAL_ERROR "${_tag} [${_lauf}]: Landung: R+18 Phase ${_s2_18} (Soll 3), R+19 Phase ${_s2_19} Bild ${_af_19} (Soll 4 / 25, o11 F76/F77)")
    endif()
    set(_sub4 -1)
    foreach(_f IN LISTS _bilder)
        if(_f GREATER _R AND _sub4 LESS 0)
            list(GET _A_${_f} 1 _s1)
            if(_s1 EQUAL 4)
                math(EXPR _sub4 "${_f} - ${_R}")
            endif()
        endif()
    endforeach()
    if(NOT _sub4 EQUAL 34)
        message(FATAL_ERROR "${_tag} [${_lauf}]: Sub 4 in R+${_sub4} (Original o11 F92 = R+34)")
    endif()

    # --- state.log: HP je Bild nach dem Sprung (Bildzaehler beginnt dort neu) ---
    file(STRINGS "${_dir}/state.log" _zl)
    set(_vorher -1)
    set(_nach 0)
    set(_hp_alt "")
    set(_n_ab 0)
    set(_ab_luft 0)
    set(_erster -1)
    set(_ab_liste "")
    foreach(_l IN LISTS _zl)
        if(NOT _l MATCHES "^F([0-9]+) .*PL\\(-?[0-9]+,-?[0-9]+,rot=-?[0-9]+,hp=(-?[0-9]+)\\)")
            continue()
        endif()
        set(_f "${CMAKE_MATCH_1}")
        set(_hp "${CMAKE_MATCH_2}")
        if(NOT _nach AND _vorher GREATER _f)
            set(_nach 1)
        endif()
        set(_vorher ${_f})
        if(NOT _nach)
            continue()
        endif()
        if(NOT _hp_alt STREQUAL "" AND NOT _hp EQUAL _hp_alt)
            math(EXPR _n_ab "${_n_ab} + 1")
            set(_ya "?")
            if(DEFINED _A_${_f})
                list(GET _A_${_f} 7 _ya)
            endif()
            math(EXPR _rel "${_f} - ${_R}")
            list(APPEND _ab_liste "F${_f}(R+${_rel},${_hp_alt}->${_hp},y=${_ya})")
            if(NOT _ya STREQUAL "0")
                math(EXPR _ab_luft "${_ab_luft} + 1")
            endif()
            if(_erster LESS 0)
                set(_erster ${_rel})
            endif()
        endif()
        set(_hp_alt ${_hp})
    endforeach()
    message(STATUS "${_tag} [${_lauf}]: Fallbahn ${_bahn}; Sub 4 R+${_sub4}; HP-Abzuege ${_ab_liste}")
    if(_n_ab LESS 1)
        message(FATAL_ERROR "${_tag} [${_lauf}]: kein HP-Abzug bis zum Laufende (Original o11: -10 vom Boden in R+70)")
    endif()
    if(_ab_luft GREATER 0 OR _erster LESS 19)
        message(FATAL_ERROR "${_tag} [${_lauf}]: HP-Abzug nicht vom Boden: ${_ab_luft} aus der Luft, erster in R+${_erster} (Landung R+18)")
    endif()
endfunction()

r38s_tor(std_ruhe std "")
r38s_tor(std_frei std "-25000,4000,0,0")
r38s_tor(re15_ruhe re15 "")
r38s_tor(re15_frei re15 "-25000,4000,0,0")
file(REMOVE "${_exe_kopie}")
message(STATUS "${_tag}: OK (Ereignis-Affen: gesperrt in Zustand 4/1, nach Member_set(12, 0x41) Fall wie Original o11, Angriff vom Boden; Standard-KI und RE1.5-KI)")
