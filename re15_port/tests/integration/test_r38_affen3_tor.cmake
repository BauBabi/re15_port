# =============================================================================
# Runde 38 Spur S "affen3" — Wurzel-Tor der kleinen Affen (Typ 0x29): gesperrte Ereignis-Affen warten auf ihr Skript.
#
# Die Wurzel 0x80110b00 (STAGE3.BIN, wortgleich STAGE4/5) laeuft nur ohne +0x9 & 0x20:
#   `lbu v0,9(v1)` / `andi v0,v0,0x20` / `bne v0,zero,0x80110bd0` @0x80110b34-40
# -> gesperrt weder Zustand (auch kein INIT) noch Schub/Klemme. Die Ereignis-Affen in Stage 4/5 tragen grid 0x61; ROOM4040
# sub04 gibt Platz 0 frei: Work_set(2,0), Pos_set (-25090,-10000,9230) @0x011CE, Member_set(12, 0x41) @0x011D6; Ausloeser
# Aot_set Platz 5 sce 3 @0x00E9C, Rechteck x -27899.. -22159, z 2608..5608.
# Vorher (ohne Tor, Dossier analysis/befunde_runde38/S_affen3.md Lauf g1): INIT in F6 an der Spawn-Stelle (-14040,19130),
# ab F235 laeuft der Affe los — vor seinem Auftritt.
#
# Zwei Laeufe je KI (std = RE2-Flavor, re15), ROOM4040 per Debug-Sprung:
#   ruhe  Leon am Sprung-Spawn (-26400,17150): 400 Bilder lang bleibt der Affe (t=29, g=61) in Zustand 0 an (-14040,19130)
#   frei  Leon im Ausloeser (-25000,4000): der Affe wird freigegeben (g=41) und erst DANN initialisiert (st 1); vorher st 0
#
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DWORKDIR=<dir> -P test_r38_affen3_tor.cmake
# =============================================================================
set(_tag "r38_affen3_tor")
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "${_tag}: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "${_tag}: WORKDIR fehlt")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_wurzel "${WORKDIR}/lauf_${_lauf_id}")
file(MAKE_DIRECTORY "${_wurzel}")

get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" LAST_EXT)
file(GLOB _alte_kopien "${_exe_dir}/re15_pc_r38s_tor_*")
foreach(_k IN LISTS _alte_kopien)
    file(REMOVE "${_k}")
endforeach()
set(_exe_kopie "${_exe_dir}/re15_pc_r38s_tor_${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")
set(RE15_PC_EXE "${_exe_kopie}")

function(r38s_tor _lauf _flavor _pos)
    set(_dir "${_wurzel}/${_lauf}")
    file(MAKE_DIRECTORY "${_dir}")
    set(WORKDIR "${_dir}")
    set(_st RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2)
    if(NOT _flavor STREQUAL "std")
        list(APPEND _st "RE15_AI_FLAVOR=${_flavor}")
    else()
        unset(ENV{RE15_AI_FLAVOR})
    endif()
    if(NOT _pos STREQUAL "")
        list(APPEND _st "RE15_PLAYER_POS=${_pos}")
    endif()
    set(_env RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_SOFTWARE_RENDER=1 RE15_WINDOW_SCALE=1 ${_st}
             RE15_DEBUG_JUMP=4040@250 RE15_STATE_LOG=state.log "RE15_EXIT_AT=400#4040")
    re15_start_spiel(_rv 400 ${_env} "${RE15_PC_EXE}")
    if(NOT _rv EQUAL 0)
        message(STATUS "${_tag} [${_lauf}]: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(REMOVE "${_dir}/debug.log" "${_dir}/state.log")
        re15_start_spiel(_rv 400 ${_env} "${RE15_PC_EXE}")
    endif()
    if(NOT _rv EQUAL 0)
        message(FATAL_ERROR "${_tag} [${_lauf}]: re15_pc exit=${_rv} (erwartet 0 bis RE15_EXIT_AT), ${_dir}")
    endif()
    if(NOT EXISTS "${_dir}/state.log")
        message(FATAL_ERROR "${_tag} [${_lauf}]: kein state.log in ${_dir}")
    endif()

    file(STRINGS "${_dir}/state.log" _zl)
    set(_vorher -1)
    set(_nach 0)
    set(_n_gesperrt 0)
    set(_n_gesperrt_aktiv 0)
    set(_lage_weg 0)
    set(_frei_f -1)
    set(_init_f -1)
    set(_init_vor_frei 0)
    foreach(_l IN LISTS _zl)
        if(NOT _l MATCHES "^F([0-9]+) ")
            continue()
        endif()
        set(_f "${CMAKE_MATCH_1}")
        if(NOT _nach AND _vorher GREATER _f)
            set(_nach 1)
        endif()
        set(_vorher ${_f})
        if(NOT _nach)
            continue()
        endif()
        if(NOT _l MATCHES "\\[[0-9]+ t=29 st=([0-9]+) ss1=[0-9]+ ss2=[0-9]+ ss3=[0-9]+ g=([0-9a-f]+) [^@]*@\\((-?[0-9]+),(-?[0-9]+),r-?[0-9]+\\)\\]")
            continue()
        endif()
        set(_st "${CMAKE_MATCH_1}")
        set(_g "${CMAKE_MATCH_2}")
        set(_x "${CMAKE_MATCH_3}")
        set(_z "${CMAKE_MATCH_4}")
        if(_g STREQUAL "61")
            math(EXPR _n_gesperrt "${_n_gesperrt} + 1")
            if(NOT _st EQUAL 0)
                math(EXPR _n_gesperrt_aktiv "${_n_gesperrt_aktiv} + 1")
            endif()
            if(NOT _x EQUAL -14040 OR NOT _z EQUAL 19130)
                set(_lage_weg 1)
            endif()
        elseif(_g STREQUAL "41" AND _frei_f LESS 0)
            set(_frei_f ${_f})
        endif()
        if(_init_f LESS 0 AND NOT _st EQUAL 0)
            set(_init_f ${_f})
            if(NOT _g STREQUAL "41")
                set(_init_vor_frei 1)
            endif()
        endif()
    endforeach()
    message(STATUS "${_tag} [${_lauf}]: Bilder gesperrt (g=61) ${_n_gesperrt}, davon aktiv ${_n_gesperrt_aktiv}; "
                   "Freigabe (g=41) F${_frei_f}, erstes aktives Bild F${_init_f}")
    if(_n_gesperrt_aktiv GREATER 0 OR _init_vor_frei)
        message(FATAL_ERROR "${_tag} [${_lauf}]: gesperrter Affe lief (${_n_gesperrt_aktiv} aktive Bilder bei g=61) — Tor @0x80110b34-40 fehlt")
    endif()
    if(_lage_weg)
        message(FATAL_ERROR "${_tag} [${_lauf}]: gesperrter Affe hat seine Spawn-Lage (-14040,19130) verlassen")
    endif()
    if(_pos STREQUAL "")
        if(_n_gesperrt LESS 300)
            message(FATAL_ERROR "${_tag} [${_lauf}]: nur ${_n_gesperrt} gesperrte Bilder (Soll >= 300 ohne Ausloeser)")
        endif()
        if(_frei_f GREATER -1)
            message(FATAL_ERROR "${_tag} [${_lauf}]: Freigabe ohne Ausloeser in F${_frei_f}")
        endif()
    else()
        if(_frei_f LESS 0 OR _init_f LESS 0)
            message(FATAL_ERROR "${_tag} [${_lauf}]: keine Freigabe/kein INIT im Ausloeser (Member_set(12,0x41) ROOM4040 @0x011D6)")
        endif()
    endif()
endfunction()

r38s_tor(std_ruhe std "")
r38s_tor(std_frei std "-25000,4000,1024,0")
r38s_tor(re15_ruhe re15 "")
r38s_tor(re15_frei re15 "-25000,4000,1024,0")
file(REMOVE "${_exe_kopie}")
message(STATUS "${_tag}: OK (gesperrte Ereignis-Affen warten auf Member_set(12, 0x41), Standard-KI und RE1.5-KI)")
