cmake_minimum_required(VERSION 3.16)   # cmake -P: ohne diese Zeile gelten im Linux-Container (CMake 3.28) die alten Policies (IN_LIST, if(TRUE)) - Muster der aelteren Integrationsskripte, Memory reai-v2-linux-test-portabilitaet
# =============================================================================
# Runde 41 Spur AN: Annette-Szene im hinteren Zugwagen (include/re15_annette_r41.h, analysis/befunde_runde41/AN_annette.md).
#
# Vier echte Laeufe (exe, kein Messhaken ausser RE15_SET_FLAG fuer den Spielstand). 5090/5091 wie integration_r41_birkin_pistole:
# Debug-Sprung in Wagen B, Tuer 2 nach Wagen C, laufen bis Cut 12 (Kampfstart-Ausloeser sub01 @0x01290).
#   leon_tor   (3,89)=1 (Tor, ROOM6000 sub07 @0x011B4) und (9,133)=1 (Zugstart 6030 gesehen): Modell RE2/ANNETTE_4D.EMD, Szene
#              nach RE2 ROOM6141 sub02 in der Reihenfolge Szenenstart (Krach) -> Sturz -> gelandet -> Hieb -> Treffer (Blut-Textur
#              nachgeladen) -> Schnitt weg/liegt/Schrei -> Kampfstart sub04; Toene 0/1/2 der Mini-Bank; danach die Riesenform
#              freigegeben (grid 0x13 = sub04 Member_set @0x0130A), Annette bleibt liegen (hp -1).
#   leon_ohne_zug (3,89)=1, (9,133)=0: die Frau im Kittel wird in 5090 verworfen (erst nach dem Zugstart), keine Szene.
#              Strang finale Stufe 6 (Nutzer 18.11. "darf sie in der Animation nicht noch mal aufstehen. Sondern mit den Schlag direkt
#              liegen bleiben."): Messschiene RE15_POSE_LOG (gezeichnete Pose mit Ueberblendung, Welt-y je Knochen) - ab dem Trefferbild
#              werden Becken (Knochen 0) und Kopf/Oberkoerper (Knochen 8) nie wieder hoeher und die Lage (x,z) bleibt dieselbe.
#              Strang finale Stufe 8 (Nutzer 19.11. "Beim zurückweichen fliegt Anette irgendwie komisch in der Luft."): dieselbe
#              Messschiene vom Hieb-Signal bis zum Trefferbild - der tiefste Knochen bleibt auf Standhoehe (hoechstens 30 neben dem
#              Bild vor dem Signal), das Becken hebt sich um hoechstens 30, kein Bild der Bewegung steht zweimal, die Lage bleibt
#              (auch im Trefferbild). RE2 ROOM6141 sub02 @0x01138 `3f 02 02 44` = Stand-Schleife (Executor-Sub 2 @0x80050f00).
#   leon_leiche (3,89)=1, (9,133)=1, (3,42)=1 (Nachbesserung 3, M8): Wiedereintritt nach der Szene, Annette liegt als Leiche
#              (NB4: RE2-Liegeclip 0x18 = Clip 24 Bild 0; Stufe 6: Lage S (3700,-22500) Gier 1695, wo sie fiel; hp -1, Blut-Kittel),
#              keine zweite Szene.
#   elza       5091 mit (3,89)=1, (9,133)=1: keine Frau im Kittel auf der Disc, keine Szene.
#   zug6030    Fuehrerstand 6030 (Debug-Sprung = Eintritt Cut 0 @0x8001d818 -> sub00 Case 0 -> sub07) mit (3,89)=1, (4,23)=1:
#              Zugstart-Szene statt sub05 (sub07 @0x01132), Toene Zug an (3) vor Krach (0), Annette geht ab und ist versteckt
#              (Pos_set-Form 6000 @0x0100A), (9,133) gesetzt. NB4: Leon tritt zur Seite (Plc_dest (-3000,-23700)), Tuerton
#              Port-Bank 0x0E Satz 0 vor Satz 1 (RE2 Claire ROOM4081 sub05 @0x03634/@0x03644; RE15_SE_DEBUG-Zeilen).
#
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DWORKDIR=<dir> -P test_r41_annette.cmake
# =============================================================================
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "r41_annette: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "r41_annette: WORKDIR fehlt")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_wurzel "${WORKDIR}/lauf_${_lauf_id}")
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
file(GLOB _alte_kopien "${_exe_dir}/re15_pc_r41annette_*.exe")
foreach(_k IN LISTS _alte_kopien)
    file(REMOVE "${_k}")
endforeach()
set(_exe_kopie "${_exe_dir}/re15_pc_r41annette_${_lauf_id}.exe")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")

set(_f "")
function(ein_lauf _name _raum _flag _pos _exit)
    set(WORKDIR "${_wurzel}/${_name}")
    file(MAKE_DIRECTORY "${WORKDIR}")
    set(_extra "")
    if(_raum STREQUAL "5091")
        set(_extra "RE15_TITLE_SHOT_CHAR=1")
    endif()
    if(_flag)
        list(APPEND _extra "RE15_SET_FLAG=${_flag}")
    endif()
    if(_name STREQUAL "zug6030")
        list(APPEND _extra "RE15_SE_DEBUG=1")
    endif()
    re15_start_spiel(_rv 240
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_SOFTWARE_RENDER=1 RE15_WINDOW_SCALE=1
        RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2 ${_extra}
        RE15_DEBUG_JUMP=${_raum}@250 "RE15_PLAYER_POS=${_pos}"
        RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=100 "RE15_INPUT_SCRIPT=A0.1,W1,U8.5,W40"
        RE15_SPAWN_DIAG=1 RE15_STATE_LOG=state.log RE15_POSE_LOG=pose.txt
        "RE15_EXIT_AT=${_exit}#${_raum}"
        "${_exe_kopie}")
    set(_g "")
    if(NOT EXISTS "${WORKDIR}/debug.log" OR NOT EXISTS "${WORKDIR}/state.log")
        set(_f "${_f}\n ${_name}: kein Protokoll (exit=${_rv})" PARENT_SCOPE)
        return()
    endif()
    file(READ "${WORKDIR}/debug.log" _dbg)
    file(STRINGS "${WORKDIR}/state.log" _frau REGEX " t=4d st=")
    if(_name STREQUAL "leon_tor")
        if(NOT _dbg MATCHES "Ersatzmodell RE2/ANNETTE_4D.EMD")
            string(APPEND _g "\n ${_name}: Modell RE2/ANNETTE_4D.EMD nicht geladen")
        endif()
        set(_pos 0)
        foreach(_schritt "Ton 0 " "Szenenstart statt sub04" "Ton 1 " "Sturz:" "gelandet, Drohen:" "Ton 2 " "Hieb \\(RE2"
                         "Ausholen \\(RE2" "Blut-Skala" "Treffer:" "Schnitt weg, liegt, Schrei" "Kampfstart \\(sub04\\), Form frei")
            string(REGEX MATCH "\\[annette\\] F[0-9]+ ${_schritt}" _m "${_dbg}")
            if(NOT _m)
                string(APPEND _g "\n ${_name}: Schritt '${_schritt}' fehlt im debug.log")
                continue()
            endif()
            string(FIND "${_dbg}" "${_m}" _p)
            if(_p LESS _pos)
                string(APPEND _g "\n ${_name}: Schritt '${_schritt}' in falscher Reihenfolge")
            endif()
            set(_pos ${_p})
        endforeach()
        if(NOT _dbg MATCHES "Ersatzmodell RE2/ANNETTE_4D_BLUT.EMD")
            string(APPEND _g "\n ${_name}: Blut-Textur (ANNETTE_4D_BLUT.EMD) nach dem Treffer nicht geladen")
        endif()
        # Strang finale Stufe 6: ab dem Trefferbild nie wieder hoeher, kein Lagesprung (gezeichnete Pose, RE15_POSE_LOG)
        string(REGEX MATCH "\\[annette\\] F([0-9]+) Treffer:" _m "${_dbg}")
        set(_f_treffer "${CMAKE_MATCH_1}")
        if(NOT _f_treffer OR NOT EXISTS "${WORKDIR}/pose.txt")
            string(APPEND _g "\n ${_name}: Trefferbild oder pose.txt fehlt")
        else()
            file(STRINGS "${WORKDIR}/pose.txt" _pz REGEX " t4D .* Y:")
            set(_n 0)
            set(_hoch "")
            set(_sprung "")
            foreach(_z IN LISTS _pz)
                if(NOT _z MATCHES "^F([0-9]+) .* x(-?[0-9]+) z(-?[0-9]+) ry")
                    continue()
                endif()
                set(_fr "${CMAKE_MATCH_1}")
                set(_x "${CMAKE_MATCH_2}")
                set(_zz "${CMAKE_MATCH_3}")
                if(_fr LESS _f_treffer)
                    continue()
                endif()
                string(REGEX MATCH "Y:[-0-9,]+" _y "${_z}")
                string(REPLACE "Y:" "" _y "${_y}")
                string(REPLACE "," ";" _y "${_y}")
                list(GET _y 0 _y0)
                list(GET _y 8 _y8)
                if(_n GREATER 0)
                    math(EXPR _d0 "${_v0} - (${_y0})")
                    math(EXPR _d8 "${_v8} - (${_y8})")
                    if((_d0 GREATER 2 OR _d8 GREATER 2) AND NOT _hoch)
                        set(_hoch "F${_fr}: Becken ${_v0} -> ${_y0}, Kopf ${_v8} -> ${_y8}")
                    endif()
                    if((NOT _x EQUAL _vx OR NOT _zz EQUAL _vz) AND NOT _sprung)
                        set(_sprung "F${_fr}: (${_vx},${_vz}) -> (${_x},${_zz})")
                    endif()
                endif()
                set(_v0 "${_y0}")
                set(_v8 "${_y8}")
                set(_vx "${_x}")
                set(_vz "${_zz}")
                math(EXPR _n "${_n} + 1")
            endforeach()
            message(STATUS "r41_annette ${_name}: Sturz ab F${_f_treffer}: ${_n} gezeichnete Bilder, hoeher '${_hoch}', Lagesprung '${_sprung}'")
            if(_n LESS 60)
                string(APPEND _g "\n ${_name}: nur ${_n} gezeichnete Annette-Bilder ab dem Treffer F${_f_treffer}")
            endif()
            if(_hoch)
                string(APPEND _g "\n ${_name}: Annette richtet sich nach dem Treffer wieder auf (${_hoch})")
            endif()
            if(_sprung)
                string(APPEND _g "\n ${_name}: Annette springt nach dem Treffer an eine andere Lage (${_sprung})")
            endif()
        endif()
        # Strang finale Stufe 8: vom Hieb-Signal bis zum Trefferbild steht sie (gezeichnete Pose, RE15_POSE_LOG)
        string(REGEX MATCH "\\[annette\\] F([0-9]+) Hieb \\(RE2" _m "${_dbg}")
        set(_f_hieb "${CMAKE_MATCH_1}")
        if(NOT _f_hieb OR NOT _f_treffer OR NOT EXISTS "${WORKDIR}/pose.txt")
            string(APPEND _g "\n ${_name}: Hieb-Signal, Trefferbild oder pose.txt fehlt (Stufe 8)")
        else()
            math(EXPR _f_stand "${_f_hieb} - 1")
            file(STRINGS "${WORKDIR}/pose.txt" _pz REGEX " t4D .* Y:")
            set(_n8 0)
            set(_stand "")
            set(_tief_ab 0)
            set(_becken_hoch 0)
            set(_starr "")
            set(_lage8 "")
            set(_af_vor "")
            foreach(_z IN LISTS _pz)
                if(NOT _z MATCHES "^F([0-9]+) .* m([0-9]+) af([0-9]+) .* x(-?[0-9]+) z(-?[0-9]+) ry")
                    continue()
                endif()
                set(_fr "${CMAKE_MATCH_1}")
                set(_mo "${CMAKE_MATCH_2}")
                set(_af "${CMAKE_MATCH_3}")
                set(_x "${CMAKE_MATCH_4}")
                set(_zz "${CMAKE_MATCH_5}")
                if(_fr LESS _f_stand OR _fr GREATER _f_treffer)
                    continue()
                endif()
                string(REGEX MATCH "Y:[-0-9,]+" _y "${_z}")
                string(REPLACE "Y:" "" _y "${_y}")
                string(REPLACE "," ";" _y "${_y}")
                list(GET _y 0 _becken)
                set(_tief -1000000)
                foreach(_k IN LISTS _y)
                    if(_k GREATER _tief)
                        set(_tief "${_k}")
                    endif()
                endforeach()
                if(_fr EQUAL _f_stand)
                    set(_stand "tiefster Knochen ${_tief}, Becken ${_becken}")
                    set(_s_tief "${_tief}")
                    set(_s_becken "${_becken}")
                    set(_s_x "${_x}")
                    set(_s_z "${_zz}")
                    continue()
                endif()
                if(NOT _stand)
                    continue()
                endif()
                if((NOT _x EQUAL _s_x OR NOT _zz EQUAL _s_z) AND NOT _lage8)
                    set(_lage8 "F${_fr}: (${_s_x},${_s_z}) -> (${_x},${_zz})")
                endif()
                if(_fr EQUAL _f_treffer)
                    continue()                           # das Trefferbild selbst gehoert zum Sturz (Stufe 6), hier nur die Lage
                endif()
                math(EXPR _d "${_tief} - (${_s_tief})")
                if(_d LESS 0)
                    math(EXPR _d "0 - (${_d})")
                endif()
                if(_d GREATER _tief_ab)
                    set(_tief_ab "${_d}")
                endif()
                math(EXPR _h "${_s_becken} - (${_becken})")
                if(_h GREATER _becken_hoch)
                    set(_becken_hoch "${_h}")
                endif()
                if("${_mo}/${_af}" STREQUAL "${_af_vor}" AND NOT _starr)
                    set(_starr "F${_fr}: Clip/Bild ${_mo}/${_af} steht zweimal")
                endif()
                set(_af_vor "${_mo}/${_af}")
                math(EXPR _n8 "${_n8} + 1")
            endforeach()
            message(STATUS "r41_annette ${_name}: Ausholen F${_f_hieb}..F${_f_treffer}: Standhoehe '${_stand}', ${_n8} gezeichnete Bilder, tiefster Knochen hoechstens ${_tief_ab} daneben, Becken hoechstens ${_becken_hoch} hoeher, starr '${_starr}', Lage '${_lage8}'")
            if(NOT _stand OR _n8 LESS 40)
                string(APPEND _g "\n ${_name}: Ausholen: Standbild F${_f_stand} fehlt oder nur ${_n8} gezeichnete Bilder bis zum Treffer")
            endif()
            if(_tief_ab GREATER 30)
                string(APPEND _g "\n ${_name}: Annette haengt beim Ausholen in der Luft: tiefster Knochen bis ${_tief_ab} neben der Standhoehe (${_stand})")
            endif()
            if(_becken_hoch GREATER 30)
                string(APPEND _g "\n ${_name}: Annettes Becken hebt sich beim Ausholen um ${_becken_hoch} (${_stand})")
            endif()
            if(_starr)
                string(APPEND _g "\n ${_name}: eingefrorene Pose beim Ausholen (${_starr})")
            endif()
            if(_lage8)
                string(APPEND _g "\n ${_name}: Lagesprung zwischen Hieb-Signal und Trefferbild (${_lage8})")
            endif()
        endif()
        file(STRINGS "${WORKDIR}/state.log" _form REGEX " t=30 st=[0-9]+ ss1=[0-9]+ ss2=[0-9]+ ss3=[0-9]+ g=13 ")
        list(LENGTH _form _nf)
        if(_nf EQUAL 0)
            string(APPEND _g "\n ${_name}: Riesenform nach der Szene nie freigegeben (kein t=30 mit g=13)")
        endif()
        list(LENGTH _frau _na)
        if(_na EQUAL 0)
            string(APPEND _g "\n ${_name}: keine Frau im Kittel im state.log")
        else()
            list(GET _frau -1 _letzte)
            if(NOT _letzte MATCHES "hp=-1" OR NOT _letzte MATCHES "mo=24 af=0 ")
                string(APPEND _g "\n ${_name}: Annette am Ende nicht liegend (NB4: Clip 24 Bild 0, hp -1): ${_letzte}")
            endif()
        endif()
    elseif(_name STREQUAL "leon_leiche")
        # NB3 M8: Wiedereintritt nach der Szene ((3,42)=1): die 0x4D liegt als Leiche (RE2 MAIN sub00 @0x00D16), Blut-Kittel
        if(NOT _dbg MATCHES "Wiedereintritt nach der Szene: Leiche liegt")
            string(APPEND _g "\n ${_name}: Leiche nicht gelegt")
        endif()
        if(NOT _dbg MATCHES "Ersatzmodell RE2/ANNETTE_4D_BLUT.EMD")
            string(APPEND _g "\n ${_name}: Leiche ohne Blut-Kittel (ANNETTE_4D_BLUT.EMD)")
        endif()
        if(_dbg MATCHES "\\[annette\\] F[0-9]+ Szenenstart")
            string(APPEND _g "\n ${_name}: Szene lief ein zweites Mal")
        endif()
        list(LENGTH _frau _na)
        if(_na EQUAL 0)
            string(APPEND _g "\n ${_name}: keine Leiche im state.log")
        else()
            list(GET _frau -1 _letzte)
            if(NOT _letzte MATCHES "mo=24 af=0 " OR NOT _letzte MATCHES "hp=-1" OR NOT _letzte MATCHES "@\\(3700,-22500,r1695\\)")
                string(APPEND _g "\n ${_name}: Leiche nicht RE2-liegend (Stufe 6: Clip 24 Bild 0 bei S (3700,-22500) Gier 1695, hp -1): ${_letzte}")
            endif()
        endif()
    elseif(_name STREQUAL "zug6030")
        set(_pos 0)
        # Runde 42 Strang finale Stufe 2: statt "Ton 3" (Zug-an-Ton) der Zugfilm R600ZUG.STR (re15_zws_r41.h "Zugfilm Raum 600")
        foreach(_schritt "\\[annette\\] F[0-9]+ ROOM6030 Zugstart-Szene statt sub05" "\\[zug600\\] Film angefordert"
                         "\\[zug600\\] Film zu Ende: 405 von 405 Bildern" "\\[annette\\] F[0-9]+ Ton 0 ")
            string(REGEX MATCH "${_schritt}" _m "${_dbg}")
            if(NOT _m)
                string(APPEND _g "\n ${_name}: Schritt '${_schritt}' fehlt im debug.log")
                continue()
            endif()
            string(FIND "${_dbg}" "${_m}" _p)
            if(_p LESS _pos)
                string(APPEND _g "\n ${_name}: Schritt '${_schritt}' in falscher Reihenfolge")
            endif()
            set(_pos ${_p})
        endforeach()
        list(LENGTH _frau _na)
        if(_na EQUAL 0)
            string(APPEND _g "\n ${_name}: Annette nie im state.log (Sce_em_set @0x010F8 im Programm)")
        else()
            list(GET _frau -1 _letzte)
            if(NOT _letzte MATCHES "8646")
                string(APPEND _g "\n ${_name}: Annette am Ende nicht versteckt (z 8646): ${_letzte}")
            endif()
        endif()
        if(NOT _dbg MATCHES "Plc_dest\\(slot=0 mode=0x04 dest=\\(-3000,-23700\\)")
            string(APPEND _g "\n ${_name}: Leon tritt nicht zur Seite (Plc_dest (-3000,-23700))")
        endif()
        string(FIND "${_dbg}" "SCD Se_on: bank=14 id=0 " _p_auf)
        string(FIND "${_dbg}" "SCD Se_on: bank=14 id=1 " _p_zu)
        if(_p_auf LESS 0 OR _p_zu LESS _p_auf)
            string(APPEND _g "\n ${_name}: Tuerton Bank 0x0E Satz 0 (oeffnen) vor Satz 1 (zufallen) fehlt (${_p_auf}/${_p_zu})")
        endif()
    else()
        if(_dbg MATCHES "\\[annette\\] F[0-9]+ Szenenstart")
            string(APPEND _g "\n ${_name}: Szene gestartet, erwartet keine")
        endif()
        list(LENGTH _frau _na)
        if(NOT _na EQUAL 0)
            string(APPEND _g "\n ${_name}: Frau im Kittel steht im Wagen (${_na} Zeilen), erwartet keine")
        endif()
        if(_name STREQUAL "leon_ohne_zug" AND NOT _dbg MATCHES "Frau im Kittel \\(0x4D, @0x0122A\\) verworfen")
            string(APPEND _g "\n ${_name}: Verwerfen der 0x4D nicht protokolliert")
        endif()
    endif()
    message(STATUS "r41_annette ${_name}: exit=${_rv}, Zeilen Frau ${_na}")
    set(_f "${_f}${_g}" PARENT_SCOPE)
endfunction()

ein_lauf(leon_tor 5090 "3:89,9:133" "500,-9175,2048,0" 1500)
ein_lauf(leon_ohne_zug 5090 "3:89" "500,-9175,2048,0" 900)
ein_lauf(leon_leiche 5090 "3:89,9:133,3:42" "500,-9175,2048,0" 600)
ein_lauf(elza 5091 "3:89,9:133" "500,-9175,2048,0" 900)
ein_lauf(zug6030 6030 "3:89,4:23" "-3873,-23487,0,0" 1300)
file(REMOVE "${_exe_kopie}")
if(_f)
    message(FATAL_ERROR "r41_annette:${_f}")
endif()
message(STATUS "r41_annette: alle vier Laeufe wie erwartet")
