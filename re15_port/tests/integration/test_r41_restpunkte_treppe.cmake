cmake_minimum_required(VERSION 3.16)
# =============================================================================
# Runde 41 Spur Q, Nachbesserung 1 (Abnahme 0 Mangel M1): FIGUR AUF DER TREPPE AN TEIL 8, ROOM6010/6011 Cut 5.
# Dossier analysis/befunde_runde41/Q_restpunkte.md, Abschnitt "Nachbesserung 1".
# Teil 8 ist die Aussenflaeche der Westwange, seine Rechtecke stehen auf ihrer Ebene x -20591 (naeher an der Kamera als die Zelle @0x0092C). Eine Figur auf den Stufen darf
# davon nichts abbekommen: der Weg ist der echte Treppen-Handler (AOT Typ 13, Aktionstaste am Treppenfuss, stair_common.c), auf der westlichsten Spur x -19700, die Slot 9/10 zulaesst
# (Mitte -18487, halbe Breite 1282). Cut 5 gibt RE15_FORCE_CUT vor: nur so steht die Figur ueber die ganze Treppe in dieser Kamera.
#   A = mit Masken, B = ohne Masken (RE15_NO_PRI=1), C = ohne Masken, Figur ausserhalb des Regionsvierecks (20000,20000), Bild 120.
#   Fenster = Kasten von Teil 8 (162,202)..(185,240). Gemessen Leon Bilder 123/126/129: 35/51/59 Figurpunkte im Kasten, 7,2 Bildpunkte Abstand zum Teil, 0 auf dem Teil.
#   Verlangt je Figur: in den Bildern zusammen S > SMIN und H == 0.
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DRE15_PPM_TOOL=<probe_r37_masken36_ppm> -DWORKDIR=<dir> [-DFIGUR=elza] -P <diese Datei>
# =============================================================================
foreach(_v RE15_PC_EXE RE15_PPM_TOOL)
    if(NOT ${_v} OR NOT EXISTS "${${_v}}")
        message(FATAL_ERROR "r41_restpunkte_treppe: ${_v} fehlt: '${${_v}}'")
    endif()
endforeach()
if(NOT WORKDIR)
    message(FATAL_ERROR "r41_restpunkte_treppe: WORKDIR fehlt")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

set(_figur "")
set(_zr 6010)
set(_pref "re15_pc_r41qt_")
if(FIGUR STREQUAL "elza")
    set(_figur "RE15_TITLE_SHOT_CHAR=1")
    set(_zr 6011)
    set(_pref "re15_pc_r41qte_")
endif()

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" LAST_EXT)
file(GLOB _alte_kopien "${_exe_dir}/${_pref}*")
foreach(_k IN LISTS _alte_kopien)
    file(REMOVE "${_k}")
endforeach()
set(_exe_kopie "${_exe_dir}/${_pref}${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")
set(_basis "${WORKDIR}/lauf_${_lauf_id}")

# Lauf: <art> a = mit Masken, b = ohne Masken, c = ohne Masken und ohne Figur
foreach(_art a b c)
    set(WORKDIR "${_basis}_${_art}")
    file(MAKE_DIRECTORY "${WORKDIR}")
    if(_art STREQUAL "c")
        set(_extra RE15_NO_PRI=1 "RE15_PLAYER_POS=20000,20000,0,0" "RE15_FRAMEDUMP=120:f.ppm" "RE15_EXIT_AT=120#${_zr}")
    else()
        set(_extra "RE15_PLAYER_POS=-19700,-24568,3072,1" "RE15_INPUT_SCRIPT=W1,U0.3,A0.2,W9" RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=30
                   "RE15_FRAMEDUMP=123-129/3:s" "RE15_EXIT_AT=132#${_zr}")
        if(_art STREQUAL "b")
            list(APPEND _extra RE15_NO_PRI=1)
        endif()
    endif()
    set(_ok 0)
    foreach(_v 1 2 3)
        file(GLOB _alt "${WORKDIR}/*.ppm" "${WORKDIR}/debug.log")
        if(_alt)
            file(REMOVE ${_alt})
        endif()
        re15_start_spiel(_rv 200 RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_WINDOW_SCALE=1 SDL_AUDIODRIVER=dummy SDL_ASSERT=always_ignore
                         RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2 "RE15_DEBUG_JUMP=6010@250" RE15_FORCE_CUT=5
                         ${_extra} ${_figur} "${_exe_kopie}")
        if(EXISTS "${WORKDIR}/debug.log")
            file(READ "${WORKDIR}/debug.log" _log)
            string(TOLOWER "loaded room${_zr}.rdt" _zl)
            string(FIND "${_log}" "${_zl}" _zp REVERSE)
            if(NOT _zp LESS 0)
                string(SUBSTRING "${_log}" ${_zp} -1 _rest)
                if(_art STREQUAL "c")
                    if(_rest MATCHES "EXIT_AT: Bild 120 in Raum" AND EXISTS "${WORKDIR}/f.ppm")
                        set(_ok 1)
                    endif()
                elseif(_rest MATCHES "EXIT_AT: Bild 132 in Raum" AND EXISTS "${WORKDIR}/s000129.ppm")
                    set(_ok 1)
                endif()
            endif()
        endif()
        if(_ok)
            break()
        endif()
    endforeach()
    if(NOT _ok)
        file(REMOVE "${_exe_kopie}")
        message(FATAL_ERROR "r41_restpunkte_treppe[${_art}]: Lauf ungueltig nach 3 Versuchen (exit=${_rv}, ${WORKDIR})")
    endif()
endforeach()
file(REMOVE "${_exe_kopie}")

set(_summe_s 0)
set(_summe_h 0)
foreach(_b 123 126 129)
    execute_process(COMMAND "${RE15_PPM_TOOL}" "${_basis}_a/s000${_b}.ppm" "${_basis}_b/s000${_b}.ppm" "${_basis}_c/f.ppm" 162 202 185 240 24
                    RESULT_VARIABLE _rv OUTPUT_VARIABLE _o TIMEOUT 60)
    if(NOT _rv EQUAL 0 OR NOT _o MATCHES "S=([0-9]+) H=([0-9]+)")
        message(FATAL_ERROR "r41_restpunkte_treppe: PPM-Werkzeug exit=${_rv} '${_o}'")
    endif()
    message(STATUS "r41_restpunkte_treppe[${_zr}] Bild ${_b}: Figurpunkte im Kasten ${CMAKE_MATCH_1}, uebermalt ${CMAKE_MATCH_2}")
    math(EXPR _summe_s "${_summe_s} + ${CMAKE_MATCH_1}")
    math(EXPR _summe_h "${_summe_h} + ${CMAKE_MATCH_2}")
endforeach()
if(NOT SMIN)
    set(SMIN 60)
endif()
if(NOT _summe_s GREATER ${SMIN})
    message(FATAL_ERROR "r41_restpunkte_treppe: Figur nicht im Kasten von Teil 8 (S=${_summe_s}, verlangt > ${SMIN}) - leeres Gruen")
endif()
if(NOT _summe_h EQUAL 0)
    message(FATAL_ERROR "r41_restpunkte_treppe: ${_summe_h} von ${_summe_s} Figurpunkten auf der Treppe uebermalt")
endif()
message(STATUS "r41_restpunkte_treppe[${_zr}]: Figur auf der Treppe im Kasten von Teil 8: ${_summe_s} Punkte, 0 uebermalt")
