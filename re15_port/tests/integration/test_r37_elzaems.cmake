cmake_minimum_required(VERSION 3.16)
# test_r37_elzaems.cmake — INTEGRATION Spur N (Runde 37) "elzaems": das Modellarchiv je Typ an der ECHTEN exe.
#   cmake -DRE15_PC_EXE=<exe> -DRE15_KARTE_TOOL=<probe_r36_elza_karte> -DWORKDIR=<dir> -DTEIL=<teil> -P test_r37_elzaems.cmake
#
# Weg: Spielstand (Speicherkarte, probe_r36_elza_karte) + CONTINUE = der LADE-Weg des Spiels (Raum-Init main00+sub00
# mit den Sce_em_set); elza1101/leon1100 zusaetzlich ueber die TUER (RE15_FIRE_AOT = derselbe Pfad wie Hineinlaufen).
# Geprueft wird die debug.log-Zeile des Laders platform/pc/src/roy_pc.c: Archiv, TOC-Sektor, Laenge und CRC32 des
# gelesenen Blobs (= CRC32 des TOC-Blobs in der Datei, unit_r37_elzaems_toc; = Blob im Original-RAM, GDB-Laeufe g1-g5).
#   elza5081  Elza ROOM5081: Birkin 0x30 aus CDEMD1 Sektor 2015 (FUN_80022300 @0x800223ac; Original g3/g4)
#   elza3071  Elza ROOM3071: Birkin 0x30 aus CDEMD0 — Skript Set(1,0,0) @0x03430 vor Sce_em_set @0x03434 (Original g1)
#   leon5080  Leon ROOM5080: Birkin 0x30 aus CDEMD1 — Skript Set(1,0,1) @0x00742 (Original g2)
#   elza3091  Elza ROOM3091: Typ 0x42 (Sherry) aus CDEMD1 Sektor 1505 (Original g5 + Nutzer-Stand 11B1)
#   elza1101  Elza ROOM1111 -> Tuer Slot 0 -> ROOM1101: Zombies 0x11 (1111) und 0x10 (1101) aus CDEMD1 (Original g1)
#   leon1100  Gegenprobe Leon ROOM1110 -> Tuer -> ROOM1100: KEINE Elza-Archiv-Zeile, Leon-Weg unveraendert
#   elza11b1  Elza ROOM11B1: 0x42 (geparkt @0x01058) aus CDEMD1 Sektor 1505 (Nutzer-Stand _6: Banken == CDEMD1)
#   elza5091  Elza ROOM5091: 0x30 wird 0x36 = RE2-EM36 (NUTZER-VORGABE "finaler Birkin"), KEIN RE1.5-Archiv
#   elza1181griff   Elza ROOM1181, RE1.5-KI, ein Zombie greift: Bank CDEMD1, Opfer-Clips der Figur aus CDEMD1
#                   (RE15_ANIM_TRACE: Spieler Clip 1 = 25 / Clip 6 = 70 Bilder statt 26 / 65; Zombie Clip 9 = 70)
#   elza10c1kraehe  Elza ROOM10C1, RE1.5-KI, Kraehen-Angriff: Opfer-Clip 1 = 31 / Clip 2 = 30 (CDEMD0: 36 / 20)
#   leon10c0kraehe  Gegenprobe Leon ROOM10C0: Kraehen aus CDEMD0, Opfer-Clip 1 = 36 / Clip 2 = 20, keine Elza-Zeile
#   elza1141  Elza ROOM1141 mit Ck(4,242) @0x00B4A: 0x27 aus CDEMD1 Sektor 893 (Nutzer-Stand _7.bak: Opfer-Bank == CDEMD1)
set(_tag "r37_elzaems[${TEIL}]")
foreach(_v RE15_PC_EXE RE15_KARTE_TOOL WORKDIR TEIL)
    if(NOT ${_v})
        message(FATAL_ERROR "${_tag}: ${_v} fehlt")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")
string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_dir "${WORKDIR}/lauf_${TEIL}_${_lauf_id}")
file(MAKE_DIRECTORY "${_dir}")
# Messkopie unter eigenem Namen neben der exe (Asset-Wurzel = exe-Verzeichnis; Muster test_r34n_b_cursor.cmake).
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" EXT)
set(_exe "${_exe_dir}/re15_pc_r37n_${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

macro(fail)
    file(REMOVE "${_exe}")
    message(FATAL_ERROR "${_tag}: ${ARGN} (${_dir})")
endmacro()

macro(karte _raum _x _z _gier)
    execute_process(COMMAND "${RE15_KARTE_TOOL}" "re15_card.mcr" ${_raum} ${_x} ${_z} ${_gier} ${ARGN}
                    WORKING_DIRECTORY "${_dir}" TIMEOUT 60 RESULT_VARIABLE _rvk OUTPUT_VARIABLE _outk)
    if(NOT _rvk EQUAL 0)
        fail("Kartenwerkzeug exit=${_rvk}: ${_outk}")
    endif()
endmacro()

macro(lauf _timeout)
    set(WORKDIR "${_dir}")
    re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    if("${_rv}" STREQUAL "1" OR "${_rv}" STREQUAL "-1" OR NOT EXISTS "${_dir}/debug.log")
        message(STATUS "${_tag}: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(REMOVE "${_dir}/debug.log")
        re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    endif()
    if(NOT EXISTS "${_dir}/debug.log")
        fail("kein debug.log (exit=${_rv})")
    endif()
endmacro()

# function (nicht macro): das Regex-Argument wird so nicht ein zweites Mal als Zeichenkette ausgewertet.
function(zeile_muss _regex _was)
    file(STRINGS "${_dir}/debug.log" _z REGEX "${_regex}")
    if(NOT _z)
        fail("${_was} fehlt (debug.log ohne '${_regex}')")
    endif()
    message(STATUS "${_tag}: ${_was}: ${_z}")
endfunction()

function(zeile_nicht _regex _was)
    file(STRINGS "${_dir}/debug.log" _z REGEX "${_regex}")
    if(_z)
        fail("${_was}: ${_z}")
    endif()
endfunction()

function(datei_muss _datei _regex _was)
    file(STRINGS "${_dir}/${_datei}" _z REGEX "${_regex}" LIMIT_COUNT 1)
    if(NOT _z)
        fail("${_was} fehlt (${_datei} ohne '${_regex}')")
    endif()
    message(STATUS "${_tag}: ${_was}: ${_z}")
endfunction()

function(datei_nicht _datei _regex _was)
    file(STRINGS "${_dir}/${_datei}" _z REGEX "${_regex}" LIMIT_COUNT 1)
    if(_z)
        fail("${_was}: ${_z}")
    endif()
endfunction()

