cmake_minimum_required(VERSION 3.16)
# test_r37_elzaems.cmake — INTEGRATION Spur N (Runde 37) "elzaems": das Modellarchiv je Typ an der ECHTEN exe.
#   cmake -DRE15_PC_EXE=<exe> -DRE15_KARTE_TOOL=<probe_r36_elza_karte> -DWORKDIR=<dir> -DTEIL=<teil> -P test_r37_elzaems.cmake
#
# Weg: Spielstand (Speicherkarte, probe_r36_elza_karte) + CONTINUE = der LADE-Weg des Spiels (Raum-Init main00+sub00
# mit den Sce_em_set); elza1101/leon1100 zusaetzlich ueber die TUER (RE15_FIRE_AOT = derselbe Pfad wie Hineinlaufen).
# Geprueft wird die debug.log-Zeile des Laders platform/pc/src/roy_pc.c: Archiv, TOC-Sektor, Laenge und CRC32 des
# gelesenen Blobs (= CRC32 des TOC-Blobs in der Datei, unit_r37_elzaems_toc; = Blob im Original-RAM, GDB-Laeufe g1-g5).
#   elza5081  Elza ROOM5081: Birkin 0x30 aus CDEMD1 Sektor 2015 (FUN_80022300 @0x800223ac; Original g3/g4)
#   elza3071  Elza ROOM3071: Birkin 0x30 aus CDEMD0 — Skript Set(1,0,0) @0x03430 vor Sce_em_set @0x03434 (Original g1)
#   leon5080  Leon ROOM5080: Birkin 0x30 aus CDEMD1 — Skript Set(1,0,1) @0x00742 (Original g2)
#   elza3091  Elza ROOM3091: Typ 0x42 (Sherry) aus CDEMD1 Sektor 1505 (Original g5 + Nutzer-Stand 11B1)
#   elza1101  Elza ROOM1111 -> Tuer Slot 0 -> ROOM1101: Zombies 0x11 (1111) und 0x10 (1101) aus CDEMD1 (Original g1)
#   leon1100  Gegenprobe Leon ROOM1110 -> Tuer -> ROOM1100: KEINE Elza-Archiv-Zeile, Leon-Weg unveraendert
set(_tag "r37_elzaems[${TEIL}]")
foreach(_v RE15_PC_EXE RE15_KARTE_TOOL WORKDIR TEIL)
    if(NOT ${_v})
        message(FATAL_ERROR "${_tag}: ${_v} fehlt")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")
string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_dir "${WORKDIR}/lauf_${TEIL}_${_lauf_id}")
file(MAKE_DIRECTORY "${_dir}")
# Messkopie unter eigenem Namen neben der exe (Asset-Wurzel = exe-Verzeichnis; Muster test_r34n_b_cursor.cmake).
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" EXT)
set(_exe "${_exe_dir}/re15_pc_r37n_${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

macro(fail)
    file(REMOVE "${_exe}")
    message(FATAL_ERROR "${_tag}: ${ARGN} (${_dir})")
endmacro()

macro(karte _raum _x _z _gier)
    execute_process(COMMAND "${RE15_KARTE_TOOL}" "re15_card.mcr" ${_raum} ${_x} ${_z} ${_gier}
                    WORKING_DIRECTORY "${_dir}" TIMEOUT 60 RESULT_VARIABLE _rvk OUTPUT_VARIABLE _outk)
    if(NOT _rvk EQUAL 0)
        fail("Kartenwerkzeug exit=${_rvk}: ${_outk}")
    endif()
endmacro()

macro(lauf _timeout)
    set(WORKDIR "${_dir}")
    re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    if("${_rv}" STREQUAL "1" OR "${_rv}" STREQUAL "-1" OR NOT EXISTS "${_dir}/debug.log")
        message(STATUS "${_tag}: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(REMOVE "${_dir}/debug.log")
        re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    endif()
    if(NOT EXISTS "${_dir}/debug.log")
        fail("kein debug.log (exit=${_rv})")
    endif()
endmacro()

macro(zeile_muss _regex _was)
    file(STRINGS "${_dir}/debug.log" _z REGEX "${_regex}")
    if(NOT _z)
        fail("${_was} fehlt (debug.log ohne '${_regex}')")
    endif()
    message(STATUS "${_tag}: ${_was}: ${_z}")
endmacro()

macro(zeile_nicht _regex _was)
    file(STRINGS "${_dir}/debug.log" _z REGEX "${_regex}")
    if(_z)
        fail("${_was}: ${_z}")
    endif()
endmacro()

set(_basis RE15_NO_INTRO=1 RE15_WINDOW_SCALE=1 RE15_NOAUDIO=1 RE15_ENEMY_DIAG=1
    RE15_CONTINUE_TEST=1 RE15_CARD_AUTO=1 RE15_CARD_SLOT=0)

if(TEIL STREQUAL "elza5081")
    karte(5081 -9950 -18200 2048)
    lauf(600 ${_basis} "RE15_EXIT_AT=150#5081")
    zeile_muss("PC loaded room5081" "ROOM5081 geladen")
    zeile_muss("\\[elzaems\\] Typ 0x30 aus EMD/CDEMD1.EMS Sektor 2015 \\(228460 B\\) crc 1145F206"
               "Birkin 0x30 aus dem Elza-Archiv (TOC @0x80073178, Sektor 2015)")
    zeile_nicht("Typ 0x30 aus EMD/CDEMD0" "Birkin faelschlich aus CDEMD0")
elseif(TEIL STREQUAL "elza3071")
    karte(3071 -25773 -12208 105)
    lauf(600 ${_basis} "RE15_EXIT_AT=150#3071")
    zeile_muss("PC loaded room3071" "ROOM3071 geladen")
    zeile_muss("\\[elzaems\\] Typ 0x30 aus EMD/CDEMD0.EMS Sektor 1261 \\(226404 B\\) .*Elza-Bit 0 beim Sce_em_set"
               "Birkin 0x30 aus dem Leon-Archiv (Skript Set(1,0,0) @0x03430)")
    zeile_nicht("Typ 0x30 aus EMD/CDEMD1" "Birkin faelschlich aus CDEMD1")
elseif(TEIL STREQUAL "leon5080")
    karte(5080 -9950 -18200 2048)
    lauf(600 ${_basis} "RE15_EXIT_AT=150#5080")
    zeile_muss("PC loaded room5080" "ROOM5080 geladen")
    zeile_muss("\\[elzaems\\] Typ 0x30 aus EMD/CDEMD1.EMS Sektor 2015 \\(228460 B\\) crc 1145F206"
               "Leons Birkin 0x30 aus CDEMD1 (Skript Set(1,0,1) @0x00742, Original g2)")
elseif(TEIL STREQUAL "elza3091")
    karte(3091 -24731 887 1024)
    lauf(600 ${_basis} "RE15_EXIT_AT=150#3091")
    zeile_muss("PC loaded room3091" "ROOM3091 geladen")
    zeile_muss("\\[elzaems\\] Typ 0x42 aus EMD/CDEMD1.EMS Sektor 1505 \\(144032 B\\) crc 91415329"
               "Typ 0x42 (Sherry) aus dem Elza-Archiv")
    zeile_muss("\\[elzaems\\] Typ 0x49 aus EMD/CDEMD1.EMS Sektor 1709 \\(137200 B\\) crc 285C67D3" "John 0x49 aus CDEMD1")
    zeile_muss("\\[enemy-diag\\] actor[0-9]+ type=0x42 model=enemy-bank" "Typ 0x42 zeichnet ueber die Gegner-Bank")
elseif(TEIL STREQUAL "elza1101")
    karte(1111 -3250 -4950 0)
    lauf(600 ${_basis} "RE15_FIRE_AOT=0@40#1111" "RE15_EXIT_AT=150#1101")
    zeile_muss("\\[fire-aot\\] slot=0 at F[0-9]+ \\(Raum 1111\\)" "Tuer Slot 0 in ROOM1111 genommen")
    zeile_muss("PC loaded room1101" "ROOM1101 ueber die Tuer betreten")
    zeile_muss("\\[elzaems\\] Typ 0x11 aus EMD/CDEMD1.EMS Sektor 105 \\(214592 B\\) crc 06E1989E" "Zombie 0x11 (1111) aus CDEMD1")
    zeile_muss("\\[elzaems\\] Typ 0x10 aus EMD/CDEMD1.EMS Sektor 0 \\(214816 B\\) crc AE292DA8" "Zombie 0x10 (1101) aus CDEMD1")
    zeile_nicht("Typ 0x1[01] aus EMD/CDEMD0" "Zombie faelschlich aus CDEMD0")
elseif(TEIL STREQUAL "leon1100")
    karte(1110 -3250 -4950 0)
    lauf(600 ${_basis} "RE15_FIRE_AOT=0@40#1110" "RE15_EXIT_AT=150#1100")
    zeile_muss("PC loaded room1100" "ROOM1100 ueber die Tuer betreten")
    zeile_muss("EM10 loaded" "Zombie-Bank EM10 geladen")
    zeile_nicht("\\[elzaems\\]" "Elza-Archiv-Zeile bei Leon")
    zeile_nicht("\\[roy\\]" "Roy-Zeile bei Leon")
else()
    fail("unbekannter TEIL")
endif()
file(REMOVE "${_exe}")
message(STATUS "${_tag}: OK")
