# =============================================================================
# Runde 38 Spur S "affen3" — die kleinen Affen (Typ 0x29) in Stage 3 treffen, gemessen an der ECHTEN exe.
#
# Nutzer (AUFTRAG.md Runde 38): "In Stage 3 die kleinen Affen koennen einen nicht treffen, es passiert nichts".
# Dossier analysis/befunde_runde38/S_affen3.md; Code engine/src/affen3_r38.c, include/re15_affen3_r38.h.
#
# Aufbau (so, wie der Nutzer auf die Affen trifft): ROOM3040 per Debug-Sprung (RE15_DEBUG_JUMP=3040@250), Leon
# auf der Plattform der Affen (Band 1, y = -1800) im Nordgang bei (-8800,-2400), Blick nach Sueden (Gier 1024);
# Affe A sieht ihn und wartet in Sub 3 an seiner Nische (-8707,-6082) wie im Original o2. Nach 5 s geht Leon
# 25 s lang geradeaus (RE15_INPUT_SCRIPT=W5,U25) auf den Affen zu. Zwei Laeufe:
#   std    Standard-KI (kein RE15_AI_FLAVOR = RE2-Flavor) — so spielt der Nutzer
#   re15   RE15_AI_FLAVOR=re15
# Geprueft im state.log NACH dem Raumsprung (Bildzaehler faellt zurueck):
#   - mindestens 12 HP-Abzuege in 1000 Bildern, JEDER genau -5 (STAGE3.BIN `addiu v0,v0,-5` @0x80111f60)
#   - im Treffer-Bild steht Affe Platz 1 (t=29) in Sub 5 (Biss) mit Clip 0x12 und Bild 12..15
#     (Fenster-Tabelle @0x8011ed48 = {12,13,14,15})
#   - im Folgebild flincht Leon mit dem Clip aus aca59 = a780(Spieler)+2 (@0x80111f80-94): a780 =
#     ((Spieler.Gier - Affe.Gier + 0x400) & 0xfff) < 0x800 (@0x8001a788-a4) -> 0: Clip 8 (vorn), 1: Clip 9
#     (Handler [2]/[3], re15_affen_biss_clip)
#   - TAKT + LAGE wie das Original o10 (DuckStation-GDB auf DEMSELBEN Weg: Leon (-8800,-2400) Band 1, Gier 1024, ab
#     Bild 143 Pad 0x1000 = hoch, eingespeist per Haltepunkt im Pad-Lauf @0x8003047c hinter `sw v0,DAT_800ac758`
#     @0x80030478; Dossier analysis/befunde_runde38/S_affen3.md): 15 Bisse F182, 238, ... 966, ALLE Abstaende 56 Bilder,
#     Treffer in Bild 14 (erster) bzw. 12; Affe A beim Treffer immer z = -6082 (Wand), x zuerst am Ost-Anschlag -8068
#     (Treffer 3..5), danach schiebt der gehende Leon ihn Biss fuer Biss nach Westen (-8312 -> -8685): Selbst-Schub
#     FUN_8002aec4(&Spieler, Affe) @0x80110b88 + Klemmen @0x80110ba0-cc. Geprueft: >= 10 Abstaende genau 56, jeder 50..61,
#     z = -6082 bei jedem Treffer, mindestens ein Treffer bei x = -8068 +-40 und der letzte >= 400 westlich davon.
#     (Die fruehere Erwartung "Gleichtakt 57 bei (-8297,-6082)" stammte aus o4 — dort STEHT Leon. Der Port ohne
#     Selbst-Schub erreichte sie im Gehen nur, weil der Affe nicht geschoben wurde; o10 zeigt das Original im Gehen.)
# Vorher (master cb782bda, derselbe Aufbau, dieselbe exe-Umgebung): 0 Abzuege — Dossier "Messung vorher" v1.
#
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DWORKDIR=<dir> -P test_r38_affen3.cmake
# =============================================================================
cmake_minimum_required(VERSION 3.16)   # Policies NEW (CMP0012/CMP0054/CMP0007) auch unter dem Container-CMake 3.28 im Skriptmodus wie auf dem Host (Memory reai-v2-linux-test-portabilitaet; Linux-Release v0.8.26)
set(_tag "r38_affen3")
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "${_tag}: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "${_tag}: WORKDIR fehlt")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_wurzel "${WORKDIR}/lauf_${_lauf_id}")
file(MAKE_DIRECTORY "${_wurzel}")

# Eigene Messkopie neben der exe (Asset-Wurzel = exe-Verzeichnis; nie taskkill /IM re15_pc.exe trifft sie).
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" LAST_EXT)
file(GLOB _alte_kopien "${_exe_dir}/re15_pc_r38s_haken_*")
foreach(_k IN LISTS _alte_kopien)
    file(REMOVE "${_k}")
endforeach()
set(_exe_kopie "${_exe_dir}/re15_pc_r38s_haken_${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe_kopie}")
set(RE15_PC_EXE "${_exe_kopie}")

function(r38s_lauf _lauf _flavor)
    set(_dir "${_wurzel}/${_lauf}")
    file(MAKE_DIRECTORY "${_dir}")
    set(WORKDIR "${_dir}")
    set(_st RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2)
    if(NOT _flavor STREQUAL "std")
        list(APPEND _st "RE15_AI_FLAVOR=${_flavor}")
    else()
        unset(ENV{RE15_AI_FLAVOR})
    endif()
    set(_env RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_SOFTWARE_RENDER=1 RE15_WINDOW_SCALE=1 ${_st}
             RE15_DEBUG_JUMP=3040@250 "RE15_PLAYER_POS=-8800,-2400,1024,1"
             RE15_INPUT_SCRIPT_START=250 "RE15_INPUT_SCRIPT=W5,U25"
             RE15_STATE_LOG=state.log "RE15_EXIT_AT=1000#3040")
    re15_start_spiel(_rv 400 ${_env} "${RE15_PC_EXE}")
    if(NOT _rv EQUAL 0)
        message(STATUS "${_tag} [${_lauf}]: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(REMOVE "${_dir}/debug.log" "${_dir}/state.log")
        re15_start_spiel(_rv 400 ${_env} "${RE15_PC_EXE}")
    endif()
    if(NOT _rv EQUAL 0)
        message(FATAL_ERROR "${_tag} [${_lauf}]: re15_pc exit=${_rv} (erwartet 0 bis RE15_EXIT_AT), ${_dir}")
    endif()
    foreach(_d debug.log state.log)
        if(NOT EXISTS "${_dir}/${_d}")
            message(FATAL_ERROR "${_tag} [${_lauf}]: kein ${_d} in ${_dir}")
        endif()
    endforeach()
    file(STRINGS "${_dir}/debug.log" _ex REGEX "\\[flow\\] EXIT_AT: ")
    if(NOT _ex)
        message(FATAL_ERROR "${_tag} [${_lauf}]: RE15_EXIT_AT nicht erreicht — Haenger?")
    endif()
    file(STRINGS "${_dir}/debug.log" _pp REGEX "RE15_PLAYER_POS \\(-8800,-2400\\) rot=1024 band=1")
    if(NOT _pp)
        message(FATAL_ERROR "${_tag} [${_lauf}]: Leon nicht auf die Plattform gesetzt (keine [parity]-Zeile)")
    endif()

    # ---- Auswertung ----
    file(STRINGS "${_dir}/state.log" _zl)
    set(_vorher -1)
    set(_nach 0)
    set(_hp_alt "")
    set(_treffer "")
    set(_bilder "")
    set(_affe_x "")
    set(_warte_clip "")
    set(_fehler "")
    foreach(_l IN LISTS _zl)
        if(NOT _l MATCHES "^F([0-9]+) .*PL\\((-?[0-9]+),(-?[0-9]+),rot=(-?[0-9]+),hp=(-?[0-9]+)\\) pst=[0-9]+ ps1=[0-9]+ ps2=[0-9]+ mo=([0-9]+) ")
            continue()
        endif()
        set(_f "${CMAKE_MATCH_1}")
        set(_prot "${CMAKE_MATCH_4}")
        set(_hp "${CMAKE_MATCH_5}")
        set(_pmo "${CMAKE_MATCH_6}")
        if(NOT _nach AND _vorher GREATER _f)
            set(_nach 1)
            set(_hp_alt "")
        endif()
        set(_vorher ${_f})
        if(NOT _nach)
            continue()
        endif()
        if(NOT _warte_clip STREQUAL "")
            if(NOT _pmo EQUAL _warte_clip)
                string(APPEND _fehler " F${_f}:Leon-Clip-${_pmo}(Soll-${_warte_clip})")
            endif()
            set(_warte_clip "")
        endif()
        if(NOT _hp_alt STREQUAL "" AND _hp LESS _hp_alt)
            math(EXPR _d "${_hp_alt} - ${_hp}")
            if(NOT _l MATCHES "\\[1 t=29 st=1 ss1=([0-9]+) ss2=[0-9]+ ss3=[0-9]+ g=[0-9a-f]+ mo=([0-9]+) af=([0-9]+) [^@]*@\\((-?[0-9]+),(-?[0-9]+),r(-?[0-9]+)\\)")
                string(APPEND _fehler " F${_f}:kein-Affe-Platz-1")
            else()
                set(_ss1 "${CMAKE_MATCH_1}")
                set(_mo "${CMAKE_MATCH_2}")
                set(_af "${CMAKE_MATCH_3}")
                set(_ax "${CMAKE_MATCH_4}")
                set(_az "${CMAKE_MATCH_5}")
                set(_ar "${CMAKE_MATCH_6}")
                if(NOT _ss1 EQUAL 5 OR NOT _mo EQUAL 18 OR _af LESS 12 OR _af GREATER 15)
                    string(APPEND _fehler " F${_f}:ss1=${_ss1},mo=${_mo},af=${_af}")
                endif()
                # a780 @0x8001a788-a4 -> aca59 = a780 + 2 -> Clip 8 (vorn) / 9 (hinten)
                math(EXPR _w "((${_prot} - ${_ar}) + 1024) & 4095")
                if(_w LESS 2048)
                    set(_soll_clip 9)
                else()
                    set(_soll_clip 8)
                endif()
                if(_hp GREATER -1)
                    set(_warte_clip ${_soll_clip})
                endif()
                list(APPEND _bilder "${_af}")
                list(APPEND _affe_x "${_ax}/${_az}")
            endif()
            if(NOT _d EQUAL 5)
                string(APPEND _fehler " F${_f}:dHP=${_d}")
            endif()
            list(APPEND _treffer "${_f}")
        endif()
        set(_hp_alt ${_hp})
    endforeach()
    list(LENGTH _treffer _nt)
    # Abstaende (Takt 56 wie Original o10) + Lage des Affen beim Treffer (Wand z = -6082, Ost-Anschlag -8068, Drift West)
    set(_abst "")
    set(_alt "")
    set(_n56 0)
    foreach(_t IN LISTS _treffer)
        if(NOT _alt STREQUAL "")
            math(EXPR _a "${_t} - ${_alt}")
            list(APPEND _abst ${_a})
            if(_a LESS 50 OR _a GREATER 61)
                string(APPEND _fehler " Abstand ${_a}(Soll 50..61)")
            endif()
            if(_a EQUAL 56)
                math(EXPR _n56 "${_n56} + 1")
            endif()
        endif()
        set(_alt ${_t})
    endforeach()
    set(_anschlag "")
    set(_letzt_x "")
    foreach(_lage IN LISTS _affe_x)
        string(REPLACE "/" ";" _lage_l "${_lage}")
        list(GET _lage_l 0 _lx)
        list(GET _lage_l 1 _lz)
        if(NOT _lz EQUAL -6082)
            string(APPEND _fehler " Affe-z=${_lz}(Soll -6082)")
        endif()
        math(EXPR _dx "${_lx} + 8068")
        if(_anschlag STREQUAL "" AND _dx GREATER -41 AND _dx LESS 41)
            set(_anschlag ${_lx})
        endif()
        set(_letzt_x ${_lx})
    endforeach()
    message(STATUS "${_tag} [${_lauf}]: ${_nt} Treffer in Bild ${_treffer}; Abstaende ${_abst}; Clip-Bilder ${_bilder}; "
                   "Affe ${_affe_x}; Abstaende 56: ${_n56}; Ost-Anschlag ${_anschlag}, letzter Treffer x ${_letzt_x}")
    if(_nt LESS 12)
        message(FATAL_ERROR "${_tag} [${_lauf}]: nur ${_nt} Treffer (Soll >= 12 in 1000 Bildern; Original o10: 15, alle 56 Bilder)")
    endif()
    if(_n56 LESS 10)
        message(FATAL_ERROR "${_tag} [${_lauf}]: Takt wie Original o10 fehlt (${_n56} Abstaende von genau 56 Bildern, Soll >= 10; o10: 14 von 14)")
    endif()
    if(_anschlag STREQUAL "")
        message(FATAL_ERROR "${_tag} [${_lauf}]: kein Treffer am Ost-Anschlag x = -8068 +-40 (Original o10: Treffer 3..5 bei -8068)")
    endif()
    math(EXPR _drift "${_anschlag} - ${_letzt_x}")
    if(_drift LESS 400)
        message(FATAL_ERROR "${_tag} [${_lauf}]: Affe nicht nach Westen geschoben (Anschlag ${_anschlag} -> letzter Treffer ${_letzt_x} = ${_drift}, Soll >= 400; o10: -8068 -> -8685; Selbst-Schub FUN_8002aec4 @0x80110b88)")
    endif()
    if(NOT _fehler STREQUAL "")
        message(FATAL_ERROR "${_tag} [${_lauf}]: Abweichungen:${_fehler}")
    endif()
endfunction()

r38s_lauf(std std)
r38s_lauf(re15 re15)
file(REMOVE "${_exe_kopie}")
message(STATUS "${_tag}: OK (Standard-KI und RE1.5-KI: Bisse treffen mit -5 im Takt des Originals o10, Leon flincht, Affe wird geschoben)")
