# =============================================================================
# FUNKSZENE ROOM10F1 MIT DER ECHTEN EXE (Runde 39, Spur I "funk10f1").
#
# Nutzer (analysis/befunde_runde39/AUFTRAG.md): "In Room 10F1 möchte ich, das wenn Elza ihn betritt eine Cutscene läuft wo
# sie Rechts zum Kommunikationssystem geht und von der Animation her drauf drückt und sagt "Hello, anyone, can you hear me?
# We Need help!" / Dann kommt "..." / Dann "Uhh, this Thing is broken!". / Suche die dir passenden Animationen dafür heraus."
# Dossier analysis/befunde_runde39/I_funk10f1.md, Code engine/src/funk10f1_r39.c, include/re15_funk10f1_r39.h.
#
# TEIL (je ein ctest-Eintrag):
#   echt   ECHTER WEG: Elza (RE15_TITLE_SHOT_CHAR=1) in ROOM10D1, Kartenleser-Tuer offen ((3,50) = ROOM10D1 main00
#          @0x01026 Ck(3,0x32) -> Door_aot_set Slot 0 @0x01174), Tuer per Aot-Druck (RE15_FIRE_AOT, derselbe Pfad wie
#          Hineinlaufen) -> RE2-Tuersequenz -> ROOM10F1 -> Szene: Weg nach RECHTS (Gierung zwischen 2048 und 3072), Plc_dest-
#          Folge, Druck (Motion 11, Clip 11) WAEHREND msg 40 an der Konsole (Cut 1, Blick Osten), Senken (Motion 0
#          rueckwaerts), msg 41 + Huefte (9), msg 42 + Stirn (12), Stimme je Zeile (Stellvertreter-Datei main40.wav im
#          Laufordner -> "clip loaded"; 41/42 ohne Datei -> "keine Aufnahme" oder, wenn der Nutzer sie ablegt, "clip loaded"),
#          danach Spieler frei; ZWEITES BETRETEN (RE15_DEBUG_JUMP=10f1@800, Raum neu aufgebaut): keine Szene.
#   zweit  ECHTER WEG mit (9,70) = 1 (Szene schon gesehen): Tuer -> ROOM10F1 ohne Szene, ohne Leihe, Spieler frei.
#   leon   Leon ROOM10F0 (dieselbe RDT, Runde-35-Szene schon gesehen (9,71)): keine Funkszene, (9,70) unberuehrt.
#
# Parallel-/Linux-fest: exe-Kopie mit eigenem Praefix je TEIL, eigener Laufordner je Lauf, Umgebung nur ueber
# re15_start_spiel (spiel_lauf.cmake), keine .exe-/Backslash-Pfade.
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DRE15_SYNCHRO_DIR=<repo>/synchro -DWORKDIR=<dir> -DTEIL=<teil> -P <diese Datei>
# =============================================================================
cmake_minimum_required(VERSION 3.16)
foreach(_v RE15_PC_EXE RE15_SYNCHRO_DIR WORKDIR TEIL)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "r39_funk10f1: ${_v} fehlt")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

set(_tag "r39_funk10f1[${TEIL}]")
string(RANDOM LENGTH 6 ALPHABET "0123456789abcdef" _lauf_id)
set(_basisdir "${WORKDIR}_${TEIL}")
file(MAKE_DIRECTORY "${_basisdir}")
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" EXT)
set(_exe "${_exe_dir}/re15_pc_r39funk_${TEIL}_${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

set(_fehler "")
macro(fail _text)
    list(APPEND _fehler "${_text}")
    message(STATUS "FAIL ${_tag}: ${_text}")
endmacro()
macro(ok _text)
    message(STATUS "ok   ${_tag}: ${_text}")
endmacro()

# Ein Lauf im eigenen Ordner: exe starten, debug.log lesen (-> _dbg), Ordner -> _dir.
function(lauf _name _timeout)
    set(WORKDIR "${_basisdir}/${_name}_${_lauf_id}")
    file(REMOVE_RECURSE "${WORKDIR}")
    file(MAKE_DIRECTORY "${WORKDIR}")
    if(_name STREQUAL "echt")
        # Stellvertreter-Aufnahme fuer msg 40 (Elzas eigene Stimme "Hey, is anyone here?!", synchro/STAGE1/room1031/
        # main19.wav) im LAUFORDNER: die Sprach-Wurzelliste (asset_root_pc.c) nimmt das Arbeitsverzeichnis mit, sobald
        # es ein synchro/ traegt — so wird der Weg "Datei da = sie spielt" an genau dieser Zeile gemessen.
        file(MAKE_DIRECTORY "${WORKDIR}/synchro/STAGE1/room10F1")
        file(COPY_FILE "${RE15_SYNCHRO_DIR}/STAGE1/room1031/main19.wav" "${WORKDIR}/synchro/STAGE1/room10F1/main40.wav")
    endif()
    re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    if(NOT EXISTS "${WORKDIR}/debug.log")
        file(REMOVE "${_exe}")
        message(FATAL_ERROR "${_tag}/${_name}: kein debug.log (exit=${_rv}, ${WORKDIR})")
    endif()
    file(READ "${WORKDIR}/debug.log" _d)
    set(_dbg "${_d}" PARENT_SCOPE)
    set(_dir "${WORKDIR}" PARENT_SCOPE)
    message(STATUS "${_tag}/${_name}: exit=${_rv}, ${WORKDIR}")
endfunction()

# Position (Zeichen) des ERSTEN Vorkommens ab _ab, sonst -1.
function(finde_ab _text _muster _ab _out)
    string(LENGTH "${_text}" _n)
    if(_ab LESS 0 OR _ab GREATER_EQUAL _n)
        set(${_out} -1 PARENT_SCOPE)
        return()
    endif()
    string(SUBSTRING "${_text}" ${_ab} -1 _rest)
    string(FIND "${_rest}" "${_muster}" _p)
    if(_p LESS 0)
        set(${_out} -1 PARENT_SCOPE)
    else()
        math(EXPR _p "${_p} + ${_ab}")
        set(${_out} ${_p} PARENT_SCOPE)
    endif()
endfunction()

# state.txt in Abschnitte je Raumbesuch zerlegen (Bildzaehler faellt beim Raumwechsel auf 0/1): -> Liste _segN.
function(abschnitte _datei _anzahl_out)
    file(STRINGS "${_datei}" _zeilen)
    set(_seg 0)
    set(_prev -1)
    set(_seg0 "")
    foreach(_z IN LISTS _zeilen)
        if(_z MATCHES "^F([0-9]+) ")
            set(_f ${CMAKE_MATCH_1})
            if(_f LESS _prev)
                math(EXPR _seg "${_seg} + 1")
                set(_seg${_seg} "")
            endif()
            set(_prev ${_f})
            list(APPEND _seg${_seg} "${_z}")
        endif()
    endforeach()
    math(EXPR _n "${_seg} + 1")
    foreach(_i RANGE ${_seg})
        set(_seg${_i} "${_seg${_i}}" PARENT_SCOPE)
    endforeach()
    set(${_anzahl_out} ${_n} PARENT_SCOPE)
endfunction()

# ------------------------------------------------------------------------------------------------------------------
if(TEIL STREQUAL "echt")
    lauf(echt 600
         RE15_NO_INTRO=1 SDL_AUDIODRIVER=dummy RE15_WINDOW_SCALE=1
         RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2 RE15_TITLE_SHOT_CHAR=1
         RE15_GOTO_ROOM=10D1 "RE15_SET_FLAG=3:50" "RE15_FIRE_AOT=0@40#10d1"
         "RE15_DEBUG_JUMP=10f1@800" "RE15_EXIT_AT=860#10f1"
         RE15_AUDIO_CAP_SYNC=cap.raw RE15_MSG_LOG=1
         RE15_STATE_LOG=state.txt RE15_ANIM_TRACE=anim.txt
         RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=600 "RE15_INPUT_SCRIPT=D1")
    # 1. Elza, echte Tuer, Raum geladen
    foreach(_m "[pl] Spieler-Familie PL04" "[fire-aot] slot=0 at F40 (Raum 10D1)" "[tuer] Sequenz" "loaded room10f1.rdt")
        string(FIND "${_dbg}" "${_m}" _p)
        if(_p LESS 0)
            fail("Zeile fehlt: '${_m}'")
        endif()
    endforeach()
    string(FIND "${_dbg}" "[tuer] Sequenz" _p_tuer)
    string(FIND "${_dbg}" "loaded room10f1.rdt" _p_raum)
    if(_p_tuer GREATER -1 AND _p_raum GREATER _p_tuer)
        ok("echte Tuer ROOM10D1 -> ROOM10F1 (RE2-Tuersequenz vor dem Raumladen)")
    else()
        fail("ROOM10F1 nicht ueber die Tuersequenz betreten")
    endif()
    # 2. Szene genau einmal, Leihe
    string(REGEX MATCHALL "\\[funk10f1\\] F[0-9]+ ROOM10F1: Funkszene gestartet \\(Ereignis 27" _starts "${_dbg}")
    list(LENGTH _starts _n_starts)
    string(FIND "${_dbg}" "[rbj] Animationsblock von ROOM1031 geliehen (26760 B, Runde 39 Spur I)" _p_leihe)
    if(_n_starts EQUAL 1 AND _p_leihe GREATER -1)
        ok("Funkszene genau einmal gestartet, Gestenblock ROOM1031 geliehen")
    else()
        fail("Szenenstart ${_n_starts}x (Soll 1), Leihe @${_p_leihe}")
    endif()
    # 3. Weg: Plc_dest-Folge drehen/gehen/gehen/gehen/drehen in dieser Reihenfolge
    set(_ab 0)
    set(_weg_ok 1)
    foreach(_m "mode=0x09 dest=(6250,2900) flag=32" "mode=0x04 dest=(6250,2900) flag=32" "mode=0x04 dest=(6250,5900) flag=32"
               "mode=0x04 dest=(6900,6400) flag=32" "mode=0x09 dest=(7400,6400) flag=32")
        finde_ab("${_dbg}" "[scd] Plc_dest(slot=0 ${_m})" ${_ab} _p)
        if(_p LESS 0)
            set(_weg_ok 0)
            fail("Plc_dest fehlt/Reihenfolge: ${_m}")
            break()
        endif()
        math(EXPR _ab "${_p} + 1")
    endforeach()
    if(_weg_ok)
        ok("Weg: drehen -> (6250,2900) -> (6250,5900) -> (6900,6400) -> zur Konsole (7400,6400) drehen")
    endif()
    # 4. Nachrichten 40 -> 41 -> 42 woertlich, Stimme je Zeile
    set(_ab 0)
    foreach(_id 40 41 42)
        if(_id EQUAL 40)
            set(_t "Elza: Hello, anyone, can you hear me? We Need help!")
        elseif(_id EQUAL 41)
            set(_t "Elza: ...")
        else()
            set(_t "Elza: Uhh, this Thing is broken!")
        endif()
        finde_ab("${_dbg}" "[msgtext] room=10f1 id=${_id} \"${_t}\"" ${_ab} _p)
        if(_p LESS 0)
            fail("msg ${_id} fehlt/Reihenfolge: '${_t}'")
            break()
        endif()
        math(EXPR _ab "${_p} + 1")
        finde_ab("${_dbg}" "[voice] clip loaded: main${_id}.wav" ${_ab} _pv)
        finde_ab("${_dbg}" "[voice] ROOM10F1 msg ${_id}: keine Aufnahme" ${_ab} _pk)
        finde_ab("${_dbg}" "[msgtext] room=10f1 id=" ${_ab} _pn)
        if(_pn LESS 0)
            string(LENGTH "${_dbg}" _pn)
        endif()
        if(_id EQUAL 40)
            if(_pv GREATER -1 AND _pv LESS _pn)
                ok("msg 40 woertlich, Stimme gespielt (Stellvertreter main40.wav im Laufordner)")
            else()
                fail("msg 40: keine Stimme geladen (clip loaded main40.wav)")
            endif()
        elseif((_pv GREATER -1 AND _pv LESS _pn) OR (_pk GREATER -1 AND _pk LESS _pn))
            ok("msg ${_id} woertlich, Stimme angefordert (synchro/STAGE1/room10F1/main${_id}.wav)")
        else()
            fail("msg ${_id}: keine Sprachanforderung")
        endif()
    endforeach()
    # 5. Gesten (ANIM_TRACE Spieler = Akteur 0, erster Besuch): 11 -> 0 rueckwaerts -> 9 -> 12
    file(STRINGS "${_dir}/anim.txt" _anim)
    set(_soll "11:11:0;0:0:1;9:9:0;12:12:0")
    set(_k 0)
    list(LENGTH _soll _n_soll)
    string(REPLACE ";" "|" _dummy "${_soll}")
    set(_gesten "")
    foreach(_z IN LISTS _anim)
        if(_z MATCHES "^[0-9]+ 0 [-0-9]+ ([0-9]+) ([0-9]+) [0-9]+ [0-9]+ [-0-9]+ [-0-9]+ [01] ([01])")
            set(_g "${CMAKE_MATCH_1}:${CMAKE_MATCH_2}:${CMAKE_MATCH_3}")
            list(LENGTH _gesten _ng)
            if(_ng EQUAL 0)
                list(APPEND _gesten "${_g}")
            else()
                list(GET _gesten -1 _letzte)
                if(NOT _letzte STREQUAL _g)
                    list(APPEND _gesten "${_g}")
                endif()
            endif()
        endif()
    endforeach()
    set(_j 0)
    foreach(_g IN LISTS _gesten)
        if(_j LESS 4)
            list(GET _soll ${_j} _s)
            if(_g STREQUAL _s)
                math(EXPR _j "${_j} + 1")
            endif()
        endif()
    endforeach()
    if(_j EQUAL 4)
        ok("Gesten Motion:Clip:rueckwaerts 11:11:0 (Druck) -> 0:0:1 (Senken) -> 9:9:0 (Huefte) -> 12:12:0 (Stirn)")
    else()
        fail("Gestenfolge unvollstaendig (${_j}/4): ${_gesten}")
    endif()
    # 6. state.txt: Abschnitt 3 = erster Besuch ROOM10F1, Abschnitt 4 = zweites Betreten
    abschnitte("${_dir}/state.txt" _nseg)
    if(NOT _nseg EQUAL 4)
        fail("state.txt: ${_nseg} Raumabschnitte statt 4 (Startraum, 10D1, 10F1, 10F1 nach dem Sprung)")
    else()
        set(_druck 0)
        set(_druck_ort "")
        set(_rechts -1)
        set(_ende42 0)
        set(_frei_nach 0)
        set(_x_vor "")
        set(_x_nach "")
        foreach(_z IN LISTS _seg2)
            # Pad nach der Szene: Skript "D1" ab Bild 600 (Schritt zurueck, Blick Osten -> x faellt)
            if(_z MATCHES "^F59[0-9] .*PL\\((-?[0-9]+),")
                set(_x_vor ${CMAKE_MATCH_1})
            endif()
            if(_z MATCHES "^F64[0-9] .*PL\\((-?[0-9]+),")
                set(_x_nach ${CMAKE_MATCH_1})
            endif()
            if(_rechts EQUAL -1 AND _z MATCHES "PL\\((-?[0-9]+),(-?[0-9]+),rot=([0-9]+),.* mo=105 ")
                if(${CMAKE_MATCH_2} GREATER -300)
                    set(_rechts ${CMAKE_MATCH_3})
                endif()
            endif()
            if(_z MATCHES "PL\\((-?[0-9]+),(-?[0-9]+),rot=([0-9]+),.* mo=11 .* cam=1 msg\\(a=1 fsm=[0-9]+ id=40 ")
                set(_x ${CMAKE_MATCH_1})
                set(_zz ${CMAKE_MATCH_2})
                set(_r ${CMAKE_MATCH_3})
                if(_x GREATER 6400 AND _x LESS 7000 AND _zz GREATER 5768 AND _zz LESS 7032 AND (_r LESS 128 OR _r GREATER 3968))
                    math(EXPR _druck "${_druck} + 1")
                    set(_druck_ort "(${_x},${_zz}) rot ${_r}")
                endif()
            endif()
            if(_z MATCHES "msg\\(a=1 fsm=[0-9]+ id=42 ")
                set(_ende42 1)
                set(_frei_nach 0)
            elseif(_ende42 AND _z MATCHES " pm=0 ")
                set(_frei_nach 1)
            endif()
        endforeach()
        if(_rechts GREATER 2448 AND _rechts LESS 3072)
            ok("Elza dreht nach RECHTS: erste Gehgierung ${_rechts} zwischen 2048 (Eintritt, -X) und 3072 (+Z)")
        else()
            fail("erste Gehgierung ${_rechts} nicht rechts vom Eintritt (Soll 2448..3072)")
        endif()
        if(_druck GREATER 59)
            ok("Druck an der Konsole waehrend msg 40: ${_druck} Bilder Motion 11, ${_druck_ort}, Kamera Cut 1")
        else()
            fail("Druck waehrend msg 40 an der Konsole nur ${_druck} Bilder (Soll >= 60)")
        endif()
        if(_frei_nach)
            ok("nach msg 42 Spieler frei (pm=0) vor dem zweiten Betreten")
        else()
            fail("nach msg 42 kein freier Spieler (pm=0) im ersten Besuch")
        endif()
        if(NOT "${_x_vor}" STREQUAL "" AND NOT "${_x_nach}" STREQUAL "" AND _x_nach LESS _x_vor)
            math(EXPR _dx "${_x_vor} - ${_x_nach}")
            if(_dx GREATER 100)
                ok("Pad wirkt nach der Szene: Schritt zurueck x ${_x_vor} -> ${_x_nach} (Bild 59x -> 64x)")
            else()
                fail("Pad nach der Szene: Schritt zurueck nur ${_dx} (x ${_x_vor} -> ${_x_nach})")
            endif()
        else()
            fail("Pad nach der Szene wirkungslos: x '${_x_vor}' -> '${_x_nach}' (Bild 59x -> 64x)")
        endif()
        # zweites Betreten: nichts von der Szene
        set(_szene2 0)
        set(_frei2 0)
        foreach(_z IN LISTS _seg3)
            if(_z MATCHES "^F([0-9]+) ")
                if(${CMAKE_MATCH_1} GREATER_EQUAL 600)
                    break()     # ab Bild 600 laeuft das Pad-Skript (Schritt zurueck), nicht die Szene
                endif()
            endif()
            if(_z MATCHES " mo=(105|11) " OR _z MATCHES "msg\\(a=1 ")
                math(EXPR _szene2 "${_szene2} + 1")
            endif()
            if(_z MATCHES " pm=0 ")
                set(_frei2 1)
            endif()
        endforeach()
        if(_szene2 EQUAL 0 AND _frei2)
            ok("zweites Betreten: kein Gang, kein Druck, keine Nachricht, Spieler frei")
        else()
            fail("zweites Betreten: ${_szene2} Szenen-Zeilen, frei=${_frei2}")
        endif()
    endif()
    string(FIND "${_dbg}" "[debug-menu] AUTO-JUMP -> ROOM10F1" _p_jump)
    if(_p_jump LESS 0)
        fail("zweites Betreten (AUTO-JUMP -> ROOM10F1) nicht erreicht")
    else()
        string(SUBSTRING "${_dbg}" ${_p_jump} -1 _nach)
        set(_rest_ok 1)
        foreach(_m "[funk10f1]" "Plc_dest(slot=0" "[msgtext] room=10f1 id=40" "[msgtext] room=10f1 id=41"
                   "[msgtext] room=10f1 id=42" "Animationsblock von ROOM1031")
            string(FIND "${_nach}" "${_m}" _p)
            if(_p GREATER -1)
                set(_rest_ok 0)
                fail("nach dem zweiten Betreten: '${_m}'")
            endif()
        endforeach()
        if(_rest_ok)
            ok("zweites Betreten (Raum neu aufgebaut, (9,70)=1): keine Funkszene, keine Leihe")
        endif()
    endif()

elseif(TEIL STREQUAL "zweit")
    lauf(zweit 300
         RE15_NO_INTRO=1 RE15_NOAUDIO=1 SDL_AUDIODRIVER=dummy RE15_WINDOW_SCALE=1
         RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2 RE15_TITLE_SHOT_CHAR=1
         RE15_GOTO_ROOM=10D1 "RE15_SET_FLAG=3:50,9:70" "RE15_FIRE_AOT=0@40#10d1"
         "RE15_EXIT_AT=200#10f1" RE15_MSG_LOG=1 RE15_STATE_LOG=state.txt)
    foreach(_m "[pl] Spieler-Familie PL04" "[tuer] Sequenz" "loaded room10f1.rdt" "[rbj] room 10F1 has no RBJ")
        string(FIND "${_dbg}" "${_m}" _p)
        if(_p LESS 0)
            fail("Zeile fehlt: '${_m}'")
        endif()
    endforeach()
    set(_z_ok 1)
    foreach(_m "[funk10f1]" "Plc_dest(slot=0" "[msgtext] room=10f1 id=4" "Animationsblock von ROOM1031")
        string(FIND "${_dbg}" "${_m}" _p)
        if(_p GREATER -1)
            set(_z_ok 0)
            fail("(9,70)=1 und trotzdem: '${_m}'")
        endif()
    endforeach()
    abschnitte("${_dir}/state.txt" _nseg)
    math(EXPR _letzt "${_nseg} - 1")
    set(_frei 0)
    set(_szene 0)
    foreach(_z IN LISTS _seg${_letzt})
        if(_z MATCHES " pm=0 ")
            set(_frei 1)
        endif()
        if(_z MATCHES " mo=(105|11) " OR _z MATCHES "msg\\(a=1 " OR _z MATCHES " pm=2 ")
            math(EXPR _szene "${_szene} + 1")
        endif()
    endforeach()
    if(_z_ok AND _frei AND _szene EQUAL 0)
        ok("echte Tuer mit (9,70)=1: keine Funkszene, keine Leihe, Spieler frei")
    else()
        fail("zweites Betreten durch die Tuer: frei=${_frei}, Szenen-Zeilen ${_szene}")
    endif()

elseif(TEIL STREQUAL "leon")
    lauf(leon 300
         RE15_NO_INTRO=1 RE15_NOAUDIO=1 SDL_AUDIODRIVER=dummy RE15_WINDOW_SCALE=1
         RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2
         RE15_GOTO_ROOM=10F0 "RE15_SET_FLAG=9:71" "RE15_EXIT_AT=200#10f0" RE15_MSG_LOG=1)
    foreach(_m "loaded room10f0.rdt")
        string(FIND "${_dbg}" "${_m}" _p)
        if(_p LESS 0)
            fail("Zeile fehlt: '${_m}'")
        endif()
    endforeach()
    set(_l_ok 1)
    foreach(_m "[funk10f1]" "Animationsblock von ROOM1031" "[msgtext] room=10f0 id=40" "[msgtext] room=10f0 id=41"
               "[msgtext] room=10f0 id=42" "Spieler-Familie PL04")
        string(FIND "${_dbg}" "${_m}" _p)
        if(_p GREATER -1)
            set(_l_ok 0)
            fail("Leon ROOM10F0: '${_m}'")
        endif()
    endforeach()
    if(_l_ok)
        ok("Leon ROOM10F0 unveraendert: keine Funkszene, keine Leihe von ROOM1031")
    endif()
else()
    message(FATAL_ERROR "r39_funk10f1: unbekannter TEIL ${TEIL}")
endif()

file(REMOVE "${_exe}")
list(LENGTH _fehler _nf)
if(_nf GREATER 0)
    string(REPLACE ";" "\n  " _f "${_fehler}")
    message(FATAL_ERROR "${_tag}: ${_nf} Befund(e):\n  ${_f}")
endif()
message(STATUS "${_tag}: OK")
