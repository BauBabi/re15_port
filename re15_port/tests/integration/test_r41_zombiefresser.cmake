# =============================================================================
# RUNDE 41 SPUR I (zombiefresser) — die 0x84/0x85-Zombies LIEGEN und stehen auf, wenn man naeher kommt. ECHTE EXE.
#
# Dossier analysis/befunde_runde41/I_zombiefresser.md. Original (RE1.5 STAGE2): Tor 0x80 @0x80100b44, Pose 0x0c
# @0x80100b74 + f314 @0x80100c34, FINAL +0x94 = 0x12 @0x80100c7c; Wecker @0x80103814 (d < 0xfa0 @0x8010382c, +0x9c =
# rand&0xf @0x80103858-60), Phasenmaschine @0x801038ec (P2 Aufstehen @0x801039a8, P3 0x201 @0x801039e0). DuckStation:
# I_belege/orig_2000_wecker_film.txt.
#
# TEIL (je ein Lauf, eigene Messkopie re15_pc_r41i_<TEIL>, eigener Laufordner):
#   tuer2000   ECHTER WEG: Debug-Sprung 2070, Wegplan (RE15_WEGPLAN, engine/src/dachkiste_r36.c) durch die Tuer
#              nach ROOM2000 und auf den Oststeg (-20600,-10600) vor die beiden Kanal-Zombies (Muster
#              test_r38_wasserzombie.cmake Teil e). Leon, Standard-KI (RE2).
#   elza2001   ECHTER WEG als Elza: Debug-Sprung 2071 (Titel-Autostart Elza, RE15_TITLE_SHOT_CHAR=1), Spawn-Bit 3:0x45
#              (sub00 @0x01826, RE15_SET_FLAG; Bank 3 bleibt beim Raumwechsel stehen), Wegplan durch die Tuer nach
#              ROOM2001 auf den Oststeg. (Den LADE-Weg 2000/2001 pruefen laden2000/laden2001 — bis Nachbesserung 1
#              hielt der Boot-Pfad in platform/pc/main.c sub00 zurueck, sobald main00 einen Ereignis-Thread startete,
#              2000/2001 main00 `Evt_exec` @0x0177c; jetzt nur noch fuer den 1170-Erzaehler.)
#   leon3000   Spielstand Leon ROOM3000 (4:9 main00 @0x014b6, 4:0xC6 = Marvin-Szene aus) + CONTINUE, 1200 vor (-9900,-14800).
#   leon3010   Spielstand Leon ROOM3010 (4:0x0A main00 @0x0210e) + CONTINUE, 1100 vor (-9100,-19800).
#   re15_3000  wie leon3000, RE15_AI_FLAVOR=re15 (RE1.5-Liege-Phasenmaschine, Aufsteh-Clip 0x12), Kamera 3 + POSE-Pruefung.
#   NACHBESSERUNG 1 (Abnahme 0):
#   laden2000  LADE-Weg (I-E2): Spielstand Leon IN ROOM2000 auf dem Oststeg (-20600,-10600) Band 1, Kamera 7 + CONTINUE.
#              Original: FUN_8003ef6c startet sub00 IMMER (Slot 1 @0x8003efd4-d8), der LADE-Weg laeuft ueber denselben
#              Raumlader (@0x8001d5ac jal 0x800396fc -> @0x80039a00 jal 0x8003ef6c). Geprueft zusaetzlich: sub00 startet
#              (debug.log "thread start slot=1" nach dem CONTINUE), beide 0x84 INIT (Spawns sub00 @0x017cc/@0x017e0).
#   laden2001  dasselbe als ELZA in ROOM2001 (Spielstand Figur 4, Spawn-Bit 3:0x45 sub00 @0x01826), Kamera 7.
#   re15_2000  wie laden2000 mit RE15_AI_FLAVOR=re15 + POSE-Pruefung (Kanal-Zombies klettern erst hoch: Endbild 600).
# POSE-Pruefung (M1, RE15_POSE_DUMP, Zeilen "[pose] F slot ss1 mo af frac kf" = was der Renderer posiert): jeder Liegende
#   (erste Zeile ss1=0, mo 18/19 = +0x94 0x12/0x13, Bild 0) zeigt bis zu seinem ersten P2-anim_set Keyframe 301 (0x12d,
#   Clip 0x0c Bild 0) bzw. 329 (0x149, Clip 0x0e) — INIT-f314 @0x80100c34, FINAL +0x94 ohne f314 @0x80100c7c/cc0; das
#   erste P2-Bild ist Keyframe 400/450 (Clip 0x12/0x13 Bild 0) mit Bild 0 und +0x8f 15 (P2 @0x801039a8, +0x8f
#   @0x80103998), genau einen Takt nach dem P2-SAAT des zf.log (P1 kehrt ohne anim_set zurueck @0x80103994).
# Geprueft (RE15_ZOMBIEFRESSER_LOG + RE15_STATE_LOG):
#   - INIT der 0x84/0x85: RE2 "Wort=1/7/0 f10e=4002" (EXEC[7] liegend); RE1.5 liegt mit grid 84/85, Sub 0
#   - WECKT nur mit d < 4000; "STEHT AUF" 0..16 Bilder nach dem WECKT desselben Slots (Wartezeit rand&0xf)
#   - der geweckte Zombie steht danach aufrecht (RE2 st=1 ss1=1 g=00, RE1.5 st=1 ss1=2 g=00)
#   - danach Angriff: Spieler gegriffen (gr=1) oder Spieler-HP sinkt
#   - KEIN Zombie frisst je (st=1 ss1=8 = RE2-EXEC[8]); jeder Zombie mit grid 84/85 liegt (RE2 ss1=7, RE1.5 ss1=0)
# Parallel-/Linux-fest: Messkopie mit eigenem Namen, eigener Laufordner, geerbte RE15_*-Umgebung geloescht, keine
# .exe-/Backslash-Pfade.
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DRE15_KARTE_TOOL=<probe_r41_zombiefresser_karte> -DWORKDIR=<dir> -DTEIL=<teil> -P ...
# =============================================================================
cmake_minimum_required(VERSION 3.16)
foreach(_v RE15_PC_EXE RE15_KARTE_TOOL WORKDIR TEIL)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "r41_zombiefresser: ${_v} fehlt")
    endif()
endforeach()
if(NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "r41_zombiefresser: RE15_PC_EXE fehlt: '${RE15_PC_EXE}'")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

# Keine Umgebungsvariablen des Aufrufers erben (Muster test_r39_elzazombies.cmake).
function(r41i_geerbte_namen _out)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE _envdump)
    string(REGEX MATCHALL "(^|\n)[Rr][Ee]15_[A-Za-z0-9_]*=" _treffer "${_envdump}")
    set(_namen "")
    foreach(_t IN LISTS _treffer)
        string(REGEX REPLACE "^\n?([Rr][Ee]15_[A-Za-z0-9_]*)=$" "\\1" _n "${_t}")
        list(APPEND _namen "${_n}")
    endforeach()
    set(${_out} "${_namen}" PARENT_SCOPE)
endfunction()
r41i_geerbte_namen(_geerbt)
foreach(_n IN LISTS _geerbt)
    unset(ENV{${_n}})
endforeach()
r41i_geerbte_namen(_rest)
if(_rest)
    message(FATAL_ERROR "r41_zombiefresser[${TEIL}]: geerbte Umgebung laesst sich nicht loeschen: ${_rest}")
endif()

set(_tag "r41_zombiefresser[${TEIL}]")
string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(WORKDIR "${WORKDIR}/${TEIL}_${_lauf_id}")
file(MAKE_DIRECTORY "${WORKDIR}")
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
get_filename_component(_exe_ext "${RE15_PC_EXE}" EXT)
file(GLOB _alte "${_exe_dir}/re15_pc_r41i_${TEIL}_*")
foreach(_k IN LISTS _alte)
    file(REMOVE "${_k}")
endforeach()
set(_exe "${_exe_dir}/re15_pc_r41i_${TEIL}_${_lauf_id}${_exe_ext}")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

# ---- Lauf je TEIL ------------------------------------------------------------------------------------------------
set(_re2 1)
set(_ki "")
set(_pose 0)          # NB1: POSE-Pruefung (RE15_POSE_DUMP)
set(_laden 0)         # NB1: LADE-Weg-Pruefung (sub00 startet nach dem CONTINUE)
set(_n_init_soll 0)   # NB1: genaue Zahl der INIT-Zeilen (0 = mindestens eine)
set(_figur_marke "")
if(TEIL STREQUAL "tuer2000" OR TEIL STREQUAL "elza2001")
    # Tuer 0 von ROOM2070/2071 (Door_aot_set @0x00a3a: Rechteck x -19950..-18950, Ziel Stage 1 Raum 0) -> Oststeg
    if(TEIL STREQUAL "tuer2000")
        set(_raum 2000)
        set(_von 2070)
        set(_figur "")
    else()
        set(_raum 2001)
        set(_von 2071)
        set(_figur RE15_TITLE_SHOT_CHAR=1 RE15_SET_FLAG=3:0x45)
    endif()
    set(_ende 700)
    file(WRITE "${WORKDIR}/plan.txt" "RAUM ${_von}\nWARTE 20\nBLICK 2048\nWARTE 10\nAKTION\nRAUM ${_raum}\nWARTE 10\n"
                                     "GEHE -20600 -10600 200\nBLICK 2048\nWARTE 1500\nENDE\n")
    re15_start_spiel(_rv 400
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_SOFTWARE_RENDER=1 RE15_WINDOW_SCALE=1
        RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2 ${_figur}
        "RE15_DEBUG_JUMP=${_von}@250" "RE15_PLAYER_POS=-18500,-6400,2048,0"
        "RE15_WEGPLAN=${WORKDIR}/plan.txt"
        RE15_ZOMBIEFRESSER_LOG=zf.log RE15_STATE_LOG=state.log
        "RE15_EXIT_AT=${_ende}#${_raum}"
        "${_exe}")
    set(_marke "PC loaded room${_raum}.rdt")
else()
    if(TEIL STREQUAL "leon3000" OR TEIL STREQUAL "re15_3000")
        set(_raum 3000)
        set(_karte 3000 -8700 -14800 2048 0 leon 4:9 4:0xC6)
        if(TEIL STREQUAL "re15_3000")
            set(_re2 0)
            set(_ki "RE15_AI_FLAVOR=re15")
            list(APPEND _karte cam=3)   # NB1: Kamera 3 zeigt die Liegenden (Abnahme S3b/S5); sonst Region-Culling = keine Pose-Zeilen
            set(_pose 1)
        endif()
    elseif(TEIL STREQUAL "laden2000" OR TEIL STREQUAL "re15_2000")
        set(_raum 2000)
        set(_karte 2000 -20600 -10600 2048 1 leon cam=7)   # Oststeg, Kamera 7 (Tuerweg S1: cam=7 an derselben Stelle)
        set(_n_init_soll 2)
        set(_laden 1)
        if(TEIL STREQUAL "re15_2000")
            set(_re2 0)
            set(_ki "RE15_AI_FLAVOR=re15")
            set(_pose 1)
        endif()
    elseif(TEIL STREQUAL "laden2001")
        set(_raum 2001)
        set(_karte 2001 -20600 -10600 2048 1 elza 3:0x45 cam=7)
        set(_n_init_soll 2)
        set(_laden 1)
        set(_figur_marke "Spieler-Familie PL04")
    elseif(TEIL STREQUAL "leon3010")
        set(_raum 3010)
        set(_karte 3010 -9100 -18700 1024 0 leon 4:0x0A)
    else()
        message(FATAL_ERROR "${_tag}: unbekannter TEIL")
    endif()
    set(_ende 360)                    # Angriff im Unit-Lauf ab Bild 76..128; danach stirbt Leon im Griff (RE1.5)
    if(TEIL STREQUAL "re15_2000")
        set(_ende 600)                # RE1.5-KI im Kanal: hochziehen ab ~F175, Griff gemessen F430 (NB1, re15_2000c)
    endif()
    execute_process(COMMAND "${RE15_KARTE_TOOL}" "re15_card.mcr" ${_karte}
                    WORKING_DIRECTORY "${WORKDIR}" TIMEOUT 60 RESULT_VARIABLE _rvk OUTPUT_VARIABLE _outk)
    if(NOT _rvk EQUAL 0 OR NOT EXISTS "${WORKDIR}/re15_card.mcr")
        file(REMOVE "${_exe}")
        message(FATAL_ERROR "${_tag}: Kartenwerkzeug exit=${_rvk}\n${_outk}")
    endif()
    set(_pose_env "")
    if(_pose)
        set(_pose_env "RE15_POSE_DUMP=pose.log")
    endif()
    re15_start_spiel(_rv 400
        RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_SOFTWARE_RENDER=1 RE15_WINDOW_SCALE=1
        RE15_CONTINUE_TEST=1 RE15_CARD_AUTO=1 RE15_CARD_SLOT=0
        RE15_ZOMBIEFRESSER_LOG=zf.log RE15_STATE_LOG=state.log
        "RE15_EXIT_AT=${_ende}#${_raum}"
        ${_ki} ${_pose_env}
        "${_exe}")
    set(_marke "CONTINUE: resumed in room ${_raum}")
endif()
file(REMOVE "${_exe}")

if(NOT EXISTS "${WORKDIR}/debug.log")
    message(FATAL_ERROR "${_tag}: kein debug.log (exit=${_rv}, ${WORKDIR})")
endif()
file(READ "${WORKDIR}/debug.log" _dbg)
foreach(_m "${_marke}" "EXIT_AT: Bild ${_ende} in Raum ${_raum}")
    string(FIND "${_dbg}" "${_m}" _p)
    if(_p LESS 0)
        message(FATAL_ERROR "${_tag}: fehlt im debug.log: '${_m}' (exit=${_rv}, ${WORKDIR})")
    endif()
endforeach()
if(NOT EXISTS "${WORKDIR}/zf.log" OR NOT EXISTS "${WORKDIR}/state.log")
    message(FATAL_ERROR "${_tag}: kein zf.log/state.log (${WORKDIR})")
endif()

set(_fehler "")
macro(fail _text)
    list(APPEND _fehler "${_text}")
    message(STATUS "FAIL ${_tag}: ${_text}")
endmacro()
macro(ok _text)
    message(STATUS "ok   ${_tag}: ${_text}")
endmacro()

# ---- zf.log: INIT / WECKT / STEHT AUF -----------------------------------------------------------------------------
file(STRINGS "${WORKDIR}/zf.log" _zf)
set(_n_init 0)
set(_weck_slot "")
set(_weck_f "")
set(_weck_d "")
set(_frei_f "")
foreach(_z IN LISTS _zf)
    if(_z MATCHES "F([0-9]+) slot=([0-9]+) INIT grid=(8[45]) Wort=([0-9]+)/([0-9]+)/([0-9]+) f10e=([0-9a-f]+)")
        math(EXPR _n_init "${_n_init} + 1")
        if(_re2 AND NOT (CMAKE_MATCH_4 STREQUAL "1" AND CMAKE_MATCH_5 STREQUAL "7" AND CMAKE_MATCH_7 STREQUAL "4002"))
            fail("INIT Slot ${CMAKE_MATCH_2}: Wort ${CMAKE_MATCH_4}/${CMAKE_MATCH_5} f10e ${CMAKE_MATCH_7} statt 1/7 4002")
        endif()
    elseif(_z MATCHES "F([0-9]+) slot=([0-9]+) WECKT[^ ]* d=([0-9]+)")
        if(_weck_slot STREQUAL "")
            set(_weck_f "${CMAKE_MATCH_1}")
            set(_weck_slot "${CMAKE_MATCH_2}")
            set(_weck_d "${CMAKE_MATCH_3}")
        endif()
        if(CMAKE_MATCH_3 GREATER_EQUAL 4000)
            fail("WECKT Slot ${CMAKE_MATCH_2} mit d=${CMAKE_MATCH_3} >= 4000 (`sltiu 0xfa0` @0x8010382c)")
        endif()
    elseif(_z MATCHES "F([0-9]+) slot=([0-9]+) STEHT AUF")
        if(CMAKE_MATCH_2 STREQUAL "${_weck_slot}" AND _frei_f STREQUAL "")
            set(_frei_f "${CMAKE_MATCH_1}")
        endif()
    endif()
endforeach()
# ---- NB1: LADE-Weg (I-E2), Figur und Zahl der Liegenden ----------------------------------------------------------------
if(_laden)
    string(FIND "${_dbg}" "${_marke}" _p_cont)
    set(_p_sub00 -1)
    if(_p_cont GREATER_EQUAL 0)
        string(SUBSTRING "${_dbg}" ${_p_cont} -1 _nach_cont)
        string(FIND "${_nach_cont}" "thread start slot=1 " _p_sub00)
    endif()
    if(_p_sub00 LESS 0)
        fail("LADE-Weg: sub00 (Slot 1) startet nach dem CONTINUE nicht (Original FUN_8003ef6c Slot 1 @0x8003efd4-d8)")
    else()
        ok("LADE-Weg: sub00 startet nach dem CONTINUE (Slot 1, wie FUN_8003ef6c @0x8003efd4-d8)")
    endif()
endif()
if(NOT _figur_marke STREQUAL "")
    string(FIND "${_dbg}" "${_figur_marke}" _p_fig)
    if(_p_fig LESS 0)
        fail("Figur: '${_figur_marke}' fehlt im debug.log")
    else()
        ok("Figur: ${_figur_marke}")
    endif()
endif()
if(_n_init_soll GREATER 0)
    file(STRINGS "${WORKDIR}/state.log" _erste REGEX "^F[0-9]+ " LIMIT_COUNT 1)
    string(REGEX MATCHALL " g=8[45] " _g_erste "${_erste}")
    list(LENGTH _g_erste _n_g)
    if(NOT _n_g EQUAL _n_init_soll)
        fail("erstes Bild: ${_n_g} Zombies mit grid 84/85 statt ${_n_init_soll} (Spawns sub00)")
    else()
        ok("erstes Bild: ${_n_g} Liegende mit grid 84/85")
    endif()
    if(_re2 AND NOT _n_init EQUAL _n_init_soll)
        fail("${_n_init} INIT-Zeilen statt ${_n_init_soll}")
    endif()
endif()
if(_re2 AND _n_init LESS 1)
    fail("kein INIT eines 0x84/0x85-Zombies im zf.log")
endif()
if(_weck_slot STREQUAL "")
    fail("kein Zombie geweckt")
else()
    ok("Slot ${_weck_slot} weckt in Bild ${_weck_f} bei d=${_weck_d}")
endif()
if(_re2)
    if(_frei_f STREQUAL "")
        fail("Slot ${_weck_slot}: kein STEHT AUF")
    else()
        math(EXPR _warte "${_frei_f} - ${_weck_f}")
        if(_warte LESS 0 OR _warte GREATER 16)
            fail("Wartezeit ${_warte} Bilder ausserhalb 0..16 (rand&0xf @0x80103858-60)")
        else()
            ok("Wartezeit ${_warte} Bilder (Wecken F${_weck_f} -> Latch frei F${_frei_f})")
        endif()
    endif()
endif()

# ---- state.log: liegend / aufrecht / Angriff / nie Fressen -----------------------------------------------------------
file(STRINGS "${WORKDIR}/state.log" _zeilen REGEX "^F[0-9]+ ")
set(_steht "")
set(_angriff "")
set(_fressen 0)
set(_liege_bruch 0)
set(_hp0 "")
if(_re2)
    set(_auf_rx "st=1 ss1=1 ss2=[0-9]+ ss3=[0-9]+ g=00 ")
    set(_liege_rx "t=1[0-6a-f] st=1 ss1=7 ss2=[0-9]+ ss3=[0-9]+ g=8[45] ")
else()
    set(_auf_rx "st=1 ss1=2 ss2=[0-9]+ ss3=[0-9]+ g=00 ")
    set(_liege_rx "t=1[0-6a-f] st=1 ss1=0 ss2=[0-9]+ ss3=[0-9]+ g=8[45] ")
endif()
foreach(_l IN LISTS _zeilen)
    string(REPLACE "[" "<" _l "${_l}")
    string(REPLACE "]" ">" _l "${_l}")
    string(REGEX MATCH "^F([0-9]+) " _m "${_l}")
    set(_f "${CMAKE_MATCH_1}")
    if(_l MATCHES "<[0-9]+ t=1[0-6a-f] st=1 ss1=8 ")
        math(EXPR _fressen "${_fressen} + 1")
    endif()
    # jeder Zombie, der grid 84/85 noch traegt, liegt (RE2 EXEC[7], RE1.5 Sub 0; Zustand 0 = Spawnbild vor dem INIT
    # zaehlt nicht) — beide Originale halten den
    # Deskriptor bis zum Pose-Ausgang (RE2 P4, RE1.5 P3 `sb zero,9` @0x801039d0)
    string(REGEX MATCHALL "<[0-9]+ t=1[0-6a-f] st=[1-9][0-9]* ss1=[0-9]+ ss2=[0-9]+ ss3=[0-9]+ g=8[45] " _g84 "${_l}")
    foreach(_e IN LISTS _g84)
        if(NOT _e MATCHES "${_liege_rx}")
            math(EXPR _liege_bruch "${_liege_bruch} + 1")
        endif()
    endforeach()
    if(NOT _weck_slot STREQUAL "")
        if(_steht STREQUAL "" AND _l MATCHES "<${_weck_slot} t=1[0-6a-f] ${_auf_rx}")
            set(_steht "${_f}")
        endif()
        if(NOT _steht STREQUAL "" AND _angriff STREQUAL "")
            string(REGEX MATCH "hp=(-?[0-9]+)\\) " _hm "${_l}")
            set(_hp "${CMAKE_MATCH_1}")
            if(_hp0 STREQUAL "")
                set(_hp0 "${_hp}")
            endif()
            if(_l MATCHES " gr=1" OR (_hp LESS _hp0))
                set(_angriff "${_f}")
            endif()
        endif()
    endif()
endforeach()
if(_fressen GREATER 0)
    fail("${_fressen} Bilder mit einem FRESSENDEN Zombie (st=1 ss1=8)")
else()
    ok("kein Zombie frisst")
endif()
if(_liege_bruch GREATER 0)
    fail("${_liege_bruch} Eintraege mit grid 84/85 ausserhalb der Liege-Pose")
else()
    ok("jeder Zombie mit grid 84/85 liegt")
endif()
if(_steht STREQUAL "")
    fail("Slot ${_weck_slot} steht nie aufrecht (${_auf_rx})")
else()
    ok("Slot ${_weck_slot} steht ab Bild ${_steht}")
endif()
if(_angriff STREQUAL "")
    fail("Slot ${_weck_slot} greift bis Bild ${_ende} nicht an")
else()
    ok("Angriff ab Bild ${_angriff}")
endif()

# ---- NB1 / M1: POSE vor dem Wecken (RE15_POSE_DUMP = was der Renderer posiert) ------------------------------------------
if(_pose)
    if(NOT EXISTS "${WORKDIR}/pose.log")
        fail("kein pose.log (RE15_POSE_DUMP)")
    else()
        foreach(_z IN LISTS _zf)
            if(_z MATCHES "F([0-9]+) slot=([0-9]+) P2-SAAT")
                set(_saat_${CMAKE_MATCH_2} "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        file(STRINGS "${WORKDIR}/pose.log" _pz REGEX "^.pose. F[0-9]+ slot[0-9]+ ")
        set(_slots "")
        set(_n_halt_slots 0)
        set(_n_p2_ok 0)
        foreach(_l IN LISTS _pz)
            if(NOT _l MATCHES "F([0-9]+) slot([0-9]+) ss1=([0-9]+) mo=([0-9]+) af=([0-9]+) frac=([0-9]+) kf=([0-9]+)")
                continue()
            endif()
            set(_f "${CMAKE_MATCH_1}")
            set(_s "${CMAKE_MATCH_2}")
            set(_ss1 "${CMAKE_MATCH_3}")
            set(_mo "${CMAKE_MATCH_4}")
            set(_af "${CMAKE_MATCH_5}")
            set(_fr "${CMAKE_MATCH_6}")
            set(_kf "${CMAKE_MATCH_7}")
            if(NOT DEFINED _ph_${_s})
                # erste Zeile des Slots: ein Liegender zeigt Sub 0, +0x94 0x12/0x13 (18/19), Bild 0
                if(_ss1 EQUAL 0 AND _af EQUAL 0 AND (_mo EQUAL 18 OR _mo EQUAL 19))
                    set(_ph_${_s} 0)
                    set(_halt_${_s} 0)
                    if(_mo EQUAL 18)
                        set(_soll_${_s} 301)     # 0x12d = Bank 1 Clip 0x0c Bild 0 (sel 4/7/9)
                        set(_kf0_${_s} 400)      # 0x190 = Clip 0x12 Bild 0
                    else()
                        set(_soll_${_s} 329)     # 0x149 = Clip 0x0e Bild 0 (sel 5/8/0xa)
                        set(_kf0_${_s} 450)      # 0x1c2 = Clip 0x13 Bild 0
                    endif()
                    list(APPEND _slots "${_s}")
                else()
                    set(_ph_${_s} 9)
                endif()
            endif()
            if(_ph_${_s} EQUAL 0)
                if(_kf EQUAL "${_soll_${_s}}")
                    math(EXPR _halt_${_s} "${_halt_${_s}} + 1")
                    if(NOT _af EQUAL 0 OR NOT (_fr EQUAL 0 OR _fr EQUAL 15))
                        fail("Pose Slot ${_s} F${_f}: Halt-Keyframe mit Bild ${_af} / +0x8f ${_fr}")
                    endif()
                else()
                    set(_ph_${_s} 1)
                    set(_p2ok 0)
                    if(_kf EQUAL "${_kf0_${_s}}" AND _af EQUAL 0 AND _fr EQUAL 15)
                        set(_p2ok 1)
                        # Grid 0x84/0x85 erreichen P2 ueber P1 -> der Saat-Takt muss im zf.log stehen (P1 kehrt ohne
                        # anim_set zurueck @0x80103994-98), und das erste P2-Bild kommt genau einen Takt danach
                        if(NOT DEFINED _saat_${_s})
                            set(_p2ok 0)
                        else()
                            math(EXPR _soll_f "${_saat_${_s}} + 1")
                            if(NOT _f EQUAL _soll_f)
                                set(_p2ok 0)
                            endif()
                        endif()
                    endif()
                    if(_p2ok)
                        math(EXPR _n_p2_ok "${_n_p2_ok} + 1")
                        ok("Pose Slot ${_s}: ${_halt_${_s}} Bilder Keyframe ${_soll_${_s}} (INIT-Pose), erstes P2-Bild F${_f} Keyframe ${_kf} Bild 0 +0x8f 15")
                    else()
                        fail("Pose Slot ${_s} F${_f}: erstes Bild nach dem Halt Keyframe ${_kf} Bild ${_af} +0x8f ${_fr} (Soll ${_kf0_${_s}} / 0 / 15, einen Takt nach P2-SAAT)")
                    endif()
                endif()
            endif()
        endforeach()
        foreach(_s IN LISTS _slots)
            if(_halt_${_s} GREATER 0)
                math(EXPR _n_halt_slots "${_n_halt_slots} + 1")
            endif()
            message(STATUS "     pose slot ${_s}: ${_halt_${_s}} Bilder Halt-Keyframe ${_soll_${_s}}")
        endforeach()
        set(_halt_min 1)
        if(_n_init_soll GREATER 0)
            set(_halt_min ${_n_init_soll})
        endif()
        if(_n_halt_slots LESS _halt_min)
            fail("nur ${_n_halt_slots} Liegende mit INIT-Pose 301/329 gesehen (Soll >= ${_halt_min})")
        else()
            ok("${_n_halt_slots} Liegende zeigen vor dem Wecken die INIT-Pose (Keyframe 301 = 0x12d / 329 = 0x149)")
        endif()
        if(_n_p2_ok LESS 1)
            fail("kein Liegender mit richtigem ersten P2-Bild")
        endif()
    endif()
endif()
if(_fehler)
    list(LENGTH _fehler _nf)
    message(FATAL_ERROR "${_tag}: ${_nf} Fehler (${WORKDIR})")
endif()
message(STATUS "${_tag}: bestanden (${WORKDIR})")
