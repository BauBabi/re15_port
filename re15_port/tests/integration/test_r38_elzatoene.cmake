# Runde 38 Spur H "elzatoene" — INTEGRATION an der ECHTEN exe (Elza-Spiel). Dossier analysis/befunde_runde38/H_elzatoene.md.
# Registrierung: tests/unit/probes/r38_elzatoene.cmake. Aufruf:
#   cmake -DRE15_PC_EXE=<exe> -DRE15_KARTE_TOOL=<probe_r36_elza_karte> -DRE15_KREUZ_TOOL=<probe_r38_elzatoene_kreuz>
#         -DRE15_ELZASE=<ELZASE.VBS> -DRE15_RDT1021=<ROOM1021.RDT> -DWORKDIR=<dir> -DTEIL=<gunshot1041|szene1021> -P ...
# Wege (VERTRAG: Story-/Raum-Punkte ueber den echten Weg; Elza = Figur 4 im Spielstand):
#   gunshot1041  Spielstand ROOM1031 an der Tuer nach 1041 (erster Besuch: (4,0xF1)/(3,0xAD) = 0), CONTINUE, Tuer
#                (AOT 2) -> ROOM1041, Elza geht nach Westen ins Auto-Feld AOT 8 -> sub11. Gemessen: Anker-Aktion 1 im
#                elza.log, Nachricht 3 erscheint nie, msg 2 erscheint, Kreuzkorrelation des Schusses im Mitschnitt.
#   szene1021    Spielstand ROOM1041 an der Tuer nach 1021 (Story nach Johns Befreiung: (4,0x60)/(3,0xC9)/(4,0xF1)/
#                (3,0xAD)), CONTINUE, Tuer (AOT 3) -> ROOM1021, Elza geht ins Auto-Feld AOT 5 -> sub02. Gemessen: Roys
#                Stoehnen (Aktion 2) am Gangbeginn, Johns Schuesse 151 Bilder spaeter, Kreuzkorrelation je Ton.
cmake_minimum_required(VERSION 3.16)
set(_tag "r38_elzatoene_${TEIL}")
foreach(_v RE15_PC_EXE RE15_KARTE_TOOL RE15_KREUZ_TOOL RE15_ELZASE RE15_RDT1021 WORKDIR TEIL)
    if(NOT ${_v})
        message(FATAL_ERROR "${_tag}: ${_v} fehlt")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")
string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(WORKDIR "${WORKDIR}/lauf_${TEIL}_${_lauf_id}")
file(MAKE_DIRECTORY "${WORKDIR}")
# Messkopie unter eigenem Namen neben der exe (Asset-Wurzel = exe-Verzeichnis; Muster test_r34n_b_cursor.cmake).
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
set(_exe "${_exe_dir}/re15_pc_r38h_${_lauf_id}.exe")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

macro(fail)
    file(REMOVE "${_exe}")
    message(FATAL_ERROR "${_tag}: ${ARGN} (${WORKDIR})")
endmacro()

macro(karte _raum _x _z _gier)
    execute_process(COMMAND "${RE15_KARTE_TOOL}" "re15_card.mcr" ${_raum} ${_x} ${_z} ${_gier} ${ARGN}
                    WORKING_DIRECTORY "${WORKDIR}" TIMEOUT 60 RESULT_VARIABLE _rvk OUTPUT_VARIABLE _outk)
    if(NOT _rvk EQUAL 0)
        fail("Kartenwerkzeug exit=${_rvk}\n${_outk}")
    endif()
endmacro()

macro(lauf _timeout)
    re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    if("${_rv}" STREQUAL "1" OR "${_rv}" STREQUAL "-1" OR NOT EXISTS "${WORKDIR}/debug.log")
        message(STATUS "${_tag}: Lauf ohne Ergebnis (exit=${_rv}) -> EIN Wiederholungsversuch")
        file(REMOVE "${WORKDIR}/debug.log" "${WORKDIR}/state.log" "${WORKDIR}/elza.log" "${WORKDIR}/cap.raw")
        re15_start_spiel(_rv ${_timeout} ${ARGN} "${_exe}")
    endif()
    if(NOT EXISTS "${WORKDIR}/debug.log")
        fail("kein debug.log (exit=${_rv})")
    endif()
endmacro()

# Bild der Anker-Aktion `_akt` (elza.log-Zeilen "[<quelle>] ... -> Aktion <akt>") -> Liste _out
macro(aktion_bilder _quelle _akt _out)
    set(${_out} "")
    if(EXISTS "${WORKDIR}/elza.log")
        file(STRINGS "${WORKDIR}/elza.log" _al REGEX "\\[${_quelle}\\] .*-> Aktion ${_akt}( |$)")
        foreach(_l ${_al})
            string(REGEX MATCH "^F([0-9]+) " _m "${_l}")
            list(APPEND ${_out} "${CMAKE_MATCH_1}")
        endforeach()
    endif()
endmacro()

# Kreuzkorrelation: _quelle an Bild _bild -> _k (Korrelation), _g (Gegenprobe 60 Bilder frueher)
macro(kreuz _exit _quelle _bild _k _g)
    execute_process(COMMAND "${RE15_KREUZ_TOOL}" "${WORKDIR}/cap.raw" ${_exit} "${_quelle}" ${_bild}
                    RESULT_VARIABLE _rvx OUTPUT_VARIABLE _outx ERROR_VARIABLE _errx)
    if(NOT _rvx EQUAL 0)
        fail("Kreuzkorrelation exit=${_rvx}: ${_outx} ${_errx}")
    endif()
    message(STATUS "${_tag}: ${_errx}${_outx}")
    string(REGEX MATCH "korrelation (-?[0-9.]+)" _m1 "${_outx}")
    set(${_k} "${CMAKE_MATCH_1}")
    string(REGEX MATCH "gegenprobe (-?[0-9.]+)" _m2 "${_outx}")
    set(${_g} "${CMAKE_MATCH_1}")
endmacro()

# Zeilen des letzten Raums aus state.log (der Bildzaehler beginnt je Raum bei F0) -> _out
macro(state_letzter_raum _out)
    file(STRINGS "${WORKDIR}/state.log" _sl)
    set(${_out} "")
    foreach(_z ${_sl})
        if(_z MATCHES "^F0 ")
            set(${_out} "")
        endif()
        list(APPEND ${_out} "${_z}")
    endforeach()
endmacro()

set(_basis RE15_NO_INTRO=1 RE15_WINDOW_SCALE=1 RE15_CONTINUE_TEST=1 RE15_CARD_AUTO=1 RE15_CARD_SLOT=0
           RE15_STATE_LOG=state.log RE15_AUDIO_CAP_SYNC=cap.raw RE15_ELZA_LOG=elza.log RE15_SE_DEBUG=1
           RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=60)

if(TEIL STREQUAL "gunshot1041")
    # ROOM1031 Tuer-AOT 2 (Rechteck (-27500,-4700) 1200 x 2100) -> ROOM1041 (-20083,-3559) Blick 2048 (= nach Westen).
    karte(1031 -26900 -3650 0)
    lauf(600 ${_basis} "RE15_FIRE_AOT=2@40#1031" "RE15_INPUT_SCRIPT=U2.5" "RE15_EXIT_AT=500#1041")
    aktion_bilder(elzatoene 1 _a)
    list(LENGTH _a _na)
    if(NOT _na EQUAL 1)
        fail("Schuss-Aktion ROOM1041 ${_na}x (soll 1) — sub11 nicht erreicht?")
    endif()
    list(GET _a 0 _a0)
    state_letzter_raum(_st)
    set(_m3 0)
    set(_m2 0)
    foreach(_z ${_st})
        if(_z MATCHES "msg\\(a=1 fsm=1 id=3 ")
            math(EXPR _m3 "${_m3} + 1")
        endif()
        if(_z MATCHES "msg\\(a=1 fsm=1 id=2 ")
            math(EXPR _m2 "${_m2} + 1")
        endif()
    endforeach()
    if(NOT _m3 EQUAL 0)
        fail("Nachricht 3 (\"*gunshot*\") war ${_m3} Bilder offen (soll nie)")
    endif()
    if(_m2 EQUAL 0)
        fail("msg 2 \"Elza: What was that!?\" erschien nicht")
    endif()
    kreuz(500 "vbs:${RE15_ELZASE}:1" ${_a0} _k _g)
    if(_k LESS 0.5 OR _g GREATER 0.2)
        fail("Schuss nicht im Mitschnitt: Korrelation ${_k} (>= 0.5), Gegenprobe ${_g} (<= 0.2)")
    endif()
    message(STATUS "${_tag}: OK — Schuss-Ton in Bild ${_a0} (Korrelation ${_k}, Gegenprobe ${_g}), Text 3 nie, msg 2 ${_m2} Bilder")

elseif(TEIL STREQUAL "szene1021")
    # ROOM1041 Tuer-AOT 3 (Rechteck (-24300,15600) 1500 x 2200) -> ROOM1021 (-25883,-8767) Blick 0; Weg ins Auto-Feld AOT 5.
    karte(1041 -23550 16700 0 4:0x60 3:0xC9 4:0xF1 3:0xAD)
    lauf(900 ${_basis} "RE15_FIRE_AOT=3@40#1041" "RE15_INPUT_SCRIPT=L0.25,U0.8,R0.25,U6" "RE15_EXIT_AT=1300#1021")
    aktion_bilder(elzatoene 2 _g1)
    aktion_bilder(elza 2 _s)
    list(LENGTH _g1 _ng)
    list(LENGTH _s _ns)
    if(NOT _ng EQUAL 1 OR NOT _ns EQUAL 2)
        fail("Aktionen: Stoehnen ${_ng}x (soll 1), Schuesse ${_ns}x (soll 2)")
    endif()
    list(GET _g1 0 _gang)
    list(GET _s 0 _s1)
    list(GET _s 1 _s2)
    math(EXPR _d "${_s1} - ${_gang}")
    if(NOT _d EQUAL 151)
        fail("Schuss 1 ${_d} Bilder nach dem Gangbeginn (soll 151 = Sleep 40 @0x020BE + 110 @0x020CA + Verzug 1)")
    endif()
    kreuz(1300 "rdt:${RE15_RDT1021}:1:4" ${_gang} _kg _gg)
    kreuz(1300 "vbs:${RE15_ELZASE}:1" ${_s1} _k1 _g1x)
    kreuz(1300 "vbs:${RE15_ELZASE}:1" ${_s2} _k2 _g2x)
    if(_kg LESS 0.4 OR _gg GREATER 0.2)
        fail("Roys Stoehnen (snd1 SE 4) nicht im Mitschnitt: Korrelation ${_kg} (>= 0.4), Gegenprobe ${_gg}")
    endif()
    if(_k1 LESS 0.5 OR _k2 LESS 0.4 OR _g1x GREATER 0.2)
        fail("Schuesse nicht im Mitschnitt: ${_k1} / ${_k2} (>= 0.5 / 0.4), Gegenprobe ${_g1x}")
    endif()
    message(STATUS "${_tag}: OK — Stoehnen Bild ${_gang} (Korrelation ${_kg}, Gegenprobe ${_gg}), Schuesse ${_s1}/${_s2} (${_k1}/${_k2})")
else()
    fail("unbekannter TEIL '${TEIL}'")
endif()
file(REMOVE "${_exe}")
