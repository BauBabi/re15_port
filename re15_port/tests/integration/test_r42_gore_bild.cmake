# Runde 42 Strang "gore", Stufe 1, Runde 3 (Pruefbericht R1): integration_r42_gore_bild — prueft das ZEICHNEN der
# Granatwerfer-Beine im echten Spielfenster (main.c), nicht nur re15_enemy_bone_world_pos.
# Registrierung: tests/unit/probes/r42_gore.cmake.
#
# LAUF (eine echte re15_pc.exe, Titel-Autostart, RE15_DEBUG_JUMP=1010@250, RE2-KI, Eingabe-Skript auf der Spielbild-Achse):
#   ROOM1010 (Verhoerraum), Kamera 2 fest (RE15_FORCE_CUT=2). Leon (3000,7500) Blick 2048 mit Granatwerfer (w15). Zombie
#   Platz 2 kommt aus (205,7248) auf ihn zu; Platz 1 wird per RE15_GEGNER_POS hinter die Kamera gestellt (-3100,4800).
#   Abschnitt 1 des Skripts: 0,6 s warten, 0,6 s zielen, 0,4 s feuern (Quadrat) -> EIN Schuss, der stehende Zombie stirbt
#   ("[gr] ... OBERKOERPER AB (Granatwerfer").
#   Messschiene RE15_GORE_ZEICHEN_LOG (main.c, kein Verhalten): je GEZEICHNETEM Teil 0..7 die Welt-Lage w, mit der der
#   Zeichner es setzt, und q = re15_enemy_bone_world_pos.
# PRUEFUNGEN (Slot aus der [gr]-Zeile):
#   (a) Zeichner = Riegel-Lage: fuer die Beinteile 1..7 |w - q| <= 2 in jedem Bild (die Unit-Riegel 13/14/22-28/43/44 pruefen
#       q; damit gelten sie fuer das Bild).
#   (b) Stehen: in den Bildern mit ok=1/N, N > 0 (Stehzeit re2z_ok_steh, 80 % Film 3 0:18,085 -> 0:19,00 = 28 Bilder) steht das
#       Becken (Teil 1) hoch (w.y <= -1500, Clip 1 Bild 0 @0x8010B9B0) und an EINER Stelle; mindestens 20 solche Bilder.
#   (c) Kippen: spaetestens 12 Bilder nach der Stehzeit liegt das Becken (w.y > -400).
#   (d) Kein Umklappen (Runde 3, gemessen: F81 -> F82 sprang Fuss 4 um ~3300): ab 4 Bildern nach dem Liegen bewegt sich kein
#       Fuss (Teile 4 und 7) um mehr als 700 je Bild. Das Becken behaelt nach part[1] |= 0x40 seine Matrix (RE2 FUN_80027434
#       `andi v0,s3,0x40` / `bne` @0x80027498-9C), die Kinder haengen daran (re15_re2z_beine_einfrieren).
#   (e) Kriechen: der Oberkoerper wird Kriecher (f10e Bit 0, HP 10 @0x80106ACC-E8) und bewegt sich (Aktor >= 40 vom
#       Todesort), das Becken bleibt dabei an seiner Stelle (+-2).
# Ein Lauf OHNE Ergebnis (exit=1 = von aussen beendet; debug.log < 10 Zeilen = Startfehler) wird EINMAL wiederholt.

cmake_minimum_required(VERSION 3.16)
set(_tag "r42_gore_bild")
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "${_tag}: RE15_PC_EXE fehlt/existiert nicht: '${RE15_PC_EXE}'")
endif()
if(NOT WORKDIR)
    message(FATAL_ERROR "${_tag}: WORKDIR fehlt")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(_dir "${WORKDIR}/lauf_${_lauf_id}")
file(MAKE_DIRECTORY "${_dir}")

function(r42_fehler _text)
    message(FATAL_ERROR "${_tag}: ${_text} (Lauf ${_dir})")
endfunction()

set(_args
    RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_TITLE_SHOT=title.bmp RE15_TITLE_SHOT_AF=2 RE15_WINDOW_SCALE=1
    RE15_AI_FLAVOR=re2 RE15_DEBUG_JUMP=1010@250 "RE15_PLAYER_POS=3000,7500,2048" "RE15_GEGNER_POS=1,-3100,4800,0@0#1010"
    RE15_GIVE=15:9 RE15_EQUIP=15 RE15_FORCE_CUT=2 RE15_R39_MESS_SPIELER_HP=100 RE15_GR_LOG=1
    RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=1 "RE15_INPUT_SCRIPT=W8|W0.6,M0.6,MA0.4,M5"
    RE15_GORE_ZEICHEN_LOG=gz.log "RE15_EXIT_AT=200#1010")

set(WORKDIR "${_dir}")
re15_start_spiel(_rv 300 ${_args} "${RE15_PC_EXE}")
if(NOT _rv EQUAL 0)
    set(_z "")
    if(EXISTS "${_dir}/debug.log")
        file(STRINGS "${_dir}/debug.log" _z)
    endif()
    list(LENGTH _z _n)
    if(_n LESS 10 OR "${_rv}" STREQUAL "1")
        message(STATUS "${_tag}: Lauf ohne Ergebnis (exit=${_rv}, debug.log ${_n} Zeilen) -> EIN Wiederholungsversuch")
        file(REMOVE "${_dir}/debug.log" "${_dir}/gz.log")
        re15_start_spiel(_rv 300 ${_args} "${RE15_PC_EXE}")
    endif()
endif()
if(NOT _rv EQUAL 0)
    r42_fehler("re15_pc.exe exit=${_rv} (erwartet 0 bis RE15_EXIT_AT)")
endif()

# --- der Tod ---------------------------------------------------------------------------------------------------------
file(STRINGS "${_dir}/debug.log" _gr REGEX "\\[gr\\] RE2 Slot [0-9]+ Typ 0x1[0-8] Zeile 9: OBERKOERPER AB \\(Granatwerfer")
if(NOT _gr)
    r42_fehler("kein stehender Zombie verlor den Oberkoerper (keine Zeile '[gr] ... OBERKOERPER AB (Granatwerfer')")
endif()
list(GET _gr 0 _g0)
string(REGEX MATCH "Slot ([0-9]+)" _m "${_g0}")
set(_slot "${CMAKE_MATCH_1}")
if(NOT EXISTS "${_dir}/gz.log")
    r42_fehler("keine Messschiene gz.log (RE15_GORE_ZEICHEN_LOG fehlt in dieser exe)")
endif()
file(STRINGS "${_dir}/gz.log" _gz REGEX "^GZ F=[0-9]+ s=${_slot} b=")
list(LENGTH _gz _ngz)
if(_ngz LESS 100)
    r42_fehler("Messschiene zu kurz: ${_ngz} Zeilen fuer Platz ${_slot}")
endif()

# --- auswerten -------------------------------------------------------------------------------------------------------
# CMake kennt nur CMAKE_MATCH_0..9 - darum zwei Ausdruecke je Zeile
set(_rx "^GZ F=([0-9]+) s=[0-9]+ b=([0-9]+) st=[0-9]+/[0-9]+/[0-9]+ hp=-?[0-9]+ ok=([0-9]+)/([0-9]+) anc=[0-9]+ f10e=([0-9a-f]+) xz=[(](-?[0-9]+),(-?[0-9]+)[)]")
set(_rx2 " w=[(](-?[0-9]+),(-?[0-9]+),(-?[0-9]+)[)] q=[(](-?[0-9]+),(-?[0-9]+),(-?[0-9]+)[)]")
set(_abw_max 0)
set(_steh_n 0)
set(_steh_hoch 1)
set(_steh_x "")
set(_steh_z "")
set(_steh_ende -1)
set(_liegt_ab -1)
set(_fsprung_max 0)
set(_fsprung_bild -1)
set(_krie_n 0)
set(_krie_weg 0)
set(_krie_becken_ok 1)
set(_tod_x "")
set(_tod_z "")
set(_becken_lx "")
set(_becken_lz "")
foreach(_b 4 7)
    set(_vor_${_b} "")
endforeach()
foreach(_l IN LISTS _gz)
    if(NOT _l MATCHES "${_rx}")
        continue()
    endif()
    set(_F ${CMAKE_MATCH_1})
    set(_B ${CMAKE_MATCH_2})
    set(_OK ${CMAKE_MATCH_3})
    set(_ST ${CMAKE_MATCH_4})
    set(_f10e ${CMAKE_MATCH_5})
    set(_ax ${CMAKE_MATCH_6})
    set(_az ${CMAKE_MATCH_7})
    if(NOT _l MATCHES "${_rx2}")
        continue()
    endif()
    set(_wx ${CMAKE_MATCH_1})
    set(_wy ${CMAKE_MATCH_2})
    set(_wz ${CMAKE_MATCH_3})
    set(_qx ${CMAKE_MATCH_4})
    set(_qy ${CMAKE_MATCH_5})
    set(_qz ${CMAKE_MATCH_6})
    if(_B GREATER_EQUAL 1)                                   # (a) nur die Beinteile
        foreach(_k x y z)
            math(EXPR _d "${_w${_k}} - ${_q${_k}}")
            if(_d LESS 0)
                math(EXPR _d "0 - ${_d}")
            endif()
            if(_d GREATER _abw_max)
                set(_abw_max ${_d})
                set(_abw_wo "F${_F} Teil ${_B}")
            endif()
        endforeach()
    endif()
    if(_B EQUAL 1)
        if(_OK EQUAL 1 AND _ST GREATER 0)                    # (b)
            math(EXPR _steh_n "${_steh_n} + 1")
            if(_wy GREATER -1500)
                set(_steh_hoch 0)
                set(_steh_wo "F${_F} y=${_wy}")
            endif()
            if("${_steh_x}" STREQUAL "")
                set(_steh_x ${_wx})
                set(_steh_z ${_wz})
            elseif(NOT _wx EQUAL _steh_x OR NOT _wz EQUAL _steh_z)
                set(_steh_hoch 0)
                set(_steh_wo "F${_F} Becken wandert (${_wx},${_wz}) statt (${_steh_x},${_steh_z})")
            endif()
            set(_steh_ende ${_F})
        endif()
        if(_steh_ende GREATER -1 AND _liegt_ab EQUAL -1 AND _wy GREATER -400)   # (c)
            set(_liegt_ab ${_F})
            set(_becken_lx ${_wx})
            set(_becken_lz ${_wz})
            set(_tod_x ${_ax})
            set(_tod_z ${_az})
        endif()
        if(_liegt_ab GREATER -1 AND _f10e MATCHES "[13579bdf]$")                # (e) Kriecher
            math(EXPR _krie_n "${_krie_n} + 1")
            math(EXPR _dbx "${_wx} - ${_becken_lx}")
            math(EXPR _dbz "${_wz} - ${_becken_lz}")
            if(_dbx GREATER 2 OR _dbx LESS -2 OR _dbz GREATER 2 OR _dbz LESS -2)
                set(_krie_becken_ok 0)
                set(_krie_wo "F${_F} Becken (${_wx},${_wz}) statt (${_becken_lx},${_becken_lz})")
            endif()
            math(EXPR _dax "${_ax} - ${_tod_x}")
            math(EXPR _daz "${_az} - ${_tod_z}")
            if(_dax LESS 0)
                math(EXPR _dax "0 - ${_dax}")
            endif()
            if(_daz LESS 0)
                math(EXPR _daz "0 - ${_daz}")
            endif()
            math(EXPR _da "${_dax} + ${_daz}")
            if(_da GREATER _krie_weg)
                set(_krie_weg ${_da})
            endif()
        endif()
    endif()
    if(_B EQUAL 4 OR _B EQUAL 7)                             # (d)
        if(_liegt_ab GREATER -1)
            math(EXPR _ab "${_liegt_ab} + 4")
            if(_F GREATER_EQUAL _ab AND NOT "${_vor_${_B}}" STREQUAL "")
                list(GET _vor_${_B} 0 _vx)
                list(GET _vor_${_B} 1 _vz)
                math(EXPR _dx "${_wx} - ${_vx}")
                math(EXPR _dz "${_wz} - ${_vz}")
                if(_dx LESS 0)
                    math(EXPR _dx "0 - ${_dx}")
                endif()
                if(_dz LESS 0)
                    math(EXPR _dz "0 - ${_dz}")
                endif()
                math(EXPR _dd "${_dx} + ${_dz}")
                if(_dd GREATER _fsprung_max)
                    set(_fsprung_max ${_dd})
                    set(_fsprung_bild "F${_F} Teil ${_B}")
                endif()
            endif()
        endif()
        set(_vor_${_B} "${_wx};${_wz}")
    endif()
endforeach()

message(STATUS "${_tag}: Platz ${_slot}: Abweichung Zeichner/Riegel max ${_abw_max}; Stehbilder ${_steh_n} (hoch und fest ${_steh_hoch}); "
               "Stehzeit-Ende F${_steh_ende}, liegt ab F${_liegt_ab}; groesster Fuss-Sprung danach ${_fsprung_max} (${_fsprung_bild}); "
               "Kriecher-Bilder ${_krie_n}, Weg ${_krie_weg}, Becken fest ${_krie_becken_ok}")
if(_abw_max GREATER 2)
    r42_fehler("(a) Zeichner und re15_enemy_bone_world_pos weichen ab: ${_abw_max} bei ${_abw_wo}")
endif()
if(_steh_n LESS 20 OR NOT _steh_hoch)
    r42_fehler("(b) die Beine stehen nicht: ${_steh_n} Stehbilder, ${_steh_wo}")
endif()
math(EXPR _kipp_bis "${_steh_ende} + 12")
if(_liegt_ab EQUAL -1 OR _liegt_ab GREATER _kipp_bis)
    r42_fehler("(c) die Beine liegen nicht spaetestens 12 Bilder nach der Stehzeit (Ende F${_steh_ende}, liegt ab F${_liegt_ab})")
endif()
if(_fsprung_max GREATER 700)
    r42_fehler("(d) die liegenden Beine klappen um: Fuss springt ${_fsprung_max} in einem Bild (${_fsprung_bild})")
endif()
if(_krie_n LESS 20 OR _krie_weg LESS 40 OR NOT _krie_becken_ok)
    r42_fehler("(e) Kriecher: ${_krie_n} Bilder, Weg ${_krie_weg}, Becken fest ${_krie_becken_ok} ${_krie_wo}")
endif()
message(STATUS "-- ${_tag}: OK — Beine stehen ${_steh_n} Bilder, kippen, klappen nicht um, Oberkoerper kriecht, Zeichner = Riegel-Lage")
