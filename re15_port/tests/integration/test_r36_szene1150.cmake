# =============================================================================
# RUNDE 36 SPUR K (szene1150) — IRONS-MONTAGE MIT DER ECHTEN EXE.
#
# Dossier analysis/befunde_runde36/K_szene1150.md. Weg wie integration_r35_cut1150 Lauf A: Spielstand (Karte aus
# probe_r35_cut1150_karte) + CONTINUE in ROOM1130 vor der Tuer zu Irons' Buero, Aktionstaste -> Tuer -> ROOM1150 ->
# Szene -> Montage 1130 -> 1040 -> 1030 -> 11C0; Ende in ROOM11C0 (Bild 480).
#   K1  der Tuerknall ist Knall-Bank Satz 0 = RE2 ROOM1060 Se_on 0x0a (Logzeile des Port-Takts)
#   K3  Ereignisfolge (debug.log `[irons-tod] Folge #n <K|S|C> ROOMxxxx T<takt> ...`): je Montage-Raum der Knall VOR
#       dem Spawn, der Spawn im Raumaufbau VOR dem ersten Kamerabild; state.log: das ERSTE Bild jedes Montage-Raums
#       zeigt die Zombies schon (Eintraege `[slot t=..` in der ersten Zeile des Raumbesuchs)
#   K2  ROOM11C0: Plc_neck Modus 1 Ada -> Marvin und Marvin -> Ada (RE15_NECK_LOG); seit Runde 37 Spur O KEIN Plc_dest
#       Modus 9 mehr (einander zugewandt ab dem Raumaufbau), Marvins Lauf Modus 5 (debug.log `[scd] Plc_dest(slot=..`)
# Aufruf: cmake -DRE15_PC_EXE=<exe> -DRE15_KARTE_TOOL=<probe_r35_cut1150_karte> -DWORKDIR=<dir> -P test_r36_szene1150.cmake
# =============================================================================
if(NOT RE15_PC_EXE OR NOT EXISTS "${RE15_PC_EXE}")
    message(FATAL_ERROR "r36_szene1150: RE15_PC_EXE fehlt: '${RE15_PC_EXE}'")
endif()
if(NOT RE15_KARTE_TOOL OR NOT EXISTS "${RE15_KARTE_TOOL}")
    message(FATAL_ERROR "r36_szene1150: RE15_KARTE_TOOL fehlt: '${RE15_KARTE_TOOL}'")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/spiel_lauf.cmake")

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _lauf_id)
set(WORKDIR "${WORKDIR}/lauf_${_lauf_id}")
file(MAKE_DIRECTORY "${WORKDIR}")
get_filename_component(_exe_dir "${RE15_PC_EXE}" DIRECTORY)
file(GLOB _alte "${_exe_dir}/re15_pc_r36k_haken_*.exe")
foreach(_k IN LISTS _alte)
    file(REMOVE "${_k}")
endforeach()
set(_exe "${_exe_dir}/re15_pc_r36k_haken_${_lauf_id}.exe")
file(COPY_FILE "${RE15_PC_EXE}" "${_exe}")

execute_process(COMMAND "${RE15_KARTE_TOOL}" "re15_card.mcr" "1130" nach10f0 ersteszene
                WORKING_DIRECTORY "${WORKDIR}" TIMEOUT 60 RESULT_VARIABLE _rvk OUTPUT_VARIABLE _outk)
if(NOT _rvk EQUAL 0 OR NOT EXISTS "${WORKDIR}/re15_card.mcr")
    message(FATAL_ERROR "r36_szene1150: Kartenwerkzeug exit=${_rvk}\n${_outk}")
endif()
re15_start_spiel(_rv 600
    RE15_NO_INTRO=1 RE15_NOAUDIO=1 RE15_SOFTWARE_RENDER=1 RE15_WINDOW_SCALE=1
    RE15_CONTINUE_TEST=1 RE15_CARD_AUTO=1 RE15_CARD_SLOT=0
    RE15_INPUT_SCRIPT_BASIS=spiel RE15_INPUT_SCRIPT_START=60 "RE15_INPUT_SCRIPT=W1,A0.2,W200"
    RE15_STATE_LOG=state.log RE15_NECK_LOG=neck.log
    "RE15_EXIT_AT=480#11C0"
    "${_exe}")
file(REMOVE "${_exe}")
if(NOT EXISTS "${WORKDIR}/debug.log")
    message(FATAL_ERROR "r36_szene1150: kein debug.log (exit=${_rv}, ${WORKDIR})")
endif()
file(READ "${WORKDIR}/debug.log" _dbg)
foreach(_m "CONTINUE: resumed in room 1130" "Szene startet (Programm 0)" "Montage 1130 (Programm 1)" "Montage 1040 (Programm 2)"
           "Montage 1030 (Programm 3)" "Montage 11C0 (Programm 4)" "EXIT_AT: Bild 480 in Raum 11c0")
    string(FIND "${_dbg}" "${_m}" _p)
    if(_p LESS 0)
        message(FATAL_ERROR "r36_szene1150: fehlt im debug.log: '${_m}' (${WORKDIR})")
    endif()
endforeach()

# --- K1: der Tuerknall = RE2 ROOM1060 ------------------------------------------------------------------------------
string(FIND "${_dbg}" "ROOM1150 Zustand 1: Signal (5,28): Tuerknall (Knall-Bank Satz 0 = RE2 ROOM1060 Se_on 0x0a)" _k1)
if(_k1 LESS 0)
    message(FATAL_ERROR "r36_szene1150[K1]: am Szenenende kein Tuerknall Satz 0 = RE2 ROOM1060")
endif()

# --- K3: Ereignisfolge je Montage-Raum -------------------------------------------------------------------------------
string(REGEX MATCHALL "\\[irons-tod\\] Folge #[0-9]+ [KSC] ROOM[0-9A-F]+ T[0-9]+ [^\r\n]*" _folge "${_dbg}")
list(LENGTH _folge _nf)
if(_nf LESS 10)
    message(FATAL_ERROR "r36_szene1150[K3]: zu wenige Folge-Zeilen (${_nf})")
endif()
# Index der ersten Zeile mit Art/Raum (und optional Zusatztext) in der Folge
function(f_idx _art _raum _zusatz _out)
    set(_i 0)
    foreach(_z IN LISTS _folge)
        if(_z MATCHES " ${_art} ROOM${_raum} " AND (_zusatz STREQUAL "" OR _z MATCHES "${_zusatz}"))
            set(${_out} ${_i} PARENT_SCOPE)
            return()
        endif()
        math(EXPR _i "${_i} + 1")
    endforeach()
    set(${_out} -1 PARENT_SCOPE)
endfunction()
function(f_vor _a _b _was)
    if(_a LESS 0 OR _b LESS 0 OR NOT _a LESS _b)
        message(FATAL_ERROR "r36_szene1150[K3]: ${_was} (Folge-Index ${_a} vor ${_b} verlangt)\n${_folge}")
    endif()
endfunction()
f_idx(K 1150 "Satz 0" _k1150)
f_idx(S 1130 "Raumaufbau" _s1130)
f_idx(C 1130 "Raumaufbau" _c1130)
f_idx(K 1130 "Satz 1" _k1130)
f_idx(S 1040 "Raumaufbau" _s1040)
f_idx(C 1040 "Raumaufbau" _c1040)
f_idx(K 1040 "Satz 0" _k1040)
f_idx(S 1030 "Raumaufbau" _s1030)
f_idx(C 1030 "Raumaufbau" _c1030)
f_idx(K 1030 "Satz 2" _k1030)
f_idx(C 1030 "Kamera Cut 12$" _c1030t)
f_vor(${_k1150} ${_s1130} "1130: Knall (Ende 1150, Satz 0) vor dem Spawn")
f_vor(${_s1130} ${_c1130} "1130: Spawn vor dem ersten Kamerabild")
f_vor(${_c1130} ${_k1130} "1130: der Knall des 1040-Schritts erst nach dem Bild der Zombies")
f_vor(${_k1130} ${_s1040} "1040: Knall (Ende 1130, Satz 1) vor dem Spawn")
f_vor(${_s1040} ${_c1040} "1040: Spawn vor dem ersten Kamerabild")
f_vor(${_k1040} ${_s1030} "1030: Tuerknall (Ende 1040, Satz 0) vor dem Spawn der 1070-Kopien")
f_vor(${_s1030} ${_c1030} "1030: Spawn vor dem ersten Kamerabild (Cut 7)")
f_vor(${_k1030} ${_c1030t} "1030: Original-Knall @0x02776 vor dem Kamerawechsel zum Tor (Cut 12)")
# zwischen Original-Knall und Cut 12: der Spawn der drei Kriecher (im Spieltakt, nicht im Raumaufbau)
math(EXPR _zw "${_k1030} + 1")
list(GET _folge ${_zw} _z_nach_knall)
if(NOT _z_nach_knall MATCHES " S ROOM1030 T[0-9]+ Spawn \\+ 3$")
    message(FATAL_ERROR "r36_szene1150[K3]: nach dem Original-Knall nicht der Spawn der drei Kriecher: '${_z_nach_knall}'")
endif()

# state.log: die ERSTE Zeile jedes Montage-Raumbesuchs (Bildzaehler faellt zurueck) traegt die Zombies schon
file(STRINGS "${WORKDIR}/state.log" _st)
set(_letzt -1)
set(_besuch 0)
set(_erste "")
set(_riegel "")
foreach(_z IN LISTS _st)
    if(_z MATCHES "^F([0-9]+) ")
        set(_f ${CMAKE_MATCH_1})
        if(_f LESS _letzt)
            math(EXPR _besuch "${_besuch} + 1")
            # je Gegner " t=xx st=" (OHNE die eckige Klammer: CMake-Listen trennen in [...] nicht am Semikolon)
            string(REGEX MATCHALL " t=[0-9a-f]+ st=" _g "${_z}")
            list(LENGTH _g _ng)
            string(REGEX MATCH "cam=([0-9]+)" _c "${_z}")
            list(APPEND _erste "Besuch ${_besuch}: F${_f} ${_c} Gegner ${_ng}")
        endif()
        # Bild 10 jedes Besuchs: die Pad-Sperre (Set(2,7) = Bit 0x01000000 im Pause-Wort) steht nach der Blende
        if(_f EQUAL 10 AND _besuch GREATER 0)
            string(REGEX MATCH "pf=([0-9A-F]+)" _pf "${_z}")
            list(APPEND _riegel "Besuch ${_besuch}: ${_pf}")
        endif()
        set(_letzt ${_f})
    endif()
endforeach()
foreach(_b 2 3 4 5)
    set(_ok 0)
    foreach(_r IN LISTS _riegel)
        if(_r MATCHES "^Besuch ${_b}: pf=01")
            set(_ok 1)
        endif()
    endforeach()
    if(NOT _ok)
        message(FATAL_ERROR "r36_szene1150: Montage-Besuch ${_b} hat in Bild 10 keine Pad-Sperre (Set(2,7) im Pause-Wort): ${_riegel}")
    endif()
endforeach()
# Besuche: 1 = ROOM1150, 2 = ROOM1130, 3 = ROOM1040, 4 = ROOM1030, 5 = ROOM11C0
list(GET _erste 1 _e1130)
list(GET _erste 2 _e1040)
list(GET _erste 3 _e1030)
list(GET _erste 4 _e11c0)
if(NOT _e1130 MATCHES "cam=0 Gegner 5$")
    message(FATAL_ERROR "r36_szene1150[K3]: erstes Bild ROOM1130 ohne die fuenf Zombies: '${_e1130}' (alle: ${_erste})")
endif()
if(NOT _e1040 MATCHES "cam=1 Gegner 5$")
    message(FATAL_ERROR "r36_szene1150[K3]: erstes Bild ROOM1040: '${_e1040}'")
endif()
if(NOT _e1030 MATCHES "cam=7 Gegner 11$")
    message(FATAL_ERROR "r36_szene1150[K3]: erstes Bild ROOM1030 ohne die 1070-Kopien: '${_e1030}'")
endif()
if(NOT _e11c0 MATCHES "cam=13 Gegner 4$")
    message(FATAL_ERROR "r36_szene1150[K3/K2]: erstes Bild ROOM11C0 ohne Marvin: '${_e11c0}'")
endif()

# --- K2: 11C0 einander zugewandt -------------------------------------------------------------------------------------
file(READ "${WORKDIR}/neck.log" _neck)
foreach(_m "PLC_NECK slot=1 mode=1 tgt=(-8163,0,-13748)" "PLC_NECK slot=4 mode=1 tgt=(-8965,0,-14347)"
           "PLC_NECK slot=4 mode=3" "PLC_NECK slot=1 mode=1 tgt=(-25100,0,17250)")
    string(FIND "${_neck}" "${_m}" _p)
    if(_p LESS 0)
        message(FATAL_ERROR "r36_szene1150[K2]: fehlt im neck.log: '${_m}'")
    endif()
endforeach()
# Runde 37 Spur O (Nachtrag 11 "Dann drehen sie sich einmal um 180 grad um. Dann dreht sich Ada noch mal um 90 grad um"):
# im Gespraech dreht sich niemand mehr per Plc_dest Modus 9 — beide stehen ab dem Raumaufbau einander zugewandt
# (Dir_set / Spawn-Gier, Riegel integration_r37_szene11c0); bleibt Marvins Lauf zur Tuer (Modus 5).
# Gespraech ohne Koerperdrehung: in 11C0 genau EIN Plc_dest Modus 9 - Adas Drehen dem laufenden Marvin nach (Nachtrag 12,
# Ausgangsziel sein Laufziel, der Port-Takt fuehrt den Drehpunkt mit ihm) - und erst NACH Marvins Lauf (Modus 5)
string(FIND "${_dbg}" "Montage 11C0 (Programm 4)" _p11)
string(SUBSTRING "${_dbg}" ${_p11} -1 _dbg11)
string(REGEX MATCHALL "Plc_dest\\(slot=[0-9]+ mode=0x09[^\r\n]*" _m9 "${_dbg11}")
list(LENGTH _m9 _n9)
string(FIND "${_dbg11}" "Plc_dest(slot=4 mode=0x05 dest=(-25100,17250))" _p5)
string(FIND "${_dbg11}" "Plc_dest(slot=1 mode=0x09 dest=(-25100,17250))" _p9)
if(_p5 LESS 0)
    message(FATAL_ERROR "r36_szene1150[K2/r37 O]: Marvins Lauf zur Tuer (Plc_dest Modus 5) fehlt im debug.log")
endif()
if(NOT _n9 EQUAL 1 OR _p9 LESS _p5)
    message(FATAL_ERROR "r36_szene1150[K2/r37 O]: in ROOM11C0 muss genau ein Plc_dest Modus 9 stehen (Ada, nach Marvins Lauf): ${_m9}")
endif()
message(STATUS "r36_szene1150: OK - K1 RE2-Knall, K3 Folge + erste Bilder (${_erste}), K2 Blicke/Drehungen")
